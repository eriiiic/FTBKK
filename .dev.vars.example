# Copy to .dev.vars for local development. Never commit .dev.vars.
# Cloudflare's always-pass Turnstile test secret:
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Leave empty locally: emails are logged to the console instead of sent.
RESEND_API_KEY=
# Local only: overrides the production Access audience in wrangler.jsonc so that
# requireAdmin() accepts DEV_ADMIN_EMAIL instead of a Cloudflare Access login.
ACCESS_AUD=
DEV_ADMIN_EMAIL=admin@example.com
# Set to 1 only if challenges.cloudflare.com is unreachable from your machine.
# DEV_SKIP_TURNSTILE=1
# Links in emails point here during local development.
SITE_URL=http://localhost:4321
# Social media page tokens (Admin > Social media). Leave empty locally: due posts are emailed.
LINKEDIN_ACCESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
