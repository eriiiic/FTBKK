{
  "name": "ft-bkk-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "types": "wrangler types --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ftbkk --local",
    "db:migrate:remote": "wrangler d1 migrations apply ftbkk --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "sanitize-html": "^2.18.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20"
  }
}
