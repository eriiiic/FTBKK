---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const adminEmail = Astro.locals.adminEmail;
// Only after a redirect: a re-rendered POST (a form with errors) keeps the URL's ?saved=1.
const flash = Astro.request.method === 'GET' ? Astro.url.searchParams.get('saved') : null;
const flashText =
  flash === 'deleted'
    ? 'Deleted.'
    : flash === 'done'
      ? 'Done.'
      : flash === 'email'
        ? 'Saved. The next emails sent use this text.'
        : flash === 'merged'
          ? 'Merged into one contact.'
          : 'Saved. Public pages refresh within a minute.';
// The sidebar, in groups.
interface NavLink {
  href: string;
  label: string;
}
// Content and day-to-day work first, figures next, site-wide switches last.
const groups: { label: string; links: NavLink[] }[] = [
  { label: '', links: [{ href: '/admin', label: 'Dashboard' }] },
  {
    label: 'Events',
    links: [
      { href: '/admin/events', label: 'All events' },
      { href: '/admin/registrations', label: 'Registrations' },
      { href: '/admin/checkin', label: 'Check-in' },
    ],
  },
  {
    label: 'Community',
    links: [
      { href: '/admin/members', label: 'Members' },
      { href: '/admin/contacts', label: 'Contacts' },
      { href: '/admin/submissions', label: 'Messages' },
      { href: '/admin/people', label: 'Board and speakers' },
    ],
  },
  {
    label: 'Ecosystem',
    links: [
      { href: '/admin/ecosystem', label: 'To review' },
      { href: '/admin/ecosystem?tab=all', label: 'All listings' },
      { href: '/admin/ecosystem?tab=partners', label: 'Partners' },
      { href: '/admin/ecosystem?tab=renewals', label: 'Renewals' },
    ],
  },
  {
    label: 'Blog',
    links: [
      { href: '/admin/posts', label: 'Posts' },
      { href: '/admin/files', label: 'PDFs and files' },
    ],
  },
  {
    label: 'Website pages',
    links: [
      { href: '/admin/site-texts', label: 'Home' },
      { href: '/admin/site-texts?page=about', label: 'About' },
      { href: '/admin/site-texts?page=join', label: 'Join' },
      { href: '/admin/site-texts?page=tech-pulse', label: 'Tech Pulse' },
      { href: '/admin/site-texts?page=thai', label: 'Thai page' },
      { href: '/admin/site-texts?page=legal', label: 'Code of conduct and privacy' },
    ],
  },
  {
    label: 'Emails and social media',
    links: [
      { href: '/admin/community-email', label: 'Email the community' },
      { href: '/admin/social', label: 'Social media posts' },
      { href: '/admin/emails', label: 'Automatic emails' },
    ],
  },
  {
    label: 'Reports',
    links: [
      { href: '/admin/reports/events', label: 'Events and attendance' },
      { href: '/admin/reports/members', label: 'Membership' },
    ],
  },
  {
    label: 'Settings',
    links: [
      { href: '/admin/settings', label: 'General' },
      { href: '/admin/settings?section=membership', label: 'Membership' },
      { href: '/admin/settings?section=event-covers', label: 'Default event covers' },
      { href: '/admin/settings?section=social-links', label: 'Social links' },
      { href: '/admin/history', label: 'Change history' },
    ],
  },
];
const path = Astro.url.pathname;
// The longest matching link wins, so /admin/events/12 lights up All events only. Links
// to the same screen differ by one query parameter, which must match too (missing = its default).
const SUBPAGES: Record<string, { param: string; fallback: string }> = {
  '/admin/ecosystem': { param: 'tab', fallback: 'queue' },
  '/admin/site-texts': { param: 'page', fallback: 'home' },
  '/admin/settings': { param: 'section', fallback: 'general' },
};
const links = groups.flatMap((g) => g.links);
const matches = (href: string) => {
  const [p, q] = href.split('?');
  if (p === '/admin') return path === '/admin';
  if (!(path === p || path.startsWith(`${p}/`))) return false;
  const sub = SUBPAGES[p!];
  if (!sub || path !== p) return true;
  const want = new URLSearchParams(q).get(sub.param) ?? sub.fallback;
  return (Astro.url.searchParams.get(sub.param) ?? sub.fallback) === want;
};
const current = links
  .map((n) => n.href)
  .filter(matches)
  .sort((a, b) => b.split('?')[0]!.length - a.split('?')[0]!.length)[0];
const active = (href: string) => href === current;
const currentGroup = groups.find((g) => g.links.some((l) => active(l.href)));
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Admin · La French Tech Bangkok</title>
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-screen bg-surface md:flex">
    <aside class="bg-navy text-paper md:sticky md:top-0 md:h-screen md:w-60 md:shrink-0 md:overflow-y-auto">
      <div class="flex items-center justify-between gap-3 p-4 md:block">
        <a href="/admin" class="no-underline">
          <Logo tone="light" class="h-12" />
        </a>
        <div class="flex items-center gap-3 md:block">
          <a href="/" class="text-xs text-accent-soft md:mt-3 md:block">
            View site ↗
          </a>
          <button
            type="button"
            class="rounded-lg px-3 py-2 text-sm font-semibold text-paper hover:bg-paper/10 md:hidden"
            aria-controls="admin-menu"
            aria-expanded="false"
            data-admin-menu
          >
            Menu{currentGroup?.label ? ` · ${currentGroup.label}` : ''}
          </button>
        </div>
      </div>
      <nav id="admin-menu" aria-label="Admin" class="hidden px-2 pb-4 md:block md:px-3">
        {groups.map((g) => {
          const list = (
            <ul class="grid gap-0.5">
              {g.links.map((n) => (
                <li>
                  <a
                    href={n.href}
                    aria-current={active(n.href) ? 'page' : undefined}
                    class="block rounded-lg px-3 py-1.5 text-sm text-paper no-underline hover:bg-paper/10 aria-[current=page]:bg-paper/15 aria-[current=page]:font-semibold"
                  >
                    {n.label}
                  </a>
                </li>
              ))}
            </ul>
          );
          // Labelled groups fold; the one holding the current page starts open.
          return g.label ? (
            <details class="group mb-1" data-menu-group={g.label} open={g === currentGroup}>
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold tracking-wider text-accent-soft uppercase hover:bg-paper/10 [&::-webkit-details-marker]:hidden">
                {g.label}
                <span aria-hidden="true" class="text-sm transition-transform group-open:rotate-90">
                  ›
                </span>
              </summary>
              <div class="pb-2">{list}</div>
            </details>
          ) : (
            <div class="mb-1">{list}</div>
          );
        })}
        {adminEmail && <p class="px-3 pt-3 text-xs text-accent-soft">{adminEmail}</p>}
      </nav>
    </aside>
    <main class="min-w-0 flex-1 p-4 md:p-8">
      <h1 class="mb-6 text-2xl">{title}</h1>
      {flash && (
        <div
          role="status"
          data-toast
          class="mb-6 rounded-xl border border-success/30 bg-success/5 p-4 text-success"
        >
          {flashText}
        </div>
      )}
      <slot />
    </main>
    <script>
      // Small screens: the menu opens from the "Menu" button.
      const menuButton = document.querySelector<HTMLButtonElement>('[data-admin-menu]');
      const menu = document.getElementById('admin-menu');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        menu?.classList.toggle('hidden', !open);
      });
      // Menu groups remember being opened or closed (per browser); the current one always opens.
      document.querySelectorAll<HTMLDetailsElement>('details[data-menu-group]').forEach((d) => {
        const key = `admin-menu:${d.dataset.menuGroup}`;
        try {
          if (!d.open && localStorage.getItem(key) === 'open') d.open = true;
        } catch {
          // Storage blocked: groups just start closed.
        }
        // Only clicks count: the browser also fires "toggle" for the group opened on load.
        d.querySelector('summary')?.addEventListener('click', () => {
          try {
            localStorage.setItem(key, d.open ? 'closed' : 'open');
          } catch {
            // Ignore.
          }
        });
      });
      document.querySelectorAll<HTMLElement>('[data-toast]').forEach((t) => {
        setTimeout(() => t.remove(), 6000);
      });
      // Confirm destructive actions: <form data-confirm="Delete this post?">, or data-confirm on
      // the one submit button of a form that needs it.
      document.querySelectorAll<HTMLFormElement>('form').forEach((f) => {
        f.addEventListener('submit', (e) => {
          const msg = (e.submitter as HTMLElement | null)?.dataset.confirm ?? f.dataset.confirm;
          if (msg && !confirm(msg)) e.preventDefault();
        });
      });
      // Editors warn before leaving with unsaved changes: <form data-warn-unsaved>. Tracked per
      // form, since a page can have several that save separately: submitting one asks first when
      // another has changes that would be lost.
      const dirty = new Set<HTMLFormElement>();
      document.querySelectorAll<HTMLFormElement>('form[data-warn-unsaved]').forEach((f) => {
        // <form data-unsaved>: re-rendered with text that isn't saved yet (e.g. after a preview).
        if (f.hasAttribute('data-unsaved')) dirty.add(f);
        f.addEventListener('input', () => dirty.add(f));
        f.addEventListener('submit', (e) => {
          if (e.defaultPrevented) return;
          const others = [...dirty].filter((o) => o !== f);
          const msg =
            'Another section of this page has changes that are not saved yet. They will be lost if you save this section now. Continue?';
          if (others.length && !confirm(msg)) {
            e.preventDefault();
            return;
          }
          dirty.clear();
        });
      });
      addEventListener('beforeunload', (e) => {
        if (dirty.size) e.preventDefault();
      });
      // Copy buttons: <button data-copy="text">, including ones added to the page later.
      document.addEventListener('click', async (e) => {
        const b = (e.target as Element | null)?.closest<HTMLButtonElement>('button[data-copy]');
        if (!b) return;
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        const label = b.textContent;
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = label), 1500);
      });
      // Sortable tables: <table data-sortable>. Click a header to sort by that column, click again
      // to reverse. A cell's data-sort value (a timestamp, a number) wins over its text.
      document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
        const tbody = table.tBodies[0];
        const headers = [...table.querySelectorAll<HTMLTableCellElement>('thead th')];
        const value = (row: HTMLTableRowElement, i: number) => {
          const cell = row.cells[i];
          return (cell?.dataset.sort ?? cell?.textContent ?? '').trim();
        };
        headers.forEach((th, i) => {
          if (th.hasAttribute('data-nosort')) return;
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'sort-button';
          while (th.firstChild) button.appendChild(th.firstChild);
          th.appendChild(button);
          button.addEventListener('click', () => {
            const dir = th.getAttribute('aria-sort') === 'ascending' ? -1 : 1;
            headers.forEach((h) => h.removeAttribute('aria-sort'));
            th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
            const rows = [...tbody.rows];
            rows.sort((a, b) => {
              const x = value(a, i);
              const y = value(b, i);
              const nx = Number(x);
              const ny = Number(y);
              const cmp =
                x !== '' && y !== '' && !Number.isNaN(nx) && !Number.isNaN(ny)
                  ? nx - ny
                  : x.localeCompare(y, undefined, { numeric: true, sensitivity: 'base' });
              return cmp * dir;
            });
            rows.forEach((r) => tbody.appendChild(r));
          });
        });
      });
    </script>
  </body>
</html>
