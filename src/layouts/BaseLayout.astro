---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/settings';
import { DEFAULT_DESCRIPTION, siteUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Public pages are edge-cached for 60s; pass false for personal pages (manage, cancel). */
  cache?: boolean;
  /** Language of the page content, for the html lang attribute (the /th page is in Thai). */
  lang?: string;
  /** Open Graph type: blog posts are articles, the rest are web pages. */
  ogType?: 'website' | 'article';
  /** Article dates for social previews (blog posts). */
  published?: Date | null;
  modified?: Date | null;
}
const settings = await getSettings();
const {
  title,
  description = settings.siteDescription || DEFAULT_DESCRIPTION,
  image,
  canonical = siteUrl(Astro.url.pathname),
  noindex = false,
  jsonLd,
  cache = true,
  lang = 'en',
  ogType = 'website',
  published,
  modified,
} = Astro.props;
// The home page title says what the site is about, as search results show it first.
const fullTitle = title
  ? `${title} | ${settings.siteTitle}`
  : `${settings.siteTitle} | French tech community in Bangkok, Thailand`;
// Pages without their own image share the French Tech Connect visual the Wix site used.
const ogImage = siteUrl(image || '/brand/og-default.jpg');
const ogLocale = lang === 'th' ? 'th_TH' : 'en_US';
Astro.response.headers.set(
  'Cache-Control',
  cache ? 'public, s-maxage=60, stale-while-revalidate=300' : 'private, no-store',
);
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'La French Tech Bangkok',
  alternateName: 'French Tech Bangkok',
  url: siteUrl('/'),
  logo: siteUrl('/brand/icon-512.png'),
  email: settings.contactEmail,
  sameAs: Object.values(settings.socials).filter(Boolean),
};
// The site name Google shows above results; only the home page needs to say it.
const websiteLd =
  Astro.url.pathname === '/'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: 'La French Tech Bangkok',
          alternateName: 'French Tech Bangkok',
          url: siteUrl('/'),
        },
      ]
    : [];
const ld = [orgLd, ...websiteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="La French Tech Bangkok blog"
      href="/rss.xml"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="La French Tech Bangkok" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {settings.analyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: settings.analyticsToken })}
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
