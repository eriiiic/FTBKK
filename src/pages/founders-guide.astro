---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Checklist from '../components/guide/Checklist.astro';
import Faq from '../components/guide/Faq.astro';
import GuideHero from '../components/guide/GuideHero.astro';
import HelpLists from '../components/guide/HelpLists.astro';
import SectionHead from '../components/guide/SectionHead.astro';
import SourceLinks from '../components/guide/SourceLinks.astro';
import TaxCards from '../components/guide/TaxCards.astro';
import TipCards from '../components/guide/TipCards.astro';
import VisaCards from '../components/guide/VisaCards.astro';
import { BUDGET, CHECKLIST, EXTRA_SOURCES, FAQ, PATHS, STRUCTURES } from '../lib/founders-guide';
import {
  GUIDE_CHECKED_LABEL,
  SOURCES,
  TAXES,
  VISA,
  sourceList,
  type SourceKey,
} from '../lib/thailand-guides';

// The Founder's Guide: practical notes for founders starting or growing a startup in Thailand,
// with a path picker, a first-year budget estimator and a checklist that remembers ticks in the
// browser. Companies that are already established elsewhere have their own guide,
// /expand-to-thailand. Listed in the header's Resources menu, the footer and the sitemap.
const visas = [VISA.dtv, VISA.smartS, VISA.ltrWft, VISA.nonB];
const toc = [
  { href: '#path', label: 'Where are you?' },
  { href: '#visas', label: 'Visas compared' },
  { href: '#structure', label: 'Company structures' },
  { href: '#budget', label: 'First-year budget' },
  { href: '#tax', label: 'Taxes at a glance' },
  { href: '#checklist', label: 'Setup checklist' },
  { href: '#people', label: 'Hiring, money and culture' },
  { href: '#help', label: 'Who can help' },
  { href: '#faq', label: 'Questions' },
];
const sourceLinks = (keys: SourceKey[]) => keys.map((k) => SOURCES[k]);
const allSources = sourceList(
  [
    ...visas.map((v) => v.sources),
    ...STRUCTURES.map((s) => s.sources),
    ...TAXES.map((t) => t.sources),
  ],
  EXTRA_SOURCES,
);
const thb = (n: number) => `THB ${n.toLocaleString('en-US')}`;
---

<BaseLayout
  title="Founder's Guide to Thailand"
  description="La French Tech Bangkok's practical guide for founders setting up in Thailand: visas, company structures, BOI, taxes, first-year budget and a setup checklist."
>
  <GuideHero
    eyebrow="Founder's Guide"
    title="Building your startup in Thailand"
    intro="What founders in our community wish they had known before they started: which visa, which company, what it costs in year one and what to file when. Pick your situation below and follow the steps."
    checked={GUIDE_CHECKED_LABEL}
    toc={toc}
    other={{
      href: '/expand-to-thailand',
      question: 'Already running an established company abroad?',
      label: 'Read Expanding to Thailand',
    }}
  />

  <!-- 01 Path picker: each button shows its panel; without JavaScript every panel is visible. -->
  <section id="path" class="scroll-mt-20 py-14 md:py-20" data-paths>
    <div class="container-page">
      <SectionHead
        eyebrow="01 · Where are you?"
        title="Start from your situation"
        intro="Choose the closest one to see the visa, the structure and your next five steps."
      />
      <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Your situation">
        {PATHS.map((p, i) => (
          <button
            type="button"
            class="chip cursor-pointer aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-paper"
            data-path={p.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {p.label}
          </button>
        ))}
      </div>
      {PATHS.map((p) => (
        <article
          class="mb-6 grid gap-6 rounded-card border border-line bg-paper p-6 shadow-card md:p-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
          data-path-panel={p.id}
          aria-live="polite"
        >
          <div>
            <h3 class="text-2xl">{p.label}</h3>
            <p class="mt-2 text-muted">{p.who}</p>
            <dl class="mt-6 grid gap-4">
              <div>
                <dt class="text-xs font-semibold tracking-[0.15em] text-brand-dark uppercase">
                  Visa
                </dt>
                <dd class="mt-1">{p.visa}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold tracking-[0.15em] text-brand-dark uppercase">
                  Structure
                </dt>
                <dd class="mt-1">{p.structure}</dd>
              </div>
            </dl>
            <p class="mt-6 flex flex-wrap gap-2">
              {p.sections.map((s) => (
                <a href={s.href} class="chip">
                  {s.label} <Icon name="arrow" class="size-3.5" />
                </a>
              ))}
            </p>
          </div>
          <ol class="grid gap-3">
            {p.steps.map((step, i) => (
              <li class="flex gap-4 rounded-xl bg-surface p-4">
                <span class="font-display text-sm font-bold text-brand tabular-nums">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <!-- 02 Visas -->
  <section id="visas" class="scroll-mt-20 bg-surface py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="02 · Visas"
        title="Four visas founders actually use"
        intro="The key question is whether you will earn money from Thailand. If you will, you need a visa that allows work in Thailand."
      />
      <VisaCards visas={visas} />
    </div>
  </section>

  <!-- 03 Company structures -->
  <section id="structure" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="03 · Company structures"
        title="Who can own what"
        intro="The Foreign Business Act limits foreign ownership in most service businesses to 49%. BOI promotion is how most tech startups get to 100%."
      />
      <div class="grid gap-5 lg:grid-cols-2">
        {STRUCTURES.map((s) => (
          <article class="flex flex-col rounded-card border border-line bg-paper p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-xl">{s.name}</h3>
              <span class="rounded-full bg-navy px-3 py-1 text-xs font-semibold text-paper">
                {s.ownership}
              </span>
            </div>
            <p class="mt-3">{s.goodFor}</p>
            <p class="mt-3 flex gap-3 rounded-xl bg-surface p-3 text-sm">
              <span class="shrink-0 font-semibold whitespace-nowrap text-warning">Watch out</span>
              <span>{s.watch}</span>
            </p>
            <SourceLinks sources={sourceLinks(s.sources)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 Budget estimator -->
  <section id="budget" class="scroll-mt-20 bg-navy py-14 text-paper md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="04 · First-year budget"
        title="What will year one cost?"
        light
        intro="A rough order of magnitude for a Bangkok company, to prepare your conversation with an accountant."
      />
      <div
        class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
        data-budget={JSON.stringify(BUDGET)}
      >
        <form class="grid gap-5 rounded-card bg-paper/5 p-6" data-budget-form>
          <fieldset>
            <legend class="mb-2 font-semibold">Company type</legend>
            <label class="mb-2 flex items-center gap-3">
              <input type="radio" name="route" value="boi" checked class="accent-brand" />
              BOI-promoted (100% foreign)
            </label>
            <label class="flex items-center gap-3">
              <input type="radio" name="route" value="standard" class="accent-brand" />
              Standard Thai company
            </label>
          </fieldset>
          <label class="grid gap-1">
            <span class="font-semibold">Foreigners needing a work permit</span>
            <input
              type="number"
              name="permits"
              min="0"
              max="20"
              value="1"
              class="rounded-lg border border-paper/30 bg-paper px-3 py-2 text-ink"
            />
          </label>
          <label class="grid gap-1">
            <span class="font-semibold">Thai employees you plan to hire</span>
            <input
              type="number"
              name="staff"
              min="0"
              max="200"
              value="2"
              class="rounded-lg border border-paper/30 bg-paper px-3 py-2 text-ink"
            />
          </label>
          <label class="grid gap-1">
            <span class="font-semibold">Average Thai monthly salary (THB)</span>
            <input
              type="number"
              name="salary"
              min="0"
              step="1000"
              value={BUDGET.defaultSalary}
              class="rounded-lg border border-paper/30 bg-paper px-3 py-2 text-ink"
            />
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name="office" checked class="accent-brand" />
            Basic office or coworking desk
          </label>
        </form>
        <div class="rounded-card bg-paper p-6 text-ink md:p-8" aria-live="polite">
          <dl class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-surface p-4">
              <dt class="text-sm text-muted">Capital to put in the company</dt>
              <dd class="mt-1 font-display text-2xl font-bold text-navy" data-out="capital">
                {thb(BUDGET.boiMinCapital)}
              </dd>
            </div>
            <div class="rounded-xl bg-surface p-4">
              <dt class="text-sm text-muted">Running costs, year one</dt>
              <dd class="mt-1 font-display text-2xl font-bold text-navy" data-out="total">
                -
              </dd>
            </div>
          </dl>
          <table class="mt-6 w-full text-left text-sm">
            <caption class="sr-only">Year one cost breakdown</caption>
            <tbody class="divide-y divide-line">
              <tr>
                <th scope="row" class="py-2 font-normal">
                  Registration and legal fees (once)
                </th>
                <td class="py-2 text-right tabular-nums" data-out="registration">
                  -
                </td>
              </tr>
              <tr>
                <th scope="row" class="py-2 font-normal">
                  Accounting, audit and filings
                </th>
                <td class="py-2 text-right tabular-nums" data-out="accounting">
                  -
                </td>
              </tr>
              <tr>
                <th scope="row" class="py-2 font-normal">
                  Office
                </th>
                <td class="py-2 text-right tabular-nums" data-out="office">
                  -
                </td>
              </tr>
              <tr>
                <th scope="row" class="py-2 font-normal">
                  Thai payroll and social security (<span data-out="headcount">2</span> people)
                </th>
                <td class="py-2 text-right tabular-nums" data-out="payroll">
                  -
                </td>
              </tr>
            </tbody>
          </table>
          <p
            class="mt-4 hidden rounded-xl bg-surface p-3 text-sm text-warning"
            data-out="warning"
          ></p>
          <p class="mt-4 text-xs text-muted">
            Capital is money the company keeps and spends, not a fee. Excludes foreign salaries,
            visas, insurance and BOI application costs. Fee ranges from{' '}
            <a href={SOURCES.starterKit.url} class="underline" rel="noopener" target="_blank">
              {SOURCES.starterKit.label}
            </a>
            ; social security from{' '}
            <a href={SOURCES.sso.url} class="underline" rel="noopener" target="_blank">
              {SOURCES.sso.label}
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Taxes -->
  <section id="tax" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page">
      <SectionHead
        eyebrow="05 · Taxes"
        title="Taxes at a glance"
        intro="The numbers to know before your first meeting with an accountant."
      />
      <TaxCards taxes={TAXES} />
    </div>
  </section>

  <!-- 06 Checklist -->
  <section id="checklist" class="scroll-mt-20 bg-surface py-14 md:py-20">
    <div class="container-page">
      <Checklist
        eyebrow="06 · Checklist"
        title="Your setup checklist"
        phases={CHECKLIST}
        storageKey="ftbkk-founders-guide-checklist"
      />
    </div>
  </section>

  <!-- 07 Hiring, money, culture -->
  <section id="people" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">07 · Hiring</p>
        <h2 class="text-3xl leading-tight md:text-4xl">Building a team</h2>
        <ul class="mt-6 grid gap-4">
          <li class="flex gap-3">
            <Icon name="users" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              Contracts in Thai and English. The Labour Protection Act sets notice, overtime and
              severance (up to 400 days of pay after 20 years of service).
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="users" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              Register employees with the Social Security Office: 5% from you and 5% from them, on
              salary capped at THB 17,500 a month in 2026.
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="users" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              Outside BOI, each foreign work permit needs 4 Thai employees and THB 2 million of
              capital.
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="users" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              For young French talent, the{' '}
              <a href={SOURCES.vie.url} rel="noopener" target="_blank">
                V.I.E programme
              </a>{' '}
              lets a French company post someone to Thailand for 6 to 24 months, managed by Business
              France.
            </span>
          </li>
        </ul>
      </div>
      <div id="money" class="scroll-mt-20">
        <p class="eyebrow">Banking and funding</p>
        <h2 class="text-3xl leading-tight md:text-4xl">Money</h2>
        <ul class="mt-6 grid gap-4">
          <li class="flex gap-3">
            <Icon name="chart" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              Banks usually want the director's long-term visa and work permit before opening a
              corporate account. Bring the company affidavit, shareholder list and passport.
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="chart" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              Thai startup money comes largely from corporate venture arms of banks, telcos and
              energy groups. Grants exist through{' '}
              <a href={SOURCES.nia.url} rel="noopener" target="_blank">
                NIA
              </a>{' '}
              and{' '}
              <a href={SOURCES.depa.url} rel="noopener" target="_blank">
                depa
              </a>
              .
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="chart" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              A draft{' '}
              <a href={SOURCES.startupAct.url} rel="noopener" target="_blank">
                Startup Promotion Act
              </a>{' '}
              would let certified startups use convertible notes and offer shares more easily. It
              was still before Parliament at our last check.
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="chart" class="mt-0.5 size-5 shrink-0 text-brand" />
            <span>
              From France, Bpifrance's export insurance can cover part of your prospecting costs.
            </span>
          </li>
        </ul>
      </div>
    </div>
    <div class="container-page mt-14">
      <h2 class="text-2xl leading-tight md:text-3xl">Doing business the Thai way</h2>
      <TipCards />
    </div>
  </section>

  <!-- 08 Who can help -->
  <section id="help" class="scroll-mt-20 bg-surface py-14 md:py-20">
    <div class="container-page">
      <SectionHead eyebrow="08 · Who can help" title="Your support network">
        <p class="mt-3 text-lg text-muted">
          Lawyers, accountants and service providers are listed in our{' '}
          <a href="/ecosystem" class="text-accent">
            {' '}
            Ecosystem directory{' '}
          </a>{' '}
          .
        </p>
      </SectionHead>
      <HelpLists />
    </div>
  </section>

  <!-- 09 FAQ -->
  <section id="faq" class="scroll-mt-20 py-14 md:py-20">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">09 · Questions</p>
      <h2 class="text-3xl leading-tight md:text-4xl">Questions founders ask us</h2>
      <Faq items={FAQ} sources={allSources} checked={GUIDE_CHECKED_LABEL} />
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-brand py-16 text-paper md:py-20">
    <div class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="max-w-2xl">
        <h2 class="text-3xl leading-snug text-paper md:text-4xl">Talk to founders who did it</h2>
        <p class="mt-3 text-lg text-paper/90">
          Join La French Tech Bangkok for free and meet them at our next event.
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <Button href="/join" variant="light">
          Join the community
        </Button>
        <Button href="/events" variant="light">
          See events <Icon name="arrow" class="size-4" />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Path picker: show only the chosen situation once JavaScript runs.
  for (const root of document.querySelectorAll<HTMLElement>('[data-paths]')) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-path]');
    const panels = root.querySelectorAll<HTMLElement>('[data-path-panel]');
    const show = (id: string) => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.path === id));
      for (const p of panels) p.hidden = p.dataset.pathPanel !== id;
    };
    for (const b of buttons) b.addEventListener('click', () => show(b.dataset.path ?? ''));
    if (buttons[0]) show(buttons[0].dataset.path ?? '');
  }

  // First-year budget estimator.
  const thb = (n: number) => `THB ${Math.round(n).toLocaleString('en-US')}`;
  const range = ([lo, hi]: readonly number[]) => (lo === hi ? thb(lo) : `${thb(lo)} to ${thb(hi)}`);
  for (const root of document.querySelectorAll<HTMLElement>('[data-budget]')) {
    const b = JSON.parse(root.dataset.budget ?? '{}');
    const form = root.querySelector<HTMLFormElement>('[data-budget-form]');
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`);
    const update = () => {
      if (!form) return;
      const data = new FormData(form);
      const num = (k: string) => Math.max(0, Number(data.get(k)) || 0);
      const boi = data.get('route') === 'boi';
      const permits = num('permits');
      const salary = num('salary');
      const required = boi ? 0 : permits * b.thaiStaffPerPermit;
      const staff = Math.max(num('staff'), required);
      const capital = boi
        ? b.boiMinCapital
        : Math.max(b.standardMinCapital, permits * b.capitalPerPermit);
      const sso = Math.min(salary * 0.05, b.ssoCap);
      const payroll = staff * (salary + sso) * 12;
      const office = data.get('office') ? b.office : [0, 0];
      const low = b.registration[0] + b.accounting[0] + office[0] + payroll;
      const high = b.registration[1] + b.accounting[1] + office[1] + payroll;
      const set = (k: string, v: string) => {
        const el = out(k);
        if (el) el.textContent = v;
      };
      set('capital', thb(capital));
      set('total', range([low, high]));
      set('registration', range(b.registration));
      set('accounting', range(b.accounting));
      set('office', range(office));
      set('payroll', thb(payroll));
      set('headcount', String(staff));
      const warning = out('warning');
      if (warning) {
        const short = required > num('staff');
        warning.hidden = !short;
        warning.classList.toggle('hidden', !short);
        warning.textContent = short
          ? `A standard company needs ${b.thaiStaffPerPermit} Thai employees per work permit, so the estimate counts ${required}.`
          : '';
      }
    };
    form?.addEventListener('input', update);
    form?.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>
