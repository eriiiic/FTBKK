---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import EventCard from '../components/EventCard.astro';
import PostCard from '../components/PostCard.astro';
import OrgCard from '../components/OrgCard.astro';
import JoinUs from '../components/JoinUs.astro';
import PillarIcon from '../components/PillarIcon.astro';
import Icon from '../components/Icon.astro';
import { getSettings } from '../lib/settings';
import {
  featuredOrganisations,
  latestPosts,
  organisationCounts,
  postCategoryNames,
  upcomingEvents,
} from '../lib/queries';
import { CATEGORIES, CATEGORY_KEYS } from '../lib/directory';

const settings = await getSettings();
const [nextEvents, posts, featured, counts, postCats] = await Promise.all([
  upcomingEvents(2),
  latestPosts(3),
  featuredOrganisations(6),
  organisationCounts(),
  postCategoryNames(),
]);
const totalOrgs = Object.values(counts).reduce((a, b) => a + b, 0);
const stats = CATEGORY_KEYS.filter((k) => counts[k]).map((k) => ({
  key: k,
  label: CATEGORIES[k].label,
  n: counts[k]!,
}));
---

<BaseLayout>
  <section class="relative overflow-hidden bg-navy text-paper">
    <img
      src="/brand/hero-bangkok.jpg"
      srcset="/brand/hero-bangkok-960.jpg 960w, /brand/hero-bangkok.jpg 1920w"
      sizes="100vw"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-navy via-navy/85 to-navy/55"
      aria-hidden="true"
    ></div>
    <div class="container-page relative py-20 md:py-28">
      <p class="mb-4 text-sm font-semibold tracking-widest text-accent-soft uppercase">
        {settings.heroTitle}
      </p>
      <h1 class="max-w-3xl text-4xl text-paper md:text-6xl">{settings.heroTagline}</h1>
      {settings.mission && (
        <p class="mt-6 max-w-2xl text-lg whitespace-pre-line text-accent-soft">
          {settings.mission}
        </p>
      )}
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/events">See upcoming events</Button>
        {settings.socials.whatsapp && (
          <Button href={settings.socials.whatsapp} variant="light" rel="noopener">
            <Icon name="whatsapp" /> Join our WhatsApp
          </Button>
        )}
      </div>
      {settings.values.length > 0 && (
        <ul class="mt-12 flex flex-col gap-3 border-t border-paper/15 pt-8 sm:flex-row sm:flex-wrap sm:gap-x-10">
          {settings.values.map((v) => (
            <li class="flex items-center gap-2 text-sm font-medium text-paper">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-brand">
                <Icon name="check" class="size-3.5" />
              </span>
              {v}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <Section eyebrow="Events" title="Coming up next">
    {nextEvents.length ? (
      <div class="grid gap-6 md:grid-cols-2">
        {nextEvents.map((e) => (
          <EventCard event={e} />
        ))}
      </div>
    ) : (
      <p class="text-muted">
        No event scheduled yet. Join the WhatsApp group to hear about the next one.
      </p>
    )}
    <p class="mt-8">
      <a href="/events" class="font-semibold text-accent">
        All events →
      </a>
    </p>
  </Section>

  {settings.pillars.length > 0 && (
    <section class="bg-navy py-16 text-paper md:py-24">
      <div class="container-page">
        {settings.ecosystemHeading && (
          <h2 class="mx-auto max-w-4xl text-center text-3xl leading-tight text-balance text-paper uppercase md:text-5xl">
            {settings.ecosystemHeading}
          </h2>
        )}
        <ul class="mt-12 grid gap-12 md:mt-16 md:grid-cols-3 md:gap-8">
          {settings.pillars.map((p, i) => (
            <li class="flex flex-col items-center text-center">
              <PillarIcon index={i} class="size-14 text-paper" />
              <h3 class="mt-6 text-xl text-paper">{p.title}</h3>
              <p class="mt-3 max-w-xs text-paper/90">{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <JoinUs paths={settings.joinPaths} />

  <Section
    eyebrow="Ecosystem"
    title="The French Tech ecosystem in Thailand"
    intro={`${totalOrgs} organisations listed in our open directory.`}
  >
    {stats.length > 0 && (
      <ul class="mb-10 grid grid-cols-2 gap-4 md:grid-cols-4">
        {stats.map((s) => (
          <li>
            <a
              href={`/ecosystem?category=${s.key}`}
              class="block h-full rounded-card border border-line p-4 no-underline hover:border-navy"
            >
              <span class="block font-display text-3xl font-bold text-brand">{s.n}</span>
              <span class="text-sm text-muted">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((o) => (
        <OrgCard org={o} />
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/ecosystem" variant="secondary">
        Explore the directory
      </Button>
      <Button href="/ecosystem/submit" variant="ghost">
        Get your organisation listed
      </Button>
    </div>
  </Section>

  {posts.length > 0 && (
    <Section tone="surface" eyebrow="Blog" title="Latest from the community">
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((p) => (
          <PostCard post={p} categories={postCats.get(p.id)} />
        ))}
      </div>
      <p class="mt-8">
        <a href="/blog" class="font-semibold text-accent">
          All articles →
        </a>
      </p>
    </Section>
  )}
</BaseLayout>
