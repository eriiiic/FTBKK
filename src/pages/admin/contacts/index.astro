---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import Alert from '../../../components/Alert.astro';
import { z } from 'zod';
import {
  CONTACT_FILTER_HINTS,
  CONTACT_FILTERS,
  CONTACT_TAGS,
  deleteContacts,
  filterContacts,
  isContactTag,
  loadContacts,
  tagContacts,
  type ContactTag,
} from '../../../lib/contacts';
import { formatDate } from '../../../lib/format';

const url = Astro.url;
if (Astro.request.method === 'POST') {
  // Bulk actions on the selected rows (export goes to contacts.csv instead).
  const form = await Astro.request.formData();
  const keys = z.array(z.string().min(1).max(320)).min(1).max(2000);
  const parsed = z
    .discriminatedUnion('action', [
      z.object({ action: z.literal('delete'), keys }),
      z.object({
        action: z.enum(['tag-add', 'tag-remove']),
        keys,
        tag: z.enum(Object.keys(CONTACT_TAGS) as [ContactTag, ...ContactTag[]]),
      }),
    ])
    .safeParse({ action: form.get('action'), keys: form.getAll('c'), tag: form.get('tag') });
  const back = new URLSearchParams(url.search);
  for (const k of ['saved', 'tagged', 'n', 'skipped', 'which']) back.delete(k);
  const actor = Astro.locals.adminEmail ?? 'admin';
  if (parsed.success && parsed.data.action === 'delete') {
    await deleteContacts(parsed.data.keys, actor);
    back.set('saved', 'deleted');
  } else if (parsed.success && parsed.data.action !== 'delete') {
    const add = parsed.data.action === 'tag-add';
    const { changed, skipped } = await tagContacts(parsed.data.keys, parsed.data.tag, add, actor);
    back.set('tagged', add ? 'added' : 'removed');
    back.set('which', parsed.data.tag);
    back.set('n', String(changed));
    if (skipped) back.set('skipped', String(skipped));
  }
  return Astro.redirect(`/admin/contacts${back.size ? `?${back}` : ''}`);
}
const q = url.searchParams.get('q') ?? '';
const show = url.searchParams.get('show') ?? 'all';
const event = Number(url.searchParams.get('event')) || 0;
const tagParam = url.searchParams.get('tag') ?? '';
const tag = isContactTag(tagParam) ? tagParam : '';
const all = await loadContacts();
const shown = filterContacts(all, { q, show, event, tag });
const hint = CONTACT_FILTER_HINTS[show as keyof typeof CONTACT_FILTER_HINTS];

// The result of an "Add tag" / "Remove tag" bulk action, shown once after the redirect.
const tagged = Astro.request.method === 'GET' ? url.searchParams.get('tagged') : null;
const which = url.searchParams.get('which') ?? '';
let taggedText = '';
let taggedTone: 'success' | 'warning' = 'success';
if ((tagged === 'added' || tagged === 'removed') && isContactTag(which)) {
  const n = Number(url.searchParams.get('n')) || 0;
  const skipped = Number(url.searchParams.get('skipped')) || 0;
  const people = (k: number) => `${k} contact${k === 1 ? '' : 's'}`;
  const label = CONTACT_TAGS[which];
  const walkIns = `${skipped === 1 ? '1 walk-in' : `${skipped} walk-ins`} without an email ${skipped === 1 ? 'was' : 'were'} skipped: add an email on their page to tag them.`;
  if (n === 0 && skipped) {
    taggedTone = 'warning';
    taggedText = `Nothing changed. ${walkIns}`;
  } else {
    taggedText =
      tagged === 'added'
        ? n
          ? `Tag “${label}” added to ${people(n)}.`
          : `Everyone selected already had the tag “${label}”.`
        : n
          ? `Tag “${label}” removed from ${people(n)}.`
          : `Nobody selected had the tag “${label}”.`;
    if (skipped) taggedText += ` ${walkIns}`;
  }
}

// Events people registered for, newest first, for the event filter.
const eventOptions = [
  ...new Map(all.flatMap((c) => c.history.map((r) => [r.event.id, r.event] as const))).values(),
].sort((a, b) => b.startsAt.getTime() - a.startsAt.getTime());
const summary = [
  ['Contacts', all.length],
  ['Came at least once', all.filter((c) => c.attended > 0).length],
  ['Came 2 times or more', all.filter((c) => c.attended > 1).length],
  ['Linked to the ecosystem', all.filter((c) => c.organisations.length > 0).length],
];
const csv = `/admin/contacts.csv${url.search}`;
const filtered = Boolean(q || event || tag || show !== 'all');
const emails = [...new Set(shown.map((c) => c.email).filter(Boolean))].join(', ');
---

<AdminLayout title="Contacts">
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <p class="max-w-3xl text-muted">
      Everyone who ever registered for an event or was added as a walk-in, one line per person
      (grouped by email), plus anyone you add by hand. Nobody has to sign up: the list builds itself
      from registrations. Click a name to edit, contact or delete them.
    </p>
    <Button href="/admin/contacts/new" size="sm">
      New contact
    </Button>
  </div>
  <dl class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {summary.map(([k, v]) => (
      <div class="admin-panel !p-3">
        <dt class="text-xs text-muted">{k}</dt>
        <dd class="font-display text-2xl font-bold text-navy">{v}</dd>
      </div>
    ))}
  </dl>

  {taggedText && (
    <Alert tone={taggedTone} class="mb-4">
      {taggedText}
    </Alert>
  )}

  <div class="admin-panel overflow-x-auto">
    <form method="get" role="search" class="mb-4 flex flex-wrap items-center gap-2">
      <label for="q" class="sr-only">
        Search
      </label>
      <input
        id="q"
        name="q"
        value={q}
        type="search"
        placeholder="Name, email, company or listing"
        class="w-full rounded-lg border border-line px-3 py-1.5 sm:w-72"
      />
      <label for="show" class="sr-only">
        Show
      </label>
      <select
        id="show"
        name="show"
        class="max-w-full rounded-lg border border-line px-3 py-1.5"
        onchange="this.form.requestSubmit()"
      >
        {Object.entries(CONTACT_FILTERS).map(([k, label]) => (
          <option value={k} selected={k === show}>
            {label}
          </option>
        ))}
      </select>
      <label for="tag" class="sr-only">
        Tag
      </label>
      <select
        id="tag"
        name="tag"
        class="max-w-full rounded-lg border border-line px-3 py-1.5"
        onchange="this.form.requestSubmit()"
      >
        <option value="">Any tag</option>
        {Object.entries(CONTACT_TAGS).map(([k, label]) => (
          <option value={k} selected={k === tag}>
            {label}
          </option>
        ))}
      </select>
      <label for="event" class="sr-only">
        Event
      </label>
      <select
        id="event"
        name="event"
        class="max-w-full rounded-lg border border-line px-3 py-1.5 sm:max-w-xs"
        onchange="this.form.requestSubmit()"
      >
        <option value="">All events</option>
        {eventOptions.map((e) => (
          <option value={e.id} selected={e.id === event}>
            {formatDate(e.startsAt)} · {e.title}
          </option>
        ))}
      </select>
      <Button type="submit" size="sm" variant="secondary">
        Filter
      </Button>
      {filtered && (
        <a href="/admin/contacts" class="text-sm">
          Clear
        </a>
      )}
      {emails && (
        <Button
          size="sm"
          variant="secondary"
          class="sm:ml-auto"
          data-copy={emails}
          title="Paste into the Bcc field of an email"
        >
          Copy emails
        </Button>
      )}
      <Button href={csv} size="sm" class={emails ? '' : 'sm:ml-auto'}>
        Export CSV{filtered ? ` (${shown.length})` : ''}
      </Button>
    </form>

    {hint && <p class="mb-3 text-sm text-muted">{hint}</p>}

    {shown.length ? (
      <form method="post" data-bulk>
        <div
          data-bulk-bar
          hidden
          class="sticky top-0 z-10 mb-3 flex flex-wrap items-center gap-2 rounded-lg bg-navy p-3 text-paper"
        >
          <p class="mr-auto text-sm font-semibold" aria-live="polite">
            <span data-bulk-count>0</span> selected
          </p>
          <span class="flex flex-wrap items-center gap-2">
            <label for="bulk-tag" class="sr-only">
              Tag to add or remove
            </label>
            <select
              id="bulk-tag"
              name="tag"
              data-bulk-tag
              class="rounded-lg border border-paper/40 bg-navy px-2 py-1 text-sm text-paper"
            >
              <option value="">Choose a tag…</option>
              {Object.entries(CONTACT_TAGS).map(([k, label]) => (
                <option value={k}>{label}</option>
              ))}
            </select>
            <Button
              type="submit"
              size="sm"
              variant="light"
              name="action"
              value="tag-add"
              data-bulk-tag-action
            >
              Add tag
            </Button>
            <Button
              type="submit"
              size="sm"
              variant="light"
              name="action"
              value="tag-remove"
              data-bulk-tag-action
            >
              Remove tag
            </Button>
          </span>
          <Button
            type="submit"
            size="sm"
            variant="light"
            formaction="/admin/contacts/merge"
            formmethod="get"
            data-bulk-merge
            title="Combine duplicates into one contact"
          >
            Merge…
          </Button>
          <Button type="button" size="sm" variant="light" data-bulk-copy>
            Copy emails
          </Button>
          <Button
            type="submit"
            size="sm"
            variant="light"
            formaction="/admin/contacts.csv"
            formmethod="post"
          >
            Export CSV
          </Button>
          <Button
            type="submit"
            size="sm"
            name="action"
            value="delete"
            data-bulk-delete
            data-confirm="Delete the selected contacts and all their registrations?"
          >
            Delete
          </Button>
        </div>
        <table class="admin-table" data-sortable>
          <thead>
            <tr>
              <th data-nosort class="w-8">
                <input
                  type="checkbox"
                  data-bulk-all
                  aria-label="Select all contacts shown"
                  class="size-4 accent-brand"
                />
              </th>
              <th>Name</th>
              <th>Company</th>
              <th>Attended</th>
              <th>Registered</th>
              <th>No-shows</th>
              <th>Last event</th>
              <th>Ecosystem</th>
              <th>Newsletter</th>
            </tr>
          </thead>
          <tbody>
            {shown.map((c) => (
              <tr>
                <td>
                  <input
                    type="checkbox"
                    name="c"
                    value={c.key}
                    data-email={c.email ?? ''}
                    aria-label={`Select ${c.name}`}
                    class="size-4 accent-brand"
                  />
                </td>
                <td>
                  <a href={`/admin/contacts/view?c=${encodeURIComponent(c.key)}`}>{c.name}</a>
                  {c.member?.status === 'active' && (
                    <Badge tone="accent" class="ml-1">
                      Member
                    </Badge>
                  )}
                  {c.tags.map((t) => (
                    <Badge tone="brand" class="ml-1">
                      {CONTACT_TAGS[t]}
                    </Badge>
                  ))}
                  <span class="block text-xs break-all text-muted">
                    {c.email ?? 'Walk-in, no email'}
                  </span>
                </td>
                <td>
                  {c.company ?? ''}
                  {c.role && <span class="block text-xs text-muted">{c.role}</span>}
                </td>
                <td data-sort={c.attended}>{c.attended}</td>
                <td data-sort={c.registrations}>{c.registrations}</td>
                <td data-sort={c.noShows}>{c.noShows || ''}</td>
                <td
                  class="whitespace-nowrap text-muted"
                  data-sort={c.lastEvent?.startsAt.getTime() ?? 0}
                >
                  {c.lastEvent ? formatDate(c.lastEvent.startsAt) : ''}
                </td>
                <td>
                  {c.organisations.map((o) => (
                    <span class="block">
                      {o.name}
                      {o.memberStatus === 'member' && (
                        <Badge tone="accent" class="ml-1">
                          Member company
                        </Badge>
                      )}
                    </span>
                  ))}
                </td>
                <td data-sort={c.newsletter.agreed ? 1 : 0}>
                  {c.newsletter.agreed && <Badge tone="success">Agreed</Badge>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </form>
    ) : (
      <p class="text-muted">
        {all.length ? 'Nobody matches these filters.' : 'Nobody has registered yet.'}
      </p>
    )}
  </div>
  <script>
    // Bulk selection: a bar with the count and actions appears once a row is ticked.
    const form = document.querySelector<HTMLFormElement>('form[data-bulk]');
    if (form) {
      const bar = form.querySelector<HTMLElement>('[data-bulk-bar]')!;
      const count = form.querySelector<HTMLElement>('[data-bulk-count]')!;
      const all = form.querySelector<HTMLInputElement>('[data-bulk-all]')!;
      const del = form.querySelector<HTMLButtonElement>('[data-bulk-delete]')!;
      const copy = form.querySelector<HTMLButtonElement>('[data-bulk-copy]')!;
      const merge = form.querySelector<HTMLButtonElement>('[data-bulk-merge]')!;
      const tag = form.querySelector('[data-bulk-tag]') as unknown as HTMLSelectElement;
      const tagButtons = [...form.querySelectorAll<HTMLButtonElement>('[data-bulk-tag-action]')];
      const boxes = () => [...form.querySelectorAll<HTMLInputElement>('input[name="c"]')];
      const update = () => {
        const ticked = boxes().filter((b) => b.checked);
        count.textContent = String(ticked.length);
        bar.hidden = ticked.length === 0;
        all.checked = ticked.length > 0 && ticked.length === boxes().length;
        all.indeterminate = ticked.length > 0 && !all.checked;
        const regs = ticked.length === 1 ? 'contact' : 'contacts';
        del.dataset.confirm = `Delete ${ticked.length} ${regs} and all their registrations? Event counts and stats will no longer include them. This can't be undone.`;
        const emails = new Set(ticked.map((b) => b.dataset.email).filter(Boolean));
        copy.disabled = emails.size === 0;
        copy.textContent = `Copy emails (${emails.size})`;
        for (const b of tagButtons) b.disabled = !tag.value;
        merge.disabled = ticked.length < 2 || ticked.length > 10;
      };
      form.addEventListener('change', update);
      all.addEventListener('change', () => {
        for (const b of boxes()) b.checked = all.checked;
        update();
      });
      copy.addEventListener('click', async () => {
        const emails = [
          ...new Set(
            boxes()
              .filter((b) => b.checked)
              .map((b) => b.dataset.email)
              .filter(Boolean),
          ),
        ];
        await navigator.clipboard.writeText(emails.join(', '));
        copy.textContent = 'Copied';
        setTimeout(update, 1500);
      });
      update();
    }
  </script>
</AdminLayout>
