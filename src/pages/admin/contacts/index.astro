---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import Alert from '../../../components/Alert.astro';
import { z } from 'zod';
import {
  CONTACT_FILTER_HINTS,
  CONTACT_FILTERS,
  deleteContacts,
  filterContacts,
  loadContacts,
  tagContacts,
  type ContactLabel,
} from '../../../lib/contacts';
import { GroupSchema, createGroup, loadLabels, tagNames } from '../../../lib/contact-labels';
import { formatDate } from '../../../lib/format';
import { getSettings } from '../../../lib/settings';
import { inviteToJoin } from '../../../lib/members';
import { findDuplicates } from '../../../lib/contact-duplicates';

const url = Astro.url;
const labels = await loadLabels();
/** "tag:speaker" or "group:3", as the bulk menu and the result message carry them. */
const parseLabel = (v: unknown): ContactLabel | null => {
  const m = /^(tag|group):(.+)$/.exec(String(v ?? ''));
  if (m?.[1] === 'tag' && labels.tagName.has(m[2]!)) return { kind: 'tag', key: m[2]! };
  if (m?.[1] === 'group' && labels.groupName.has(Number(m[2])))
    return { kind: 'group', id: Number(m[2]) };
  return null;
};
if (Astro.request.method === 'POST') {
  // Bulk actions on the selected rows (export goes to contacts.csv instead).
  const form = await Astro.request.formData();
  const keys = z.array(z.string().min(1).max(320)).min(1).max(2000);
  const parsed = z
    .discriminatedUnion('action', [
      z.object({ action: z.literal('delete'), keys }),
      z.object({ action: z.literal('invite'), keys }),
      z.object({
        action: z.enum(['tag-add', 'tag-remove']),
        keys,
        label: z.string().max(100),
        newGroup: z.string().optional(),
      }),
    ])
    .safeParse({
      action: form.get('action'),
      keys: form.getAll('c'),
      label: form.get('label') ?? '',
      newGroup: form.get('newGroup') ?? undefined,
    });
  const back = new URLSearchParams(url.search);
  for (const k of ['saved', 'tagged', 'n', 'skipped', 'which', 'invited']) back.delete(k);
  const actor = Astro.locals.adminEmail ?? 'admin';
  if (parsed.success && parsed.data.action === 'delete') {
    await deleteContacts(parsed.data.keys, actor);
    back.set('saved', 'deleted');
  } else if (parsed.success && parsed.data.action === 'invite') {
    const wanted = new Set(parsed.data.keys);
    const r = await inviteToJoin(
      (await loadContacts()).filter((c) => wanted.has(c.key)),
      actor,
    );
    back.set('invited', [r.sent, r.members, r.recent, r.noEmail].join('.'));
  } else if (parsed.success && 'label' in parsed.data) {
    const add = parsed.data.action === 'tag-add';
    let label = parseLabel(parsed.data.label);
    // "New group…": create it from the name typed next to the menu, then add the people.
    const group = GroupSchema.safeParse({ name: parsed.data.newGroup ?? '' });
    if (parsed.data.label === 'new-group' && add && group.success) {
      const id = await createGroup(group.data, actor);
      label = { kind: 'group', id };
    }
    if (label) {
      const { changed, skipped } = await tagContacts(parsed.data.keys, label, add, actor);
      back.set('tagged', add ? 'added' : 'removed');
      back.set('which', label.kind === 'tag' ? `tag:${label.key}` : `group:${label.id}`);
      back.set('n', String(changed));
      if (skipped) back.set('skipped', String(skipped));
    }
  }
  return Astro.redirect(`/admin/contacts${back.size ? `?${back}` : ''}`);
}
const q = url.searchParams.get('q') ?? '';
const show = url.searchParams.get('show') ?? 'all';
const event = Number(url.searchParams.get('event')) || 0;
const tagParam = url.searchParams.get('tag') ?? '';
const tag = labels.tagName.has(tagParam) ? tagParam : '';
const groupParam = Number(url.searchParams.get('group')) || 0;
const group = labels.groupName.has(groupParam) ? groupParam : 0;
const currentGroup = labels.groups.find((g) => g.id === group);
const all = await loadContacts();
const shown = filterContacts(all, { q, show, event, tag, group });
const hint = CONTACT_FILTER_HINTS[show as keyof typeof CONTACT_FILTER_HINTS];

// The result of an "Add tag" / "Remove tag" bulk action, shown once after the redirect.
const tagged = Astro.request.method === 'GET' ? url.searchParams.get('tagged') : null;
const which = parseLabel(url.searchParams.get('which'));
let taggedText = '';
let taggedTone: 'success' | 'warning' = 'success';
if ((tagged === 'added' || tagged === 'removed') && which) {
  const n = Number(url.searchParams.get('n')) || 0;
  const skipped = Number(url.searchParams.get('skipped')) || 0;
  const people = (k: number) => `${k} contact${k === 1 ? '' : 's'}`;
  const isTag = which.kind === 'tag';
  const walkIns = `${skipped === 1 ? '1 walk-in' : `${skipped} walk-ins`} without an email ${skipped === 1 ? 'was' : 'were'} skipped: add an email on their page first.`;
  if (n === 0 && skipped) {
    taggedTone = 'warning';
    taggedText = `Nothing changed. ${walkIns}`;
  } else {
    const name =
      which.kind === 'tag' ? labels.tagName.get(which.key) : labels.groupName.get(which.id);
    const add = tagged === 'added';
    taggedText = isTag
      ? n
        ? `Tag “${name}” ${add ? 'added to' : 'removed from'} ${people(n)}.`
        : add
          ? `Everyone selected already had the tag “${name}”.`
          : `Nobody selected had the tag “${name}”.`
      : n
        ? `${people(n)} ${add ? 'added to' : 'taken out of'} the group “${name}”.`
        : add
          ? `Everyone selected was already in the group “${name}”.`
          : `Nobody selected was in the group “${name}”.`;
    if (skipped) taggedText += ` ${walkIns}`;
  }
}

// The result of "Invite to join", shown once after the redirect.
const invited =
  Astro.request.method === 'GET'
    ? (url.searchParams.get('invited') ?? '').split('.').map((n) => Number(n) || 0)
    : [];
const nContacts = (k: number) => `${k} contact${k === 1 ? '' : 's'}`;
const invitedText =
  invited.length === 4
    ? [
        `“Claim your membership” sent to ${nContacts(invited[0]!)}.`,
        invited[1]
          ? `${nContacts(invited[1])} already ${invited[1] === 1 ? 'a member' : 'members'} (skipped).`
          : '',
        invited[2] ? `${nContacts(invited[2])} invited in the last 30 days (skipped).` : '',
        invited[3] ? `${nContacts(invited[3])} without an email (skipped).` : '',
      ]
        .filter(Boolean)
        .join(' ')
    : '';
const settings = await getSettings();
const membershipOpen = settings.memberSignupOpen;
const duplicates = findDuplicates(all, new Set(settings.notDuplicates)).length;

// Events people registered for, newest first, for the event filter.
const eventOptions = [
  ...new Map(all.flatMap((c) => c.history.map((r) => [r.event.id, r.event] as const))).values(),
].sort((a, b) => b.startsAt.getTime() - a.startsAt.getTime());
const summary = [
  ['Contacts', all.length],
  ['Came at least once', all.filter((c) => c.attended > 0).length],
  ['Came 2 times or more', all.filter((c) => c.attended > 1).length],
  ['Linked to the ecosystem', all.filter((c) => c.organisations.length > 0).length],
];
const csv = `/admin/contacts.csv${url.search}`;
const filtered = Boolean(q || event || tag || group || show !== 'all');
const emails = [...new Set(shown.map((c) => c.email).filter(Boolean))].join(', ');
---

<AdminLayout title="Contacts">
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <p class="max-w-3xl text-muted">
      Everyone who ever registered for an event or was added as a walk-in, one line per person
      (grouped by email), plus anyone you add by hand. Nobody has to sign up: the list builds itself
      from registrations. Click a name to edit, contact or delete them.
    </p>
    <div class="flex flex-wrap gap-2">
      <Button href="/admin/contacts/labels" size="sm" variant="secondary">
        Tags and groups
      </Button>
      <Button href="/admin/contacts/duplicates" size="sm" variant="secondary">
        Possible duplicates{duplicates ? ` (${duplicates})` : ''}
      </Button>
      <Button href="/admin/contacts/new" size="sm">
        New contact
      </Button>
    </div>
  </div>
  <dl class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {summary.map(([k, v]) => (
      <div class="admin-panel !p-3">
        <dt class="text-xs text-muted">{k}</dt>
        <dd class="font-display text-2xl font-bold text-navy">{v}</dd>
      </div>
    ))}
  </dl>

  {invitedText && (
    <Alert tone="success" class="mb-4">
      {invitedText}
    </Alert>
  )}
  {taggedText && (
    <Alert tone={taggedTone} class="mb-4">
      {taggedText}
    </Alert>
  )}

  <div class="admin-panel overflow-x-auto">
    <form method="get" role="search" class="mb-4 flex flex-wrap items-center gap-2">
      <label for="q" class="sr-only">
        Search
      </label>
      <input
        id="q"
        name="q"
        value={q}
        type="search"
        placeholder="Name, email, company or listing"
        class="w-full rounded-lg border border-line px-3 py-1.5 sm:w-72"
      />
      <label for="show" class="sr-only">
        Show
      </label>
      <select
        id="show"
        name="show"
        class="max-w-full rounded-lg border border-line px-3 py-1.5"
        onchange="this.form.requestSubmit()"
      >
        {Object.entries(CONTACT_FILTERS).map(([k, label]) => (
          <option value={k} selected={k === show}>
            {label}
          </option>
        ))}
      </select>
      <label for="tag" class="sr-only">
        Tag
      </label>
      <select
        id="tag"
        name="tag"
        class="max-w-full rounded-lg border border-line px-3 py-1.5"
        onchange="this.form.requestSubmit()"
      >
        <option value="">Any tag</option>
        {labels.tags.map((t) => (
          <option value={t.key} selected={t.key === tag}>
            {t.name}
          </option>
        ))}
      </select>
      {labels.groups.length > 0 && (
        <>
          <label for="group" class="sr-only">
            Group
          </label>
          <select
            id="group"
            name="group"
            class="max-w-full rounded-lg border border-line px-3 py-1.5 sm:max-w-xs"
            onchange="this.form.requestSubmit()"
          >
            <option value="">Any group</option>
            {labels.groups.map((g) => (
              <option value={g.id} selected={g.id === group}>
                {g.name}
              </option>
            ))}
          </select>
        </>
      )}
      <label for="event" class="sr-only">
        Event
      </label>
      <select
        id="event"
        name="event"
        class="max-w-full rounded-lg border border-line px-3 py-1.5 sm:max-w-xs"
        onchange="this.form.requestSubmit()"
      >
        <option value="">All events</option>
        {eventOptions.map((e) => (
          <option value={e.id} selected={e.id === event}>
            {formatDate(e.startsAt)} · {e.title}
          </option>
        ))}
      </select>
      <Button type="submit" size="sm" variant="secondary">
        Filter
      </Button>
      {filtered && (
        <a href="/admin/contacts" class="text-sm">
          Clear
        </a>
      )}
      {emails && (
        <Button
          size="sm"
          variant="secondary"
          class="sm:ml-auto"
          data-copy={emails}
          title="Paste into the Bcc field of an email"
        >
          Copy emails
        </Button>
      )}
      <Button href={csv} size="sm" class={emails ? '' : 'sm:ml-auto'}>
        Export CSV{filtered ? ` (${shown.length})` : ''}
      </Button>
    </form>

    {hint && <p class="mb-3 text-sm text-muted">{hint}</p>}
    {currentGroup && (
      <div class="mb-3 flex flex-wrap items-center gap-3 rounded-lg bg-surface p-3 text-sm">
        <p class="mr-auto">
          <strong>{currentGroup.name}</strong>: {shown.length}{' '}
          {shown.length === 1 ? 'person' : 'people'}
          {currentGroup.description && (
            <span class="block text-muted">{currentGroup.description}</span>
          )}
        </p>
        <Button
          href={`/admin/community-email?audience=segment&group=${currentGroup.id}`}
          size="sm"
          variant="secondary"
        >
          Email this group
        </Button>
      </div>
    )}

    {shown.length ? (
      <form method="post" data-bulk>
        <div
          data-bulk-bar
          hidden
          class="sticky top-0 z-10 mb-3 flex flex-wrap items-center gap-2 rounded-lg bg-navy p-3 text-paper"
        >
          <p class="mr-auto text-sm font-semibold" aria-live="polite">
            <span data-bulk-count>0</span> selected
          </p>
          <span class="flex flex-wrap items-center gap-2">
            <label for="bulk-tag" class="sr-only">
              Tag or group to add or remove
            </label>
            <select
              id="bulk-tag"
              name="label"
              data-bulk-tag
              class="max-w-56 rounded-lg border border-paper/40 bg-navy px-2 py-1 text-sm text-paper"
            >
              <option value="">Tag or group…</option>
              <optgroup label="Tags">
                {labels.tags.map((t) => (
                  <option value={`tag:${t.key}`}>{t.name}</option>
                ))}
              </optgroup>
              <optgroup label="Groups">
                {labels.groups.map((g) => (
                  <option value={`group:${g.id}`}>{g.name}</option>
                ))}
                <option value="new-group">New group…</option>
              </optgroup>
            </select>
            <label for="bulk-new-group" class="sr-only">
              Name of the new group
            </label>
            <input
              id="bulk-new-group"
              name="newGroup"
              maxlength={80}
              placeholder="Group name"
              hidden
              data-bulk-new-group
              class="w-40 rounded-lg border border-paper/40 bg-navy px-2 py-1 text-sm text-paper placeholder:text-paper/60"
            />
            <Button
              type="submit"
              size="sm"
              variant="light"
              name="action"
              value="tag-add"
              data-bulk-tag-action
            >
              Add
            </Button>
            <Button
              type="submit"
              size="sm"
              variant="light"
              name="action"
              value="tag-remove"
              data-bulk-tag-action
              data-bulk-remove
            >
              Remove
            </Button>
          </span>
          <Button
            type="submit"
            size="sm"
            variant="light"
            formaction="/admin/contacts/merge"
            formmethod="get"
            data-bulk-merge
            title="Combine duplicates into one contact"
          >
            Merge…
          </Button>
          <Button type="button" size="sm" variant="light" data-bulk-copy>
            Copy emails
          </Button>
          <Button
            type="submit"
            size="sm"
            variant="light"
            formaction="/admin/community-email"
            formmethod="post"
            name="action"
            value="compose"
            title="Write one email to the selected contacts"
          >
            Email…
          </Button>
          {membershipOpen && (
            <Button
              type="submit"
              size="sm"
              variant="light"
              name="action"
              value="invite"
              data-confirm="Send the selected contacts the “Claim your membership” email? Members and people invited in the last 30 days are skipped."
              title="Email them a prefilled link to claim their free membership"
            >
              Invite to join
            </Button>
          )}
          <Button
            type="submit"
            size="sm"
            variant="light"
            formaction="/admin/contacts.csv"
            formmethod="post"
          >
            Export CSV
          </Button>
          <Button
            type="submit"
            size="sm"
            name="action"
            value="delete"
            data-bulk-delete
            data-confirm="Delete the selected contacts and all their registrations?"
          >
            Delete
          </Button>
        </div>
        <table class="admin-table" data-sortable>
          <thead>
            <tr>
              <th data-nosort class="w-8">
                <input
                  type="checkbox"
                  data-bulk-all
                  aria-label="Select all contacts shown"
                  class="size-4 accent-brand"
                />
              </th>
              <th>Name</th>
              <th>Company</th>
              <th>Attended</th>
              <th>Registered</th>
              <th>No-shows</th>
              <th>Last event</th>
              <th>Ecosystem</th>
              <th>Newsletter</th>
            </tr>
          </thead>
          <tbody>
            {shown.map((c) => (
              <tr>
                <td>
                  <input
                    type="checkbox"
                    name="c"
                    value={c.key}
                    data-email={c.email ?? ''}
                    aria-label={`Select ${c.name}`}
                    class="size-4 accent-brand"
                  />
                </td>
                <td>
                  <a href={`/admin/contacts/view?c=${encodeURIComponent(c.key)}`}>{c.name}</a>
                  {c.member?.status === 'active' && (
                    <Badge tone="accent" class="ml-1">
                      Member
                    </Badge>
                  )}
                  {!c.member && c.invitedAt && (
                    <span class="ml-1 text-xs text-muted">
                      Invited {formatDate(c.invitedAt, { year: undefined })}
                    </span>
                  )}
                  {tagNames(c.tags, labels).map((t) => (
                    <Badge tone="brand" class="ml-1">
                      {t}
                    </Badge>
                  ))}
                  <span class="block text-xs break-all text-muted">
                    {c.email ?? 'Walk-in, no email'}
                  </span>
                </td>
                <td>
                  {c.company ?? ''}
                  {c.role && <span class="block text-xs text-muted">{c.role}</span>}
                </td>
                <td data-sort={c.attended}>{c.attended}</td>
                <td data-sort={c.registrations}>{c.registrations}</td>
                <td data-sort={c.noShows}>{c.noShows || ''}</td>
                <td
                  class="whitespace-nowrap text-muted"
                  data-sort={c.lastEvent?.startsAt.getTime() ?? 0}
                >
                  {c.lastEvent ? formatDate(c.lastEvent.startsAt) : ''}
                </td>
                <td>
                  {c.organisations.map((o) => (
                    <span class="block">
                      {o.name}
                      {o.memberStatus === 'member' && (
                        <Badge tone="accent" class="ml-1">
                          Member company
                        </Badge>
                      )}
                    </span>
                  ))}
                </td>
                <td data-sort={c.newsletter.agreed ? 1 : 0}>
                  {c.newsletter.agreed && <Badge tone="success">Agreed</Badge>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </form>
    ) : (
      <p class="text-muted">
        {all.length ? 'Nobody matches these filters.' : 'Nobody has registered yet.'}
      </p>
    )}
  </div>
  <script>
    // Bulk selection: a bar with the count and actions appears once a row is ticked.
    const form = document.querySelector<HTMLFormElement>('form[data-bulk]');
    if (form) {
      const bar = form.querySelector<HTMLElement>('[data-bulk-bar]')!;
      const count = form.querySelector<HTMLElement>('[data-bulk-count]')!;
      const all = form.querySelector<HTMLInputElement>('[data-bulk-all]')!;
      const del = form.querySelector<HTMLButtonElement>('[data-bulk-delete]')!;
      const copy = form.querySelector<HTMLButtonElement>('[data-bulk-copy]')!;
      const merge = form.querySelector<HTMLButtonElement>('[data-bulk-merge]')!;
      const tag = form.querySelector('[data-bulk-tag]') as unknown as HTMLSelectElement;
      const tagButtons = [...form.querySelectorAll<HTMLButtonElement>('[data-bulk-tag-action]')];
      const remove = form.querySelector<HTMLButtonElement>('[data-bulk-remove]')!;
      const newGroup = form.querySelector<HTMLInputElement>('[data-bulk-new-group]')!;
      const boxes = () => [...form.querySelectorAll<HTMLInputElement>('input[name="c"]')];
      const update = () => {
        const ticked = boxes().filter((b) => b.checked);
        count.textContent = String(ticked.length);
        bar.hidden = ticked.length === 0;
        all.checked = ticked.length > 0 && ticked.length === boxes().length;
        all.indeterminate = ticked.length > 0 && !all.checked;
        const regs = ticked.length === 1 ? 'contact' : 'contacts';
        del.dataset.confirm = `Delete ${ticked.length} ${regs} and all their registrations? Event counts and stats will no longer include them. This can't be undone.`;
        const emails = new Set(ticked.map((b) => b.dataset.email).filter(Boolean));
        copy.disabled = emails.size === 0;
        copy.textContent = `Copy emails (${emails.size})`;
        const creating = tag.value === 'new-group';
        newGroup.hidden = !creating;
        for (const b of tagButtons) b.disabled = !tag.value || (creating && !newGroup.value.trim());
        remove.disabled ||= creating;
        merge.disabled = ticked.length < 2 || ticked.length > 10;
      };
      form.addEventListener('change', update);
      newGroup.addEventListener('input', update);
      tag.addEventListener('change', () => {
        update();
        if (tag.value === 'new-group') newGroup.focus();
      });
      all.addEventListener('change', () => {
        for (const b of boxes()) b.checked = all.checked;
        update();
      });
      copy.addEventListener('click', async () => {
        const emails = [
          ...new Set(
            boxes()
              .filter((b) => b.checked)
              .map((b) => b.dataset.email)
              .filter(Boolean),
          ),
        ];
        await navigator.clipboard.writeText(emails.join(', '));
        copy.textContent = 'Copied';
        setTimeout(update, 1500);
      });
      update();
    }
  </script>
</AdminLayout>
