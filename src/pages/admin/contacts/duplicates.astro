---
import { z } from 'zod';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Alert from '../../../components/Alert.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import { CONTACT_TAGS, loadContacts } from '../../../lib/contacts';
import { DUPLICATE_REASONS, findDuplicates, pairKey } from '../../../lib/contact-duplicates';
import { MEMBER_STATUSES } from '../../../lib/members';
import { getSettings, saveSettings } from '../../../lib/settings';
import { formatDate } from '../../../lib/format';

// Contacts that look like the same person (lib/contact-duplicates.ts), read live. Each group links
// to the merge page with the suggested main contact picked, or can be marked "not the same person"
// so it stops showing.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const keys = z
    .array(z.string().min(1).max(320))
    .min(2)
    .max(50)
    .safeParse(form.getAll('c').map(String));
  if (keys.success) {
    const pairs = keys.data.flatMap((a, i) => keys.data.slice(i + 1).map((b) => pairKey(a, b)));
    const { notDuplicates } = await getSettings();
    await saveSettings({ notDuplicates: [...new Set([...notDuplicates, ...pairs])] });
  }
  return Astro.redirect('/admin/contacts/duplicates?saved=done', 303);
}

const [all, settings] = await Promise.all([loadContacts(), getSettings()]);
const groups = findDuplicates(all, new Set(settings.notDuplicates));
---

<AdminLayout title="Possible duplicates">
  <p class="mb-4 max-w-3xl text-muted">
    Contacts that may be the same person, found in the live list: same name, same phone, same
    LinkedIn, the same email before the @ (jean.dupont@gmail.com and jean.dupont@company.com), or
    the same first name at the same company. Nothing is merged on its own. Untick anyone who doesn't
    belong in a group, then <strong>Review and merge</strong> opens the merge page with the
    suggested main contact (listed first: a member, then the one with an email who came most)
    already picked; you can still change everything there. <strong>Not the same person</strong>{' '}
    hides the group for good.
  </p>
  <p class="mb-4 text-sm">
    <a href="/admin/contacts">Back to Contacts</a>
  </p>

  {groups.length === 0 ? (
    <Alert tone="success">No possible duplicates left.</Alert>
  ) : (
    <>
      <p class="mb-3 font-semibold">
        {groups.length} possible {groups.length === 1 ? 'duplicate' : 'duplicates'}
      </p>
      <ul class="grid gap-4">
        {groups.map((g, n) => {
          const keys = g.contacts.map((c) => c.key);
          const formId = `merge-${n}`;
          return (
            <li class="admin-panel grid gap-3">
              <div class="flex flex-wrap gap-1">
                {g.reasons.map((r) => (
                  <Badge tone="warning">{DUPLICATE_REASONS[r]}</Badge>
                ))}
              </div>
              <ul class="grid gap-3 md:grid-cols-2">
                {g.contacts.map((c, i) => (
                  <li class="grid gap-0.5 rounded-lg border border-line p-3 text-sm">
                    <label class="flex items-center gap-2 text-xs text-muted">
                      <input
                        type="checkbox"
                        name="c"
                        value={c.key}
                        form={formId}
                        checked
                        class="size-4 accent-brand"
                      />
                      Include in the merge
                    </label>
                    <span class="font-semibold">
                      <a href={`/admin/contacts/view?c=${encodeURIComponent(c.key)}`}>{c.name}</a>
                      {i === 0 && (
                        <Badge tone="success" class="ml-1">
                          Suggested main
                        </Badge>
                      )}
                      {c.member && (
                        <Badge tone="accent" class="ml-1">
                          {c.member.status === 'active'
                            ? 'Member'
                            : MEMBER_STATUSES[c.member.status]}
                        </Badge>
                      )}
                      {c.tags.map((t) => (
                        <Badge tone="brand" class="ml-1">
                          {CONTACT_TAGS[t]}
                        </Badge>
                      ))}
                    </span>
                    <span class="break-all text-muted">
                      {[c.email ?? 'Walk-in, no email', ...c.otherEmails].join(', ')}
                    </span>
                    {(c.phone || c.company) && (
                      <span class="text-muted">
                        {[c.phone, c.company].filter(Boolean).join(' · ')}
                      </span>
                    )}
                    {c.linkedin && <span class="break-all text-muted">{c.linkedin}</span>}
                    <span class="text-muted">
                      Came {c.attended}, registered {c.registrations}
                      {c.lastEvent &&
                        `, last: ${c.lastEvent.title} (${formatDate(c.lastEvent.startsAt)})`}
                    </span>
                  </li>
                ))}
              </ul>
              <div class="flex flex-wrap items-center gap-2">
                {keys.length <= 10 ? (
                  <form id={formId} method="get" action="/admin/contacts/merge">
                    <input type="hidden" name="keep" value={keys[0]} />
                    <input type="hidden" name="next" value="duplicates" />
                    <Button type="submit" size="sm">
                      Review and merge
                    </Button>
                  </form>
                ) : (
                  <span class="text-sm text-muted">
                    More than 10: tick the right ones in Contacts and merge them from there.
                  </span>
                )}
                <form method="post">
                  {keys.map((k) => (
                    <input type="hidden" name="c" value={k} />
                  ))}
                  <Button type="submit" size="sm" variant="ghost">
                    Not the same person
                  </Button>
                </form>
              </div>
            </li>
          );
        })}
      </ul>
    </>
  )}
</AdminLayout>
