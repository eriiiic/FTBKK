---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Alert from '../../../components/Alert.astro';
import ContactForm from '../../../components/admin/ContactForm.astro';
import { ContactSchema, contactInput, createContact } from '../../../lib/contacts';
import { setMembershipByTeam } from '../../../lib/members';
import { audit } from '../../../lib/orgs';
import { fieldErrors, formToObject } from '../../../lib/forms';

const actor = Astro.locals.adminEmail ?? 'admin';
let errors: Record<string, string> = {};
let values: Record<string, unknown> = {};
let existing = '';

if (Astro.request.method === 'POST') {
  values = formToObject(await Astro.request.formData(), ['tags']);
  const parsed = ContactSchema.safeParse(values);
  const input = parsed.success ? contactInput(parsed.data, null) : null;
  const member = values.member === true;
  if (!parsed.success) errors = fieldErrors(parsed.error);
  else if (!input || 'error' in input) errors = { newsletterAt: input?.error ?? 'Invalid date.' };
  else if (member && !input.email) errors = { member: 'Add an email to make them a member.' };
  else {
    const result = await createContact(input);
    if ('error' in result) {
      errors = { email: result.error };
      existing = result.key ?? '';
    } else {
      await audit(actor, 'contact_create', 'contact', null, null, input);
      if (member && input.email)
        await setMembershipByTeam(
          { ...input, email: input.email },
          true,
          actor,
          values.welcome === true,
        );
      return Astro.redirect(`/admin/contacts/view?c=${encodeURIComponent(result.key)}&saved=done`);
    }
  }
}
---

<AdminLayout title="New contact">
  <p class="mb-4">
    <a href="/admin/contacts">← All contacts</a>
  </p>
  <div class="admin-panel max-w-3xl">
    <p class="mb-4 text-sm text-muted">
      For someone who hasn't registered for an event yet. When they register later with the same
      email, their registrations join this contact.
    </p>
    {existing && (
      <Alert tone="danger" class="mb-4">
        This email is already in your contacts.{' '}
        <a href={`/admin/contacts/view?c=${encodeURIComponent(existing)}`}>Open that contact</a>
      </Alert>
    )}
    <ContactForm values={values} errors={errors} submit="Add contact" />
  </div>
</AdminLayout>
