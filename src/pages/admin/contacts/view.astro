---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import Alert from '../../../components/Alert.astro';
import ContactForm from '../../../components/admin/ContactForm.astro';
import {
  ContactSchema,
  contactExists,
  deleteContacts,
  loadContacts,
  saveContact,
  whatsappUrl,
} from '../../../lib/contacts';
import { audit } from '../../../lib/orgs';
import { fieldErrors, formToObject } from '../../../lib/forms';
import { formatDate, formatEventDate } from '../../../lib/format';

const key = Astro.url.searchParams.get('c') ?? '';
const actor = Astro.locals.adminEmail ?? 'admin';
const now = new Date();
const view = (k: string, flash = 'saved=done') =>
  `/admin/contacts/view?c=${encodeURIComponent(k)}&${flash}`;
let errors: Record<string, string> = {};
let values: Record<string, unknown> | null = null;

if (Astro.request.method === 'POST') {
  // The contact may have been deleted in another tab: don't bring it back.
  if (!(await contactExists(key))) return Astro.redirect('/admin/contacts');
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (action === 'delete') {
    await deleteContacts([key], actor, now);
    return Astro.redirect('/admin/contacts?saved=deleted');
  }
  values = formToObject(form);
  const parsed = ContactSchema.safeParse(values);
  if (!parsed.success) errors = fieldErrors(parsed.error);
  else {
    const result = await saveContact(key, parsed.data);
    if ('error' in result) errors = { email: result.error };
    else {
      await audit(actor, 'contact_update', 'contact', null, { key }, parsed.data);
      return Astro.redirect(view(result.key));
    }
  }
}

const contact = (await loadContacts(now)).find((c) => c.key === key);
if (!contact) return Astro.redirect('/admin/contacts');
const c = contact;
const walkIn = key.startsWith('name:');
const whatsapp = whatsappUrl(c.phone);
const actions = [
  c.email && { label: 'Email', href: `mailto:${c.email}` },
  whatsapp && { label: 'WhatsApp', href: whatsapp },
  c.phone && { label: 'Call', href: `tel:${c.phone.replace(/[^\d+]/g, '')}` },
  c.linkedin && { label: 'LinkedIn', href: c.linkedin },
].filter(Boolean) as { label: string; href: string }[];
const deleteWarning = c.history.length
  ? `Delete ${c.name} and their ${c.history.length} registration${c.history.length > 1 ? 's' : ''}? Event counts and stats will no longer include them. This can't be undone.`
  : `Delete ${c.name}? This can't be undone.`;
const tone = (s: string) =>
  s === 'attended'
    ? 'success'
    : s === 'cancelled'
      ? 'neutral'
      : s === 'waitlist'
        ? 'warning'
        : 'accent';
const statusLabel = (r: (typeof c.history)[number]) =>
  r.status === 'attended'
    ? r.walkIn
      ? 'came (walk-in)'
      : 'came'
    : r.status === 'registered' && (r.event.endsAt ?? r.event.startsAt) < now
      ? 'registered, not checked in'
      : r.status;
const details = [
  ['Email', c.email ?? 'None (walk-in)'],
  ['Phone', c.phone],
  ['Company', c.company],
  ['Role', c.role],
  ['First seen', formatDate(c.firstSeen)],
].filter(([, v]) => v) as [string, string][];
const stats = [
  ['Attended', c.attended],
  ['Registered', c.registrations],
  ['No-shows', c.noShows],
  ['Cancelled', c.cancelled],
];
---

<AdminLayout title={c.name}>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/contacts">← All contacts</a>
    {actions.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {actions.map((a) => (
          <Button
            href={a.href}
            size="sm"
            variant="secondary"
            {...(a.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {a.label}
          </Button>
        ))}
      </div>
    )}
  </div>
  <div class="grid gap-4 lg:grid-cols-[2fr_3fr]">
    <div class="grid content-start gap-4">
      <section class="admin-panel">
        <h2 class="mb-3 text-lg">Details</h2>
        <dl class="grid gap-2 text-sm">
          {details.map(([k, v]) => (
            <div class="grid grid-cols-[9rem_1fr] gap-2">
              <dt class="text-muted">{k}</dt>
              <dd class="break-words">
                {k === 'Email' && c.email ? <a href={`mailto:${c.email}`}>{v}</a> : v}
              </dd>
            </div>
          ))}
        </dl>
        {c.notes && (
          <div class="mt-3 rounded-lg bg-surface p-3 text-sm whitespace-pre-line">{c.notes}</div>
        )}
        <p class="mt-3 text-xs text-muted">
          {c.savedId
            ? 'Saved contact card. Details typed in new registrations do not change it.'
            : 'Taken from their latest registration until you edit them.'}
        </p>
      </section>

      <details class="admin-panel" open={Object.keys(errors).length > 0}>
        <summary class="cursor-pointer text-lg font-semibold">Edit</summary>
        <div class="mt-4">
          {errors.email && Object.keys(errors).length === 1 && (
            <Alert tone="danger" class="mb-4">
              {errors.email}
            </Alert>
          )}
          <ContactForm
            values={values ?? { ...c }}
            errors={errors}
            submit="Save contact"
            walkIn={walkIn}
          />
        </div>
      </details>

      <section class="admin-panel">
        <h2 class="mb-3 text-lg">Ecosystem</h2>
        {c.organisations.length ? (
          <ul class="grid gap-2">
            {c.organisations.map((o) => (
              <li class="flex flex-wrap items-center gap-2">
                <a href={`/admin/ecosystem/${o.id}`}>{o.name}</a>
                <Badge>{o.relation === 'owner' ? 'manages the listing' : 'listing contact'}</Badge>
                {o.memberStatus === 'member' && <Badge tone="accent">Member</Badge>}
                {o.status !== 'published' && <Badge tone="warning">{o.status}</Badge>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-muted">
            {c.email
              ? 'This email is not on any ecosystem listing.'
              : 'No email, so no listing can be matched.'}
          </p>
        )}
      </section>

      <form method="post" data-confirm={deleteWarning}>
        <input type="hidden" name="action" value="delete" />
        <button type="submit" class="text-sm font-semibold text-danger underline">
          Delete this contact
        </button>
      </form>
    </div>

    <section class="admin-panel">
      <dl class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {stats.map(([k, v]) => (
          <div class="rounded-lg bg-surface p-3">
            <dt class="text-xs text-muted">{k}</dt>
            <dd class="font-display text-2xl font-bold text-navy">{v}</dd>
          </div>
        ))}
      </dl>
      <h2 class="mb-3 text-lg">Events</h2>
      {c.history.length === 0 && (
        <p class="text-sm text-muted">Added by hand: no event registrations yet.</p>
      )}
      <ul class="grid gap-2">
        {c.history.map((r) => (
          <li class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-2 last:border-0">
            <span class="min-w-0">
              <a href={`/admin/registrations?event=${r.event.id}`}>{r.event.title}</a>
              <span class="block text-xs text-muted">
                {formatEventDate(r.event.startsAt, r.event.endsAt)}
              </span>
            </span>
            <Badge tone={tone(r.status)}>{statusLabel(r)}</Badge>
          </li>
        ))}
      </ul>
    </section>
  </div>
</AdminLayout>
