---
import { z } from 'zod';
import { and, asc, desc, eq, inArray, sql } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import Alert from '../../../components/Alert.astro';
import { getDb } from '../../../db';
import { auditLog, organisations } from '../../../db/schema';
import ReviewCard from '../../../components/admin/ReviewCard.astro';
import { MODERATION_TARGET_DAYS, daysUntil } from '../../../lib/lifecycle';
import { OrgNotesForm, PartnerForm, orgById, saveOrgNotes, savePartner } from '../../../lib/orgs';
import { inviteToClaim } from '../../../lib/admin';
import { DecisionForm, decide, reviewItems } from '../../../lib/moderation';
import {
  CATEGORIES,
  ORG_STATUSES,
  PARTNER_TYPES,
  PARTNER_TYPE_KEYS,
  partnerGroups,
} from '../../../lib/directory';
import { formatDate } from '../../../lib/format';

const actor = Astro.locals.adminEmail ?? 'admin';
const tabs = [
  { key: 'queue', label: 'To review' },
  { key: 'all', label: 'All listings' },
  { key: 'partners', label: 'Partners' },
  { key: 'renewals', label: 'Renewals' },
  { key: 'log', label: 'History' },
] as const;
const tab = tabs.find((t) => t.key === Astro.url.searchParams.get('tab'))?.key ?? 'queue';
let error = '';

if (Astro.request.method === 'POST') {
  const form = Object.fromEntries(await Astro.request.formData());
  if (form.action === 'partner') {
    const parsed = PartnerForm.safeParse(form);
    if (parsed.success) {
      await savePartner(parsed.data, actor);
      return Astro.redirect(`/admin/ecosystem?tab=partners&saved=1#org-${parsed.data.id}`, 303);
    }
    error = 'Pick an organisation and a partner group.';
  } else if (form.action === 'notes') {
    // Back to the same filtered list, scrolled to the listing.
    const parsed = OrgNotesForm.safeParse(form);
    if (parsed.success) {
      await saveOrgNotes(parsed.data);
      const back = new URL(Astro.url);
      back.searchParams.set('saved', '1');
      return Astro.redirect(`${back.pathname}${back.search}#org-${parsed.data.id}`, 303);
    }
    error = 'That note is too long (4,000 characters at most).';
  } else if (form.action === 'invite') {
    const id = z.coerce.number().int().safeParse(form.id);
    const to = z.email().safeParse(
      String(form.email ?? '')
        .trim()
        .toLowerCase(),
    );
    const org = id.success ? await orgById(id.data) : null;
    if (!to.success || !org) error = 'Enter a valid email address to invite.';
    else await inviteToClaim(org, to.data, actor);
  } else {
    const parsed = DecisionForm.safeParse(form);
    error = parsed.success
      ? ((await decide(parsed.data, actor)) ?? '')
      : 'Something was missing in that form.';
  }
  if (!error) return Astro.redirect(`/admin/ecosystem?tab=${tab}&saved=1`);
}

const db = getDb();
const now = new Date();
const items = tab === 'queue' ? await reviewItems() : [];

const status = Astro.url.searchParams.get('status') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase();
const all =
  tab === 'all'
    ? (
        await db
          .select()
          .from(organisations)
          .where(
            status ? eq(organisations.status, status as (typeof ORG_STATUSES)[number]) : undefined,
          )
          .orderBy(asc(organisations.name))
      ).filter(
        (o) => !q || o.name.toLowerCase().includes(q) || o.adminNotes?.toLowerCase().includes(q),
      )
    : [];

// Partners: every listing with a partner group (any status, so a hidden one is not lost), and the
// published listings that could become one.
const partnerRows =
  tab === 'partners' ? await db.select().from(organisations).orderBy(asc(organisations.name)) : [];
const groups = partnerGroups(partnerRows.filter((o) => o.partnerType));
const candidates = partnerRows.filter((o) => !o.partnerType && o.status === 'published');

const renewals =
  tab === 'renewals'
    ? await db
        .select()
        .from(organisations)
        .where(
          and(
            inArray(organisations.status, ['published', 'expired']),
            sql`(${organisations.renewalDueAt} IS NOT NULL OR json_array_length(${organisations.ownerEmails}) = 0)`,
          ),
        )
        .orderBy(sql`${organisations.renewalDueAt} IS NULL`, asc(organisations.renewalDueAt))
    : [];

const log =
  tab === 'log'
    ? await db
        .select({ a: auditLog, name: organisations.name, orgId: organisations.id })
        .from(auditLog)
        .leftJoin(
          organisations,
          and(eq(auditLog.entity, 'organisation'), eq(auditLog.entityId, organisations.id)),
        )
        .orderBy(desc(auditLog.id))
        .limit(200)
    : [];

const statusTone = (s: string) =>
  s === 'published'
    ? 'success'
    : s === 'pending'
      ? 'warning'
      : s === 'rejected' || s === 'expired'
        ? 'danger'
        : 'neutral';
const short = (v: unknown) => {
  const s = v === null || v === undefined ? '' : JSON.stringify(v);
  return s.length > 140 ? `${s.slice(0, 139)}…` : s;
};
---

<AdminLayout title="Ecosystem">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <nav aria-label="Ecosystem sections" class="flex flex-wrap gap-2">
      {tabs.map((t) => (
        <a
          href={`?tab=${t.key}`}
          aria-current={t.key === tab ? 'page' : undefined}
          class="rounded-full border border-line bg-paper px-4 py-1.5 text-sm no-underline aria-[current=page]:border-navy aria-[current=page]:bg-navy aria-[current=page]:text-paper"
        >
          {t.label}
          {t.key === 'queue' && tab === 'queue' && ` (${items.length})`}
        </a>
      ))}
    </nav>
    <Button href="/admin/ecosystem/new" size="sm">
      Add an organisation
    </Button>
  </div>
  {error && (
    <Alert tone="danger" class="mb-4">
      {error}
    </Alert>
  )}

  {tab === 'queue' && (
    <div class="grid gap-4">
      <p class="text-sm text-muted">
        Oldest first. Target: answer within {MODERATION_TARGET_DAYS} days. Every decision is emailed
        to the person, with your reason when you reject.
      </p>
      {items.length === 0 && <div class="admin-panel text-muted">Nothing to review. 🎉</div>}
      {items.map((it) => (
        <ReviewCard item={it} link />
      ))}
    </div>
  )}

  {tab === 'all' && (
    <div class="admin-panel overflow-x-auto">
      <form method="get" role="search" class="mb-4 flex flex-wrap gap-2">
        <input type="hidden" name="tab" value="all" />
        <label for="q" class="sr-only">
          Search
        </label>
        <input
          id="q"
          name="q"
          value={q}
          placeholder="Search names and notes"
          class="rounded-lg border border-line px-3 py-1.5"
        />
        <label for="status" class="sr-only">
          Status
        </label>
        <select id="status" name="status" class="rounded-lg border border-line px-3 py-1.5">
          <option value="">All statuses</option>
          {ORG_STATUSES.map((s) => (
            <option value={s} selected={s === status}>
              {s}
            </option>
          ))}
        </select>
        <Button type="submit" size="sm" variant="secondary">
          Filter
        </Button>
      </form>
      <p class="mb-2 text-sm text-muted">{all.length} organisations</p>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Status</th>
            <th>Owners</th>
            <th>Renewal</th>
            <th>Team notes</th>
          </tr>
        </thead>
        <tbody>
          {all.map((o) => (
            <tr id={`org-${o.id}`}>
              <td>
                <a href={`/admin/ecosystem/${o.id}`} class="font-semibold">
                  {o.name}
                </a>
                {o.badges.length > 0 && (
                  <span class="block text-xs text-muted">{o.badges.join(', ')}</span>
                )}
                {o.partnerType && (
                  <span class="block text-xs text-muted">
                    Partner: {PARTNER_TYPES[o.partnerType].label}
                  </span>
                )}
              </td>
              <td>{CATEGORIES[o.category].short}</td>
              <td>
                <Badge tone={statusTone(o.status)}>{o.status}</Badge>
              </td>
              <td>
                {o.ownerEmails.length ? (
                  o.ownerEmails.length
                ) : (
                  <span class="text-muted">unclaimed</span>
                )}
              </td>
              <td class="whitespace-nowrap">{o.renewalDueAt ? formatDate(o.renewalDueAt) : '–'}</td>
              <td class="min-w-48">
                <form method="post">
                  <input type="hidden" name="action" value="notes" />
                  <input type="hidden" name="id" value={o.id} />
                  <textarea
                    aria-label={`Team notes on ${o.name}`}
                    name="adminNotes"
                    rows={2}
                    maxlength={4000}
                    class="w-full rounded-lg border border-line px-2 py-1 text-xs"
                    set:text={o.adminNotes ?? ''}
                  />
                  <button type="submit" class="text-xs text-accent underline">
                    Save note
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {tab === 'partners' && (
    <div class="grid gap-6">
      <p class="text-sm text-muted">
        Partners show in their group in the Partners section of the{' '}
        <a href="/ecosystem#partners" target="_blank" rel="noopener">
          Ecosystem page ↗
        </a>
        , with the logo of their listing. Those with "Home" ticked also show in "They support La
        French Tech Bangkok" on Home. Smaller order first; same number, by name. To stop a
        partnership, choose "Not a partner": the listing stays in the directory.
      </p>
      <form method="post" class="admin-panel flex flex-wrap items-end gap-3">
        <input type="hidden" name="action" value="partner" />
        <div class="min-w-56 flex-1">
          <label for="add-org" class="block text-sm font-semibold">
            Add a partner
          </label>
          <select
            id="add-org"
            name="id"
            required
            class="mt-1 block w-full rounded-lg border border-line px-3 py-2"
          >
            <option value="">Choose a listing…</option>
            {candidates.map((o) => (
              <option value={o.id}>{o.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="add-type" class="block text-sm font-semibold">
            Group
          </label>
          <select
            id="add-type"
            name="partnerType"
            required
            class="mt-1 block rounded-lg border border-line px-3 py-2"
          >
            {PARTNER_TYPE_KEYS.map((k) => (
              <option value={k}>{PARTNER_TYPES[k].label}</option>
            ))}
          </select>
        </div>
        <label class="flex items-center gap-2 pb-2 text-sm">
          <input type="checkbox" name="partnerHome" class="accent-brand" /> Show on Home
        </label>
        <Button type="submit" size="sm">
          Add
        </Button>
        <p class="w-full text-xs text-muted">
          Not in the list? <a href="/admin/ecosystem/new">Add the organisation</a> first (with its
          logo), then pick it here or set "Partner group" on its page.
        </p>
      </form>
      {groups.length === 0 && <div class="admin-panel text-muted">No partner yet.</div>}
      {groups.map((g) => (
        <section class="admin-panel overflow-x-auto" aria-labelledby={`pg-${g.key}`}>
          <h2 id={`pg-${g.key}`} class="text-lg">
            {g.label} <span class="text-sm font-normal text-muted">({g.items.length})</span>
          </h2>
          <table class="admin-table mt-3">
            <thead>
              <tr>
                <th>Name</th>
                <th>Logo</th>
                <th>Group</th>
                <th>Order</th>
                <th>Home</th>
                <th>
                  <span class="sr-only">Save</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {g.items.map((o) => (
                <tr id={`org-${o.id}`}>
                  <td>
                    <a href={`/admin/ecosystem/${o.id}`} class="font-semibold">
                      {o.name}
                    </a>
                    {o.status !== 'published' && (
                      <span class="ml-2">
                        <Badge tone={statusTone(o.status)}>{o.status}</Badge>
                      </span>
                    )}
                  </td>
                  <td>{o.logoKey ? '✓' : <span class="text-danger">missing</span>}</td>
                  <td>
                    <select
                      form={`partner-${o.id}`}
                      name="partnerType"
                      aria-label={`Partner group of ${o.name}`}
                      class="rounded-lg border border-line px-2 py-1 text-sm"
                    >
                      <option value="">Not a partner</option>
                      {PARTNER_TYPE_KEYS.map((k) => (
                        <option value={k} selected={k === o.partnerType}>
                          {PARTNER_TYPES[k].label}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td>
                    <input
                      form={`partner-${o.id}`}
                      name="partnerOrder"
                      type="number"
                      min="0"
                      max="999"
                      value={o.partnerOrder}
                      aria-label={`Order of ${o.name}`}
                      class="w-20 rounded-lg border border-line px-2 py-1 text-sm"
                    />
                  </td>
                  <td>
                    <input
                      form={`partner-${o.id}`}
                      name="partnerHome"
                      type="checkbox"
                      checked={o.partnerHome}
                      aria-label={`Show ${o.name} on Home`}
                      class="accent-brand"
                    />
                  </td>
                  <td>
                    <form method="post" id={`partner-${o.id}`}>
                      <input type="hidden" name="action" value="partner" />
                      <input type="hidden" name="id" value={o.id} />
                      <button type="submit" class="text-sm text-accent underline">
                        Save
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  )}

  {tab === 'renewals' && (
    <div class="admin-panel overflow-x-auto">
      <p class="mb-4 text-sm text-muted">
        Owners get reminders 30 and 14 days before and on the renewal date. Listings not confirmed
        are hidden 30 days after it. Unclaimed listings get no reminders: invite someone you know at
        the organisation to claim them.
      </p>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Renewal</th>
            <th>Owners</th>
            <th>Invite to claim</th>
          </tr>
        </thead>
        <tbody>
          {renewals.map((o) => {
            const d = o.renewalDueAt ? daysUntil(o.renewalDueAt, now) : null;
            return (
              <tr>
                <td>
                  <a href={`/admin/ecosystem/${o.id}`}>{o.name}</a>
                  {o.status === 'expired' && (
                    <Badge tone="danger" class="ml-2">
                      hidden
                    </Badge>
                  )}
                </td>
                <td class="whitespace-nowrap">
                  {o.renewalDueAt ? formatDate(o.renewalDueAt) : '–'}
                  {d !== null && (
                    <span class={`block text-xs ${d < 0 ? 'text-danger' : 'text-muted'}`}>
                      {d < 0 ? `${-d} days overdue` : `in ${d} days`}
                    </span>
                  )}
                </td>
                <td>
                  {o.ownerEmails.length ? (
                    o.ownerEmails.join(', ')
                  ) : (
                    <span class="text-muted">unclaimed</span>
                  )}
                </td>
                <td>
                  {o.ownerEmails.length === 0 && (
                    <form method="post" class="flex gap-2">
                      <input type="hidden" name="id" value={o.id} />
                      <label class="sr-only" for={`inv-${o.id}`}>
                        Email to invite
                      </label>
                      <input
                        id={`inv-${o.id}`}
                        name="email"
                        type="email"
                        required
                        placeholder="name@company.com"
                        class="w-48 rounded-lg border border-line px-2 py-1"
                      />
                      <Button
                        type="submit"
                        name="action"
                        value="invite"
                        size="sm"
                        variant="secondary"
                      >
                        Send
                      </Button>
                    </form>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  {tab === 'log' && (
    <div class="admin-panel overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>When</th>
            <th>Who</th>
            <th>What</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          {log.map(({ a, name, orgId }) => (
            <tr>
              <td class="whitespace-nowrap">
                {formatDate(a.at, { hour: '2-digit', minute: '2-digit' })}
              </td>
              <td class="break-all">{a.actor}</td>
              <td>
                {a.action} {a.entity}{' '}
                {orgId ? (
                  <a href={`/admin/ecosystem/${orgId}`}>{name}</a>
                ) : a.entityId ? (
                  `#${a.entityId}`
                ) : (
                  ''
                )}
              </td>
              <td class="font-mono text-xs break-all text-muted">
                {short(a.before)} {a.after ? `→ ${short(a.after)}` : ''}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
