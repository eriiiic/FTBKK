---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import LineChart from '../../../components/admin/LineChart.astro';
import ReportTabs from '../../../components/admin/ReportTabs.astro';
import ReportFilters from '../../../components/admin/ReportFilters.astro';
import Kpi from '../../../components/admin/Kpi.astro';
import BarList from '../../../components/admin/BarList.astro';
import { formatRating } from '../../../lib/feedback';
import { formatDate } from '../../../lib/format';
import { delta, pct, periodQuery } from '../../../lib/report-period';
import { loadMemberReport } from '../../../lib/reports';

// Reports > Membership, for the board: growth over the picked period, who the members are,
// whether they come to events, how event-goers become members, and how members rate events.
const { period, report: r } = await loadMemberReport(Astro.url);
const q = periodQuery(period);
const csv = (table: string) => `/admin/reports/members.csv?${new URLSearchParams({ ...q, table })}`;
const eventsHref = (id: number) =>
  `/admin/reports/events?${new URLSearchParams({ ...q, event: String(id) })}`;
const t = r.totals;
const versus = period.previous ? `vs ${period.previous.label}` : undefined;
const fb = r.feedback;
const kpis = [
  {
    label: 'Active members',
    value: String(t.active),
    hint: `Today. ${t.lapsed} lapsed; ${t.renewalsDue} renewals due in the next 30 days`,
  },
  {
    label: 'New members',
    value: String(t.newMembers),
    delta: delta(t.newMembers, t.newBefore),
    hint: `${t.pending} sign-ups in the period never confirmed their email`,
  },
  {
    label: 'Members who came to an event',
    value: pct(t.cameShare),
    hint: `${t.activeWhoCame} active members came in this period; ${t.neverCame} never came to any event`,
  },
  {
    label: 'Attendees who are members',
    value: pct(r.attendeeShare.then),
    hint: `Members on the day, out of ${r.attendeeShare.people} attendees (${pct(r.attendeeShare.now)} are members today)`,
  },
  {
    label: 'New members who knew us',
    value: pct(t.newMembers ? t.cameBefore / t.newMembers : null),
    hint: `${t.cameBefore} had come to an event before joining; ${t.newFaces} joined first`,
  },
  {
    label: 'Attendees who joined',
    value: pct(t.conversion),
    hint: `${t.converted} of ${t.nonMemberAttendees} non-members at the period's events are members now`,
  },
  {
    label: 'Members rate events',
    value: fb.member.average === null ? '–' : `${formatRating(fb.member.average)} / 5`,
    hint: `${fb.member.responses} answers. Non-members: ${formatRating(fb.other.average)} (${fb.other.responses} answers)`,
  },
  {
    label: 'Renewals due, next 30 days',
    value: String(t.renewalsDue),
    hint: 'Active members whose year ends soon; they get reminders',
  },
];
const chrono = [...r.perEvent].reverse();
const shortDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  timeZone: 'Asia/Bangkok',
});
const share = (part: number, of: number) => (of ? Math.round((part / of) * 100) : null);
---

<AdminLayout title="Reports: membership">
  <ReportTabs />
  <ReportFilters
    period={period}
    csv={[
      { href: csv('growth'), label: 'Export growth CSV' },
      { href: csv('events'), label: 'Export events CSV' },
    ]}
  />
  <p class="mb-6 max-w-3xl text-sm text-muted">
    For the board: how membership grows, who the active members are, whether they come to events,
    and how event-goers become members. Event figures count check-ins, or registrations at events
    where check-in wasn't used. More in <a href="/admin/reports/events">Events and attendance</a>{' '}
    and <a href="/admin/members?tab=all">Members</a>.
  </p>

  <section
    aria-label="Key numbers"
    class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-4"
  >
    {kpis.map((k) => (
      <Kpi label={k.label} value={k.value} hint={k.hint} delta={k.delta} versus={versus} />
    ))}
  </section>

  <div class="mb-6 grid items-start gap-6 xl:grid-cols-2">
    <LineChart
      title={`Members, per ${r.growth.unit}`}
      labels={r.growth.rows.map((m) => m.label)}
      series={[
        { name: 'Members in total', values: r.growth.rows.map((m) => m.total), tone: 'navy' },
        {
          name: `New that ${r.growth.unit}`,
          values: r.growth.rows.map((m) => m.added),
          tone: 'brand',
        },
      ]}
      empty="No members yet."
    />
    <LineChart
      title="Share of attendees who are members, per event (%)"
      labels={chrono.map((e) => `${e.event.title} (${formatDate(e.event.startsAt)})`)}
      ticks={chrono.map((e) => shortDate.format(e.event.startsAt))}
      series={[
        {
          name: 'Members today',
          values: chrono.map((e) => share(e.membersNow, e.people)),
          tone: 'navy',
        },
        {
          name: 'Members on the day',
          values: chrono.map((e) => share(e.membersThen, e.people)),
          tone: 'brand',
        },
      ]}
      empty="No past event with attendees in this period."
    />
  </div>

  <div class="mb-6 grid gap-6 lg:grid-cols-3">
    <BarList
      title="Profile type"
      hint="Active members"
      rows={r.byProfile}
      shares
      empty="No active members yet."
    />
    <BarList
      title="Sectors of interest"
      hint="Active members. A member can pick several."
      rows={r.bySector}
      empty="No active members yet."
    />
    <BarList
      title="How new members heard of us"
      hint="Members who joined in the period"
      rows={r.howHeard}
      tone="navy"
      shares
      empty="No new member in this period."
    />
  </div>

  <div class="grid items-start gap-6 lg:grid-cols-[1fr_2fr]">
    <section class="admin-panel overflow-x-auto" aria-labelledby="engaged-title">
      <h2 id="engaged-title" class="mb-3 text-lg">
        Most regular members
      </h2>
      {r.mostEngaged.length ? (
        <table class="admin-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Events</th>
            </tr>
          </thead>
          <tbody>
            {r.mostEngaged.map((m) => (
              <tr>
                <td>
                  <a href={`/admin/members?${new URLSearchParams({ tab: 'all', q: m.email })}`}>
                    {m.name}
                  </a>
                </td>
                <td>{m.events}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="text-sm text-muted">No member came to an event in this period.</p>
      )}
      <p class="mt-3 text-xs text-muted">
        Active members who came to the most events of the period.
      </p>
    </section>

    <section class="admin-panel overflow-x-auto" aria-labelledby="per-event-title">
      <h2 id="per-event-title" class="mb-3 text-lg">
        Members at our events
      </h2>
      {r.perEvent.length ? (
        <table class="admin-table" data-sortable>
          <thead>
            <tr>
              <th>Event</th>
              <th>Date</th>
              <th>People</th>
              <th>Members on the day</th>
              <th>Members today</th>
            </tr>
          </thead>
          <tbody>
            {r.perEvent.map((e) => (
              <tr>
                <td>
                  <a href={eventsHref(e.event.id)}>{e.event.title}</a>
                </td>
                <td class="whitespace-nowrap" data-sort={e.event.startsAt.getTime()}>
                  {formatDate(e.event.startsAt)}
                </td>
                <td data-sort={e.people}>
                  {e.people}
                  <span class="block text-xs text-muted">{e.counted}</span>
                </td>
                <td data-sort={e.people ? e.membersThen / e.people : -1}>
                  {e.membersThen} ({pct(e.people ? e.membersThen / e.people : null)})
                </td>
                <td data-sort={e.people ? e.membersNow / e.people : -1}>
                  {e.membersNow} ({pct(e.people ? e.membersNow / e.people : null)})
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="text-sm text-muted">No past event in this period.</p>
      )}
    </section>
  </div>
</AdminLayout>
