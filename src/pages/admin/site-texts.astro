---
import { z } from 'zod';
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormField from '../../components/FormField.astro';
import MarkdownEditor from '../../components/admin/MarkdownEditor.astro';
import Button from '../../components/Button.astro';
import Alert from '../../components/Alert.astro';
import CardFields from '../../components/admin/CardFields.astro';
import { cardsFromForm, getSettings, saveSettings, type Settings } from '../../lib/settings';
import { fieldErrors, formToObject } from '../../lib/forms';
import { audit } from '../../lib/orgs';

// The texts of the public pages: home, Join, About, code of conduct, privacy notice.
const actor = Astro.locals.adminEmail ?? 'admin';
const current = await getSettings();

const lines = (s: string) =>
  s
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean);
/** Long texts: Windows line endings from the browser become plain new lines. */
const longText = (max: number) =>
  z
    .string()
    .max(max)
    .transform((s) => s.replace(/\r\n?/g, '\n'));
const card = z.object({
  title: z.string().min(1, 'Give every card a title.').max(80),
  text: z.string().max(400),
  link: z
    .string()
    .regex(/^(\/|https?:\/\/|mailto:)\S*$/, 'A link starts with /, https:// or mailto:')
    .max(300)
    .optional(),
});

const Schema = z.object({
  heroTitle: z.string().min(2).max(120),
  heroTagline: z.string().min(2, 'The home page needs a main heading.').max(300),
  mission: longText(2000),
  values: z.string().transform(lines),
  ecosystemHeading: z.string().max(200),
  pillars: z.array(card.omit({ link: true })).max(6),
  joinPaths: z.array(card).max(6),
  joinIntro: longText(4000),
  joinMembership: longText(2000),
  aboutIntro: longText(6000),
  communityText: longText(6000),
  codeOfConduct: longText(12000),
  privacyNotice: longText(12000),
});

let errors: Record<string, string> = {};
let values: Record<string, unknown> = { ...current, values: current.values.join('\n') };
let pillars = current.pillars;
let joinPaths = current.joinPaths;

if (Astro.request.method === 'POST') {
  values = formToObject(await Astro.request.formData(), [
    'pillarTitle',
    'pillarText',
    'joinTitle',
    'joinText',
    'joinLink',
  ]);
  pillars = cardsFromForm(values, 'pillar');
  joinPaths = cardsFromForm(values, 'join', true);
  const parsed = Schema.safeParse({ ...values, pillars, joinPaths });
  if (!parsed.success) errors = fieldErrors(parsed.error);
  else {
    const next: Partial<Settings> = parsed.data;
    await saveSettings(next);
    await audit(actor, 'update', 'settings', null, null, Object.keys(next));
    return Astro.redirect('/admin/site-texts?saved=1');
  }
}
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
---

<AdminLayout title="Site texts">
  {Object.keys(errors).length > 0 && (
    <Alert tone="danger" class="mb-6">
      Please fix the highlighted fields.
    </Alert>
  )}
  <form method="post" data-warn-unsaved class="grid max-w-3xl gap-6">
    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Home page</h2>
      <FormField
        name="heroTitle"
        label="Small line above the heading"
        required
        maxlength={120}
        value={str('heroTitle')}
        error={errors.heroTitle}
      />
      <FormField
        name="heroTagline"
        label="Main heading"
        required
        rows={2}
        maxlength={300}
        value={str('heroTagline')}
        error={errors.heroTagline}
      />
      <FormField
        name="mission"
        label="Mission"
        rows={3}
        maxlength={2000}
        value={str('mission')}
        error={errors.mission}
        hint="Under the heading, and in the footer."
      />
      <FormField
        name="values"
        label="Values"
        rows={4}
        value={str('values')}
        error={errors.values}
        hint="One per line."
      />
      <FormField
        name="ecosystemHeading"
        label="Navy section heading"
        maxlength={200}
        value={str('ecosystemHeading')}
        error={errors.ecosystemHeading}
        hint="The big title above the three pillars."
      />
      <CardFields prefix="pillar" legend="Pillars" items={pillars} error={errors.pillars} />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">You can join us</h2>
      <CardFields
        prefix="join"
        legend="Cards"
        items={joinPaths}
        error={errors.joinPaths}
        withLink
        hint="Navy cards on the home and About pages. With a link, the whole card is clickable: a page such as /events or /about#contact, or a full https:// address."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Join the community page</h2>
      <MarkdownEditor
        name="joinIntro"
        label="Why join"
        rows={8}
        value={str('joinIntro')}
        error={errors.joinIntro}
        breaks
        uploads={false}
        hint="Top of the /join page, opened by the header's Join the community button. - starts a list item, **bold**. Empty = the default text."
      />
      <MarkdownEditor
        name="joinMembership"
        label="Membership"
        rows={5}
        value={str('joinMembership')}
        error={errors.joinMembership}
        breaks
        uploads={false}
        hint="The Become a member card on /join. Empty = the default text, which changes when individual membership opens in Settings (so leave it empty unless you rewrite it for open sign-up)."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">About page</h2>
      <MarkdownEditor
        name="aboutIntro"
        label="Who we are"
        rows={12}
        value={str('aboutIntro')}
        error={errors.aboutIntro}
        breaks
        uploads={false}
        hint="Top of the About page. Line breaks are kept; leave an empty line between paragraphs. **bold**, [link text](https://…), - list. Use Preview to check."
      />
      <MarkdownEditor
        name="communityText"
        label="Official French Tech Community"
        rows={10}
        value={str('communityText')}
        error={errors.communityText}
        breaks
        uploads={false}
        hint="Shown next to the official logo on the About page. Start a line with ## for a heading. Empty = hidden."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Code of conduct</h2>
      <MarkdownEditor
        name="codeOfConduct"
        label="Code of conduct"
        rows={16}
        value={str('codeOfConduct')}
        error={errors.codeOfConduct}
        uploads={false}
        hint="The /code-of-conduct page, linked in the footer, on event pages and in the registration form. {contactEmail} is replaced by the contact email. Start a line with ## for a heading, - for a list. Empty = the default text."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Privacy notice</h2>
      <MarkdownEditor
        name="privacyNotice"
        label="Privacy notice"
        rows={16}
        value={str('privacyNotice')}
        error={errors.privacyNotice}
        uploads={false}
        hint="The /privacy page (Thailand's PDPA), linked in the footer and under every registration form. Keep it true to what the site does: what we collect, why, who sees it, how long we keep it, people's rights. {contactEmail} is replaced by the contact email. Empty = the default text."
      />
    </section>

    <div class="sticky bottom-0 z-10 -mx-4 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:mx-0 md:rounded-card md:border md:bg-paper/95">
      <Button type="submit">Save texts</Button>
    </div>
  </form>
</AdminLayout>
