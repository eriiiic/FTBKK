---
import { z } from 'zod';
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormField from '../../components/FormField.astro';
import MarkdownEditor from '../../components/admin/MarkdownEditor.astro';
import Button from '../../components/Button.astro';
import Alert from '../../components/Alert.astro';
import CardFields from '../../components/admin/CardFields.astro';
import PhotoSlot from '../../components/admin/PhotoSlot.astro';
import {
  cardsFromForm,
  getSettings,
  saveSettings,
  type Photo,
  type Settings,
} from '../../lib/settings';
import { fieldErrors, formToObject } from '../../lib/forms';
import { audit } from '../../lib/orgs';
import { DEFAULT_THAI_PAGE } from '../../lib/thai-page';
import { readPhotoSlot } from '../../lib/photo-slots';
import {
  DEFAULT_ABOUT_ITEMS,
  DEFAULT_CLOSING_TITLE,
  DEFAULT_COMMUNITY_PHOTOS,
  DEFAULT_COMMUNITY_TEXT,
  DEFAULT_COMMUNITY_TITLE,
  DEFAULT_HERO,
  DEFAULT_HOME_NUMBERS,
} from '../../lib/home';

// The texts of the public pages, one screen per page (?page=, listed under Website in the admin
// menu). Each screen saves only its own fields.
const PAGES = {
  home: 'Home page',
  about: 'About page',
  join: 'Join page',
  'tech-pulse': 'Tech Pulse page',
  thai: 'Thai page',
  legal: 'Code of conduct and privacy',
} as const;
type Page = keyof typeof PAGES;
const pageParam = Astro.url.searchParams.get('page') ?? 'home';
const page: Page = pageParam in PAGES ? (pageParam as Page) : 'home';
const actor = Astro.locals.adminEmail ?? 'admin';
const current = await getSettings();

const lines = (s: string) =>
  s
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean);
/** Long texts: Windows line endings from the browser become plain new lines. */
const longText = (max: number) =>
  z
    .string()
    .max(max)
    .transform((s) => s.replace(/\r\n?/g, '\n'));
const card = z.object({
  title: z.string().min(1, 'Give every card a title.').max(80),
  text: z.string().max(400),
  link: z
    .string()
    .regex(/^(\/|https?:\/\/|mailto:)\S*$/, 'A link starts with /, https:// or mailto:')
    .max(300)
    .optional(),
});

const Schema = z.object({
  heroTitle: z.string().min(2).max(120),
  heroTagline: z.string().min(2, 'The home page needs a main heading.').max(300),
  mission: longText(2000),
  values: z.string().transform(lines),
  ecosystemHeading: z.string().max(200),
  homeNumbers: z
    .array(
      z.object({
        title: z.string().min(1, 'Give every number a figure.').max(20),
        text: z.string().min(1, 'Give every number a label.').max(80),
      }),
    )
    .max(4),
  homeCommunityTitle: z.string().max(200),
  homeCommunityText: z.string().max(600),
  homeClosingTitle: z.string().max(200),
  homeAboutItems: z.array(card.omit({ link: true })).max(4),
  joinPaths: z.array(card).max(6),
  joinIntro: longText(4000),
  joinMembership: longText(2000),
  aboutIntro: longText(6000),
  communityText: longText(6000),
  techPulseIntro: longText(3000),
  thaiPage: longText(20000),
  codeOfConduct: longText(12000),
  privacyNotice: longText(12000),
});

const FIELDS = {
  home: {
    heroTitle: true,
    heroTagline: true,
    mission: true,
    values: true,
    ecosystemHeading: true,
    homeNumbers: true,
    homeCommunityTitle: true,
    homeCommunityText: true,
    homeClosingTitle: true,
    homeAboutItems: true,
    joinPaths: true,
  },
  about: { aboutIntro: true, communityText: true },
  join: { joinIntro: true, joinMembership: true },
  'tech-pulse': { techPulseIntro: true },
  thai: { thaiPage: true },
  legal: { codeOfConduct: true, privacyNotice: true },
} as const;
const PageSchema = Schema.pick(FIELDS[page]);

let errors: Record<string, string> = {};
let values: Record<string, unknown> = { ...current, values: current.values.join('\n') };
let aboutItems = current.homeAboutItems.length ? current.homeAboutItems : DEFAULT_ABOUT_ITEMS;
let joinPaths = current.joinPaths;
let homeNumbers = current.homeNumbers.length ? current.homeNumbers : DEFAULT_HOME_NUMBERS;
// Photo slots on the Home screen: header, About us, three community photos.
const communitySlots = [0, 1, 2].map((i) => `community${i + 1}`);
let photos = {
  hero: current.homeHeroPhoto,
  about: current.homeAboutPhoto,
  community: [0, 1, 2].map((i) => current.homeCommunityPhotos[i] ?? null),
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = formToObject(form, [
    'aboutItemTitle',
    'aboutItemText',
    'joinTitle',
    'joinText',
    'joinLink',
    'numberTitle',
    'numberText',
  ]);
  aboutItems = cardsFromForm(values, 'aboutItem').map(({ title, text }) => ({ title, text }));
  joinPaths = cardsFromForm(values, 'join', true);
  homeNumbers = cardsFromForm(values, 'number').map(({ title, text }) => ({ title, text }));
  const parsed = PageSchema.safeParse({
    ...values,
    homeAboutItems: aboutItems,
    joinPaths,
    homeNumbers,
  });
  if (!parsed.success) errors = fieldErrors(parsed.error);
  const next: Partial<Settings> = parsed.success ? { ...parsed.data } : {};
  if (page === 'home') {
    const upload = parsed.success;
    const slot = async (name: string, cur: Photo | null) => {
      const r = await readPhotoSlot(form, name, cur, { prefix: 'home', upload });
      if (r.error) errors[name] = r.error;
      return r.photo;
    };
    photos = {
      hero: await slot('hero', photos.hero),
      about: await slot('about', photos.about),
      community: [],
    };
    for (const [i, name] of communitySlots.entries())
      photos.community.push(await slot(name, current.homeCommunityPhotos[i] ?? null));
    Object.assign(next, {
      homeHeroPhoto: photos.hero,
      homeAboutPhoto: photos.about,
      homeCommunityPhotos: photos.community,
    });
  }
  if (parsed.success && !Object.keys(errors).length) {
    await saveSettings(next);
    await audit(actor, 'update', 'settings', null, null, Object.keys(next));
    return Astro.redirect(`/admin/site-texts?page=${page}&saved=1`);
  }
}
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
---

<AdminLayout title={PAGES[page]}>
  <p class="-mt-4 mb-6 text-sm text-muted">
    The texts of this page of the public site.{' '}
    <a
      href={
        page === 'home' ? '/' : page === 'legal' ? '/privacy' : `/${page === 'thai' ? 'th' : page}`
      }
    >
      View the page ↗
    </a>
  </p>
  {Object.keys(errors).length > 0 && (
    <Alert tone="danger" class="mb-6">
      Please fix the highlighted fields.
    </Alert>
  )}
  <form method="post" enctype="multipart/form-data" data-warn-unsaved class="grid max-w-3xl gap-6">
    {page === 'home' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Top and About us</h2>
          <FormField
            name="heroTitle"
            label="Small line above the heading"
            required
            maxlength={120}
            value={str('heroTitle')}
            error={errors.heroTitle}
          />
          <FormField
            name="heroTagline"
            label="Main heading"
            required
            rows={2}
            maxlength={300}
            value={str('heroTagline')}
            error={errors.heroTagline}
            hint="Put a word between stars to show it in red, for example: The tech ecosystem connecting *Bangkok* and France."
          />
          <FormField
            name="mission"
            label="Mission"
            rows={3}
            maxlength={2000}
            value={str('mission')}
            error={errors.mission}
            hint="Under the heading, and in the footer. The About us block next to it shows the first paragraph of About > Who we are."
          />
          <FormField
            name="values"
            label="Values"
            rows={4}
            value={str('values')}
            error={errors.values}
            hint="One per line."
          />
          <FormField
            name="ecosystemHeading"
            label="About us heading"
            maxlength={200}
            value={str('ecosystemHeading')}
            error={errors.ecosystemHeading}
            hint="The heading of the About us block, next to its photo and the pillars."
          />
          <CardFields
            prefix="aboutItem"
            legend="About us items"
            items={aboutItems}
            error={errors.homeAboutItems}
            max={4}
            item="item"
            titleLabel="first word (bold)"
            textLabel="Rest"
            textRows={0}
            titleMax={40}
            textMax={80}
            hint="The four lines next to the About us photo, as in the mockup: Connect / talent, Support / entrepreneurs… Their icons follow the order: people, rocket, chart, document."
          />
          <CardFields
            prefix="number"
            legend="Numbers"
            items={homeNumbers}
            error={errors.homeNumbers}
            max={4}
            item="number"
            titleLabel="figure"
            textLabel="Label"
            textRows={0}
            titleMax={20}
            textMax={80}
            hint="The band under About us, up to four, with the people, rocket, handshake and globe icons in that order. Type each figure as it should appear (for example 300+) and what it counts. Empty = the mockup's numbers shown here."
          />
          <FormField
            name="homeCommunityTitle"
            label="Community block heading"
            maxlength={200}
            value={str('homeCommunityTitle')}
            error={errors.homeCommunityTitle}
            hint={`Empty = "${DEFAULT_COMMUNITY_TITLE}".`}
          />
          <FormField
            name="homeCommunityText"
            label="Community block text"
            rows={3}
            maxlength={600}
            value={str('homeCommunityText')}
            error={errors.homeCommunityText}
            hint={`Under the Community heading, next to the photo collage. Empty = "${DEFAULT_COMMUNITY_TEXT}"`}
          />
          <FormField
            name="homeClosingTitle"
            label="Closing band heading"
            maxlength={200}
            value={str('homeClosingTitle')}
            error={errors.homeClosingTitle}
            hint={`The navy band at the bottom, with Join and Contact us. Empty = "${DEFAULT_CLOSING_TITLE}".`}
          />
        </section>
      </>
    )}

    {page === 'home' && (
      <>
        <section class="admin-panel grid gap-4" id="home-photos">
          <h2 class="text-lg">Photos</h2>
          <p class="text-sm text-muted">
            Each photo has its own place on the page. Use your own or licensed photos, at least 1600
            px wide for the main header, 5 MB at most. Elsewhere on the site: the default covers of
            Connect and Talk events are in Settings &gt; Default event covers, organisation logos in
            Ecosystem, and each event or post has its own cover.
          </p>
          <PhotoSlot
            name="hero"
            label="Main header"
            photo={photos.hero}
            defaultSrc={DEFAULT_HERO.src}
            error={errors.hero}
            hint="The big photo at the top, behind the heading (also faint in the red band at the bottom). Its description shows as the small caption on the right. Default: the Bangkok skyline."
          />
          <PhotoSlot
            name="about"
            label="About us"
            photo={photos.about}
            defaultSrc={null}
            error={errors.about}
            hint="The arched photo next to About us. Default: a photo from the latest event recap."
          />
          {communitySlots.map((name, i) => (
            <PhotoSlot
              name={name}
              label={`Community photo ${i + 1}`}
              photo={photos.community[i] ?? null}
              defaultSrc={DEFAULT_COMMUNITY_PHOTOS[i]!.src}
              error={errors[name]}
              hint={
                i === 1
                  ? 'The middle, taller photo of the community block.'
                  : `The ${i === 0 ? 'left' : 'right'} photo of the community block.`
              }
            />
          ))}
        </section>

        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Partners</h2>
          <p class="text-sm text-muted">
            The logos of "They support La French Tech Bangkok" come from the Ecosystem directory:
            tick "Show on Home" on a partner in{' '}
            <a href="/admin/ecosystem?tab=partners">Ecosystem &gt; Partners</a>.
          </p>
        </section>
      </>
    )}

    {page === 'home' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">You can join us</h2>
          <CardFields
            prefix="join"
            legend="Cards"
            items={joinPaths}
            error={errors.joinPaths}
            withLink
            hint="Navy cards on the home and About pages. With a link, the whole card is clickable: a page such as /events or /about#contact, or a full https:// address."
          />
        </section>
      </>
    )}

    {page === 'join' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Texts</h2>
          <MarkdownEditor
            name="joinIntro"
            label="Why join"
            rows={8}
            value={str('joinIntro')}
            error={errors.joinIntro}
            breaks
            uploads={false}
            hint="Top of the /join page, opened by the header's Join the community button. - starts a list item, **bold**. Empty = the default text."
          />
          <MarkdownEditor
            name="joinMembership"
            label="Membership"
            rows={5}
            value={str('joinMembership')}
            error={errors.joinMembership}
            breaks
            uploads={false}
            hint="The Become a member card on /join. Empty = the default text, which changes when individual membership opens in Settings (so leave it empty unless you rewrite it for open sign-up)."
          />
        </section>
      </>
    )}

    {page === 'about' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Texts</h2>
          <MarkdownEditor
            name="aboutIntro"
            label="Who we are"
            rows={12}
            value={str('aboutIntro')}
            error={errors.aboutIntro}
            breaks
            uploads={false}
            hint="Top of the About page. Line breaks are kept; leave an empty line between paragraphs. **bold**, [link text](https://…), - list. Use Preview to check."
          />
          <MarkdownEditor
            name="communityText"
            label="Official French Tech Community"
            rows={10}
            value={str('communityText')}
            error={errors.communityText}
            breaks
            uploads={false}
            hint="Shown next to the official logo on the About page. Start a line with ## for a heading. Empty = hidden."
          />
        </section>
      </>
    )}

    {page === 'tech-pulse' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Texts</h2>
          <MarkdownEditor
            name="techPulseIntro"
            label="Introduction"
            rows={5}
            value={str('techPulseIntro')}
            error={errors.techPulseIntro}
            breaks
            uploads={false}
            hint="Top of the /tech-pulse page. The editions listed below it are the published blog posts with Tech Pulse in their title; the Download button opens each post's first PDF attachment. Empty = the default text."
          />
        </section>
      </>
    )}

    {page === 'thai' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Texts</h2>
          <MarkdownEditor
            name="thaiPage"
            label="Page text, in Thai"
            rows={20}
            value={str('thaiPage') || DEFAULT_THAI_PAGE}
            error={errors.thaiPage}
            breaks
            uploads={false}
            hint="The /th page (ภาษาไทย in the menu). The text before the first ## heading is the introduction; each line starting with ## starts a numbered section, listed at the top of the page. The Contact us buttons open the contact form on About. Empty = the default text."
          />
        </section>
      </>
    )}

    {page === 'legal' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Code of conduct</h2>
          <MarkdownEditor
            name="codeOfConduct"
            label="Code of conduct"
            rows={16}
            value={str('codeOfConduct')}
            error={errors.codeOfConduct}
            uploads={false}
            hint="The /code-of-conduct page, linked in the footer, on event pages and in the registration form. {contactEmail} is replaced by the contact email. Start a line with ## for a heading, - for a list. Empty = the default text."
          />
        </section>
      </>
    )}

    {page === 'legal' && (
      <>
        <section class="admin-panel grid gap-4">
          <h2 class="text-lg">Privacy notice</h2>
          <MarkdownEditor
            name="privacyNotice"
            label="Privacy notice"
            rows={16}
            value={str('privacyNotice')}
            error={errors.privacyNotice}
            uploads={false}
            hint="The /privacy page (Thailand's PDPA), linked in the footer and under every registration form. Keep it true to what the site does: what we collect, why, who sees it, how long we keep it, people's rights. {contactEmail} is replaced by the contact email. Empty = the default text."
          />
        </section>
      </>
    )}

    <div class="sticky bottom-0 z-10 -mx-4 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:mx-0 md:rounded-card md:border md:bg-paper/95">
      <Button type="submit">Save</Button>
    </div>
  </form>
</AdminLayout>
