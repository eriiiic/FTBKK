---
import { and, asc, count, eq, gte, inArray, isNull, sql } from 'drizzle-orm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Alert from '../../components/Alert.astro';
import { usingTestSender } from '../../lib/email';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import { getDb } from '../../db';
import { events, members, organisations, posts, submissions } from '../../db/schema';
import { registrationCount } from '../../lib/registrations';
import { loadContacts } from '../../lib/contacts';
import { moderationQueue } from '../../lib/cron-directory';
import { MODERATION_TARGET_DAYS, ageDays } from '../../lib/lifecycle';
import { formatEventDate } from '../../lib/format';

const db = getDb();
const now = new Date();
const [
  queue,
  upcoming,
  [drafts],
  [unread],
  [listed],
  [renewSoon],
  contacts,
  [active],
  [unreviewed],
] = await Promise.all([
  moderationQueue(),
  db
    .select({
      id: events.id,
      title: events.title,
      startsAt: events.startsAt,
      endsAt: events.endsAt,
      status: events.status,
      capacity: events.capacity,
      registered: registrationCount(['registered', 'attended']),
      waitlist: registrationCount(['waitlist']),
    })
    .from(events)
    .where(gte(events.startsAt, new Date(now.getTime() - 86400_000)))
    .orderBy(asc(events.startsAt))
    .limit(5),
  db.select({ n: count() }).from(posts).where(eq(posts.status, 'draft')),
  db.select({ n: count() }).from(submissions).where(eq(submissions.status, 'new')),
  db.select({ n: count() }).from(organisations).where(eq(organisations.status, 'published')),
  db
    .select({ n: count() })
    .from(organisations)
    .where(
      and(
        inArray(organisations.status, ['published']),
        sql`${organisations.renewalDueAt} < ${Math.floor(now.getTime() / 1000) + 30 * 86400}`,
      ),
    ),
  loadContacts(now),
  db.select({ n: count() }).from(members).where(eq(members.status, 'active')),
  db
    .select({ n: count() })
    .from(members)
    .where(and(eq(members.status, 'active'), isNull(members.reviewedAt))),
]);
const queueAges = [
  ...queue.pendingOrgs.map((o) => o.submittedAt ?? o.updatedAt),
  ...queue.changes.map((c) => c.change.createdAt),
  ...queue.pendingClaims.map((c) => c.claim.createdAt),
  ...queue.applications.map((a) => a.app.createdAt),
].map((d) => ageDays(d, now));
const queueSize = queueAges.length;
const oldest = queueSize ? Math.max(...queueAges) : 0;
const stats = [
  {
    label: 'To review in the directory',
    value: queueSize,
    href: '/admin/ecosystem',
    note: queueSize ? `Oldest: ${oldest} day${oldest === 1 ? '' : 's'}` : 'All clear',
    alert: oldest > MODERATION_TARGET_DAYS,
  },
  { label: 'Unread messages', value: unread!.n, href: '/admin/submissions' },
  { label: 'Draft posts', value: drafts!.n, href: '/admin/posts' },
  {
    label: 'Listed organisations',
    value: listed!.n,
    href: '/admin/ecosystem?tab=all',
    note: `${renewSoon!.n} renewals in the next 30 days`,
  },
  {
    label: 'Members',
    value: active!.n,
    href: '/admin/members',
    note: unreviewed!.n ? `${unreviewed!.n} to review` : 'All reviewed',
  },
  {
    label: 'Contacts',
    value: contacts.length,
    href: '/admin/contacts',
    note: `${contacts.filter((c) => c.attended > 0).length} came to an event`,
  },
];
// The things the team does most, first on the page.
const actions = [
  { label: 'Create an event', href: '/admin/events/new', icon: 'calendar' },
  { label: 'Write a post', href: '/admin/posts/new', icon: 'pencil' },
  { label: 'Email the community', href: '/admin/community-email', icon: 'mail' },
  { label: 'Check in guests', href: '/admin/checkin', icon: 'check' },
  { label: 'Add an organisation', href: '/admin/ecosystem/new', icon: 'building' },
  { label: 'Edit the home page', href: '/admin/site-texts', icon: 'home' },
] as const;
// Same window as the Check-in screen: started in the last day or starts in the next one.
const happeningNow = (startsAt: Date) => Math.abs(startsAt.getTime() - now.getTime()) < 86400_000;
---

<AdminLayout title="Dashboard">
  {usingTestSender() && (
    <Alert tone="warning" class="mb-4">
      Emails only reach the Resend account owner: the sender is still Resend's test address
      (onboarding@resend.dev). Members and attendees get no email until the domain is verified in
      Resend and EMAIL_FROM uses it (see docs/deploy.md).
    </Alert>
  )}
  <section aria-labelledby="quick-actions">
    <h2 id="quick-actions" class="sr-only">
      Quick actions
    </h2>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 2xl:grid-cols-6">
      {actions.map((a) => (
        <li>
          <a
            href={a.href}
            class="flex h-full items-center gap-3 rounded-card border border-line bg-paper p-3 text-sm leading-snug font-semibold md:p-4 md:text-base text-navy no-underline transition-colors hover:border-brand hover:text-brand"
          >
            <span class="grid size-10 shrink-0 md:size-11 place-items-center rounded-full bg-brand/10 text-brand">
              <Icon name={a.icon} class="size-5 md:size-6" />
            </span>
            {a.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="mt-6 grid grid-cols-2 gap-3 md:gap-4 lg:grid-cols-3">
    {stats.map((s) => (
      <a href={s.href} class="admin-panel block no-underline hover:border-accent">
        <p class="text-sm text-muted">{s.label}</p>
        <p class="mt-1 font-display text-2xl font-bold text-navy md:text-3xl">{s.value}</p>
        {s.note && <p class={`mt-1 text-sm ${s.alert ? 'text-danger' : 'text-muted'}`}>{s.note}</p>}
      </a>
    ))}
  </div>

  <section class="admin-panel mt-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg">Upcoming events</h2>
      <a href="/admin/events" class="text-sm font-semibold">
        All events
      </a>
    </div>
    {upcoming.length ? (
      <ul class="mt-4 divide-y divide-line border-t border-line">
        {upcoming.map((e) => (
          <li class="flex flex-wrap items-center gap-x-4 gap-y-2 py-3">
            <div class="min-w-0 flex-1 basis-64">
              <a href={`/admin/events/${e.id}`} class="font-semibold">
                {e.title}
              </a>
              <p class="text-sm text-muted">{formatEventDate(e.startsAt, e.endsAt)}</p>
            </div>
            <p class="text-sm whitespace-nowrap">
              {e.registered}
              {e.capacity ? ` / ${e.capacity}` : ''} registered
              {e.waitlist > 0 && <span class="text-muted"> (+{e.waitlist} waitlist)</span>}
            </p>
            <Badge
              tone={
                e.status === 'published'
                  ? 'success'
                  : e.status === 'cancelled'
                    ? 'danger'
                    : 'neutral'
              }
            >
              {e.status}
            </Badge>
            <p class="flex gap-3 text-sm whitespace-nowrap">
              <a href={`/admin/registrations?event=${e.id}`}>Registrations</a>
              {happeningNow(e.startsAt) && e.status !== 'cancelled' && (
                <a href={`/admin/events/${e.id}/checkin`} class="font-semibold">
                  Check in
                </a>
              )}
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-muted">No upcoming events.</p>
    )}
  </section>
</AdminLayout>
