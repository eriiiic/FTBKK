---
import { and, asc, count, eq, gte, inArray, sql } from 'drizzle-orm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import { getDb } from '../../db';
import { events, organisations, posts, submissions } from '../../db/schema';
import { registrationCount } from '../../lib/registrations';
import { loadContacts } from '../../lib/contacts';
import { moderationQueue } from '../../lib/cron-directory';
import { MODERATION_TARGET_DAYS, ageDays } from '../../lib/lifecycle';
import { formatDate, formatEventDate } from '../../lib/format';
import { loadTeam, openTasks } from '../../lib/ownership';

const db = getDb();
const now = new Date();
const me = Astro.locals.adminEmail?.toLowerCase() ?? '';
const [team, tasks, mine] = await Promise.all([
  loadTeam(),
  openTasks(now),
  me
    ? db
        .select({ n: count() })
        .from(submissions)
        .where(and(eq(submissions.status, 'new'), eq(submissions.assignee, me)))
    : Promise.resolve([{ n: 0 }]),
]);
const myMember = team.find((m) => m.email === me);
const myTasks = tasks.filter((t) => t.owner === me && t.state !== 'later');
const myLater = tasks.filter((t) => t.owner === me && t.state === 'later').length;
const lateAll = tasks.filter((t) => t.state === 'late');
const unowned = tasks.filter((t) => !t.owner && t.state !== 'later').length;
const myMessages = mine[0]?.n ?? 0;
const [queue, upcoming, [drafts], [unread], [listed], [renewSoon], contacts] = await Promise.all([
  moderationQueue(),
  db
    .select({
      id: events.id,
      title: events.title,
      startsAt: events.startsAt,
      endsAt: events.endsAt,
      status: events.status,
      capacity: events.capacity,
      registered: registrationCount(['registered', 'attended']),
      waitlist: registrationCount(['waitlist']),
    })
    .from(events)
    .where(gte(events.startsAt, new Date(now.getTime() - 86400_000)))
    .orderBy(asc(events.startsAt))
    .limit(5),
  db.select({ n: count() }).from(posts).where(eq(posts.status, 'draft')),
  db.select({ n: count() }).from(submissions).where(eq(submissions.status, 'new')),
  db.select({ n: count() }).from(organisations).where(eq(organisations.status, 'published')),
  db
    .select({ n: count() })
    .from(organisations)
    .where(
      and(
        inArray(organisations.status, ['published']),
        sql`${organisations.renewalDueAt} < ${Math.floor(now.getTime() / 1000) + 30 * 86400}`,
      ),
    ),
  loadContacts(now),
]);
const queueAges = [
  ...queue.pendingOrgs.map((o) => o.submittedAt ?? o.updatedAt),
  ...queue.changes.map((c) => c.change.createdAt),
  ...queue.pendingClaims.map((c) => c.claim.createdAt),
  ...queue.applications.map((a) => a.app.createdAt),
].map((d) => ageDays(d, now));
const queueSize = queueAges.length;
const oldest = queueSize ? Math.max(...queueAges) : 0;
const stats = [
  {
    label: 'To review in the directory',
    value: queueSize,
    href: '/admin/ecosystem',
    note: queueSize ? `Oldest: ${oldest} day${oldest === 1 ? '' : 's'}` : 'All clear',
    alert: oldest > MODERATION_TARGET_DAYS,
  },
  { label: 'Unread messages', value: unread!.n, href: '/admin/submissions' },
  { label: 'Draft posts', value: drafts!.n, href: '/admin/posts' },
  {
    label: 'Listed organisations',
    value: listed!.n,
    href: '/admin/ecosystem?tab=all',
    note: `${renewSoon!.n} renewals in the next 30 days`,
  },
  {
    label: 'Contacts',
    value: contacts.length,
    href: '/admin/contacts',
    note: `${contacts.filter((c) => c.attended > 0).length} came to an event`,
  },
];
---

<AdminLayout title="Dashboard">
  <section class="admin-panel mb-6" aria-labelledby="my-tasks">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="my-tasks" class="text-lg">
        My tasks{myMember ? ` · ${myMember.name}` : ''}
      </h2>
      <p class="text-sm text-muted">
        {lateAll.length > 0 && (
          <span class="text-danger">
            {lateAll.length} step{lateAll.length === 1 ? '' : 's'} late across the team ·{' '}
          </span>
        )}
        {unowned > 0 && `${unowned} without an owner this week · `}
        <a href="/admin/team">Team and roles</a>
      </p>
    </div>
    {!myMember && (
      <p class="mt-3 text-sm text-muted">
        {me
          ? `${me} is not in the team yet. Add yourself with your roles in Team and roles to see the steps you own here.`
          : 'Sign in through Cloudflare Access to see your tasks.'}
      </p>
    )}
    {myMember && (
      <>
        {myTasks.length === 0 &&
        myMessages === 0 &&
        !(myMember.roles.includes('directory') && queueSize > 0) ? (
          <p class="mt-3 text-sm text-muted">
            Nothing due this week.
            {myLater > 0 && ` ${myLater} later step${myLater === 1 ? '' : 's'}.`}
          </p>
        ) : (
          <ul class="mt-3 grid gap-2">
            {myTasks.map((t) => (
              <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2 text-sm last:border-0">
                <span>
                  <a href={`/admin/events/${t.eventId}/tasks`}>{t.eventTitle}</a>: {t.title}
                </span>
                <span class={t.state === 'late' ? 'font-semibold text-danger' : 'text-muted'}>
                  {t.state === 'late' ? 'Late, was due ' : 'Due '}
                  {formatDate(t.due, { weekday: 'short', year: undefined })}
                </span>
              </li>
            ))}
            {myMessages > 0 && (
              <li class="text-sm">
                <a href="/admin/submissions?mine=1">
                  {myMessages} message{myMessages === 1 ? '' : 's'} assigned to you
                </a>
              </li>
            )}
            {myMember.roles.includes('directory') && queueSize > 0 && (
              <li class="text-sm">
                <a href="/admin/ecosystem">
                  {queueSize} directory item{queueSize === 1 ? '' : 's'} to review
                </a>
              </li>
            )}
          </ul>
        )}
        {myTasks.length > 0 && myLater > 0 && (
          <p class="mt-2 text-sm text-muted">And {myLater} later.</p>
        )}
      </>
    )}
  </section>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
    {stats.map((s) => (
      <a href={s.href} class="admin-panel block no-underline hover:border-accent">
        <p class="text-sm text-muted">{s.label}</p>
        <p class="mt-1 font-display text-3xl font-bold text-navy">{s.value}</p>
        {s.note && <p class={`mt-1 text-sm ${s.alert ? 'text-danger' : 'text-muted'}`}>{s.note}</p>}
      </a>
    ))}
  </div>

  <section class="admin-panel mt-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg">Upcoming events</h2>
      <Button href="/admin/events/new" size="sm">
        New event
      </Button>
    </div>
    {upcoming.length ? (
      <div class="mt-4 overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Event</th>
              <th>Date</th>
              <th>Registered</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {upcoming.map((e) => (
              <tr>
                <td>
                  <a href={`/admin/events/${e.id}`}>{e.title}</a>
                </td>
                <td class="whitespace-nowrap">{formatEventDate(e.startsAt, e.endsAt)}</td>
                <td>
                  {e.registered}
                  {e.capacity ? ` / ${e.capacity}` : ''}
                  {e.waitlist > 0 && <span class="text-muted"> (+{e.waitlist} waitlist)</span>}
                </td>
                <td>
                  <Badge
                    tone={
                      e.status === 'published'
                        ? 'success'
                        : e.status === 'cancelled'
                          ? 'danger'
                          : 'neutral'
                    }
                  >
                    {e.status}
                  </Badge>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="mt-4 text-muted">No upcoming events.</p>
    )}
  </section>

  <section class="admin-panel mt-6">
    <h2 class="text-lg">Quick actions</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      <Button href="/admin/posts/new" variant="secondary" size="sm">
        Write a post
      </Button>
      <Button href="/admin/events/new" variant="secondary" size="sm">
        Create an event
      </Button>
      <Button href="/admin/ecosystem/new" variant="secondary" size="sm">
        Add an organisation
      </Button>
      <Button href="/admin/site-texts" variant="secondary" size="sm">
        Edit the site texts
      </Button>
    </div>
  </section>
</AdminLayout>
