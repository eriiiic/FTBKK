---
import { asc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import FormField from '../../../components/FormField.astro';
import Button from '../../../components/Button.astro';
import Alert from '../../../components/Alert.astro';
import MarkdownEditor from '../../../components/admin/MarkdownEditor.astro';
import { getDb } from '../../../db';
import {
  categories,
  postCategories,
  posts,
  type Attachment,
  type Post,
  type PostAuthor,
} from '../../../db/schema';
import {
  formAuthors,
  parseAttachments,
  PostSchema,
  toLocalInput,
  uniqueContentSlug,
} from '../../../lib/admin';
import { fieldErrors, formToObject } from '../../../lib/forms';
import { IMAGE_TYPES, storeUpload } from '../../../lib/uploads';
import { audit } from '../../../lib/orgs';
import { mediaUrl, slugify } from '../../../lib/format';
import { authorColumns, moveByline, resolveAuthors } from '../../../lib/byline';
import { postShareItem } from '../../../lib/social';
import ShareImage from '../../../components/admin/ShareImage.astro';
import { autoPostSeo, keywordList, seoOverride } from '../../../lib/seo';

const db = getDb();
const actor = Astro.locals.adminEmail ?? 'admin';
const isNew = Astro.params.id === 'new';
const id = isNew ? null : Number(Astro.params.id);
let post: Post | null = null;
if (id !== null) {
  [post = null] = await db.select().from(posts).where(eq(posts.id, id)).limit(1);
  if (!post) return Astro.redirect('/admin/posts');
}
const allCategories = await db.select().from(categories).orderBy(asc(categories.sortOrder));
let selected = post
  ? (
      await db
        .select({ id: postCategories.categoryId })
        .from(postCategories)
        .where(eq(postCategories.postId, post.id))
    ).map((r) => r.id)
  : [];

let errors: Record<string, string> = {};
let values: Record<string, unknown> = post
  ? { ...post, publishedAt: toLocalInput(post.publishedAt) }
  : { status: 'draft' };
// A byline still typed at the top of the text opens as author rows, and leaves the text.
const moved = post && !post.authors.length ? moveByline(post) : null;
if (moved) values.bodyMd = moved.bodyMd;
let authorRows: PostAuthor[] = post ? (moved?.authors ?? resolveAuthors(post).authors) : [];
let attachmentList: Attachment[] = post?.attachments ?? [];
const categoryNames = (ids: number[]) =>
  allCategories.filter((c) => ids.includes(c.id)).map((c) => c.name);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'delete' && post) {
    await db.delete(posts).where(eq(posts.id, post.id));
    await audit(actor, 'delete', 'post', post.id, { title: post.title, slug: post.slug }, null);
    return Astro.redirect('/admin/posts?saved=deleted');
  }
  values = formToObject(form, [
    'categoryIds',
    'removeAttachment',
    'authorNames',
    'authorRoles',
    'authorUrls',
  ]);
  selected = (values.categoryIds as string[]).map(Number);
  const parsed = PostSchema.safeParse(values);
  if (!parsed.success) errors = fieldErrors(parsed.error);
  const fromForm = formAuthors(
    values.authorNames as string[],
    values.authorRoles as string[],
    values.authorUrls as string[],
  );
  authorRows = fromForm.authors;
  if (fromForm.error) errors.authors = fromForm.error;
  const remove = new Set(values.removeAttachment as string[]);
  attachmentList = (
    parseAttachments(values.attachmentsJson as string | undefined) ??
    post?.attachments ??
    []
  ).filter((a) => !remove.has(a.key));
  const cover = await storeUpload(form.get('cover'), {
    prefix: 'posts',
    maxBytes: 5 * 1024 * 1024,
    types: IMAGE_TYPES,
  });
  if (cover.error) errors.cover = cover.error;
  const seoImage = await storeUpload(form.get('seoImage'), {
    prefix: 'posts',
    maxBytes: 5 * 1024 * 1024,
    types: IMAGE_TYPES,
  });
  if (seoImage.error) errors.seoImage = seoImage.error;
  const added: Attachment[] = [];
  for (const file of form.getAll('attachments')) {
    const up = await storeUpload(file, {
      prefix: 'files',
      maxBytes: 20 * 1024 * 1024,
      types: ['application/pdf'],
    });
    if (up.error) errors.attachments = up.error;
    else if (up.key && file instanceof File)
      added.push({ name: file.name, key: up.key, size: file.size });
  }
  attachmentList = [...attachmentList, ...added];

  if (parsed.success && !Object.keys(errors).length) {
    const d = parsed.data;
    // A byline typed at the top of the text moves to the author list (the page header).
    const byline = moveByline(d);
    if (byline) {
      d.bodyMd = byline.bodyMd;
      if (!authorRows.length) authorRows = byline.authors;
    }
    const slug = await uniqueContentSlug(posts, d.slug || slugify(d.title), post?.id);
    // SEO fields still showing the automatic value are not stored, so they keep following the post.
    const newCatName = String(form.get('newCategory') ?? '').trim();
    const auto = autoPostSeo(d, [...categoryNames(selected), ...(newCatName ? [newCatName] : [])]);
    const row = {
      title: d.title,
      slug,
      excerpt: d.excerpt,
      bodyMd: d.bodyMd,
      authors: authorRows,
      ...authorColumns(authorRows),
      status: d.status,
      publishedAt: d.publishedAt ?? (d.status === 'published' ? new Date() : null),
      coverKey: values.removeCover ? null : (cover.key ?? post?.coverKey ?? null),
      attachments: attachmentList,
      seoTitle: seoOverride(d.seoTitle, auto.title),
      seoDescription: seoOverride(d.seoDescription, auto.description),
      seoKeywords: seoOverride(keywordList(d.seoKeywords).join(', '), auto.keywords),
      seoImageKey: values.removeSeoImage ? null : (seoImage.key ?? post?.seoImageKey ?? null),
      noindex: Boolean(values.noindex),
      updatedAt: new Date(),
    };
    const newCat = String(form.get('newCategory') ?? '').trim();
    if (newCat) {
      const [cat] = await db
        .insert(categories)
        .values({ name: newCat, slug: slugify(newCat), sortOrder: allCategories.length })
        .onConflictDoUpdate({ target: categories.slug, set: { name: newCat } })
        .returning();
      if (cat) selected.push(cat.id);
    }
    let postId = post?.id;
    if (post) {
      await db.update(posts).set(row).where(eq(posts.id, post.id));
    } else {
      [{ id: postId }] = (await db.insert(posts).values(row).returning({ id: posts.id })) as [
        { id: number },
      ];
    }
    await db.delete(postCategories).where(eq(postCategories.postId, postId!));
    const catIds = [...new Set(selected)];
    if (catIds.length) {
      await db
        .insert(postCategories)
        .values(catIds.map((categoryId) => ({ postId: postId!, categoryId })));
    }
    await audit(
      actor,
      post ? 'update' : 'create',
      'post',
      postId!,
      post ? { status: post.status } : null,
      {
        title: row.title,
        status: row.status,
      },
    );
    return Astro.redirect(`/admin/posts/${postId}?saved=1`);
  }
}
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
// SEO fields open filled with the automatic values; an override saved earlier replaces them.
const seoAuto = autoPostSeo(
  { title: str('title'), excerpt: str('excerpt') || null, bodyMd: str('bodyMd') },
  categoryNames(selected),
);
const seo = {
  seoTitle: str('seoTitle') || seoAuto.title,
  seoDescription: str('seoDescription') || seoAuto.description,
  seoKeywords: str('seoKeywords') || seoAuto.keywords,
};
// The share image redraws itself in the browser when the title, byline or cover changed.
const share = post ? await postShareItem(post) : null;
const autoImage = share?.imageUrl ?? (post?.coverKey ? mediaUrl(post.coverKey) : null);
---

<AdminLayout title={isNew ? 'New post' : 'Edit post'}>
  {post && (
    <p class="mb-4 flex flex-wrap gap-4 text-sm">
      {post.status === 'published' && (
        <a href={`/blog/${post.slug}`} target="_blank" rel="noopener">
          View on the site ↗
        </a>
      )}
      <a href={`/admin/social/post/${post.id}`}>Share on social media</a>
    </p>
  )}
  {share && (
    <ShareImage
      spec={share.spec}
      fingerprint={share.fingerprint}
      url={share.imageUrl}
      variant="auto"
    />
  )}
  {Object.keys(errors).length > 0 && (
    <Alert tone="danger" class="mb-6">
      Please fix the highlighted fields.
    </Alert>
  )}
  <form
    method="post"
    enctype="multipart/form-data"
    data-warn-unsaved
    class="grid gap-6 lg:grid-cols-[1fr_20rem]"
  >
    <div class="admin-panel grid content-start gap-4">
      <FormField name="title" label="Title" required value={str('title')} error={errors.title} />
      <FormField
        name="excerpt"
        label="Summary"
        rows={2}
        value={str('excerpt')}
        error={errors.excerpt}
        hint="Shown on cards and in search results. Leave empty to use the start of the text."
      />
      <MarkdownEditor name="bodyMd" label="Text" value={str('bodyMd')} error={errors.bodyMd} />
    </div>

    <div class="grid content-start gap-4">
      <div class="admin-panel grid gap-4">
        <FormField
          name="status"
          label="Status"
          required
          value={str('status')}
          options={[
            { value: 'draft', label: 'Draft (not visible)' },
            { value: 'published', label: 'Published' },
          ]}
        />
        <FormField
          name="publishedAt"
          label="Publication date"
          type="datetime-local"
          value={str('publishedAt')}
          error={errors.publishedAt}
          hint="Bangkok time. A future date schedules the post. Empty = now."
        />
        <div class="flex flex-wrap gap-3">
          <Button type="submit" name="action" value="save">
            Save
          </Button>
          <Button href="/admin/posts" variant="ghost">
            Back
          </Button>
        </div>
      </div>

      <div class="admin-panel grid gap-3" data-attachments>
        <input
          type="hidden"
          name="attachmentsJson"
          value={JSON.stringify(attachmentList)}
          data-attachments-json
        />
        <div>
          <label for="f-attachments" class="block text-sm font-semibold">
            PDF attachments
          </label>
          <span class="block text-xs text-muted">
            Pick one or several PDFs (20 MB max each). They upload right away.
          </span>
          <input
            id="f-attachments"
            name="attachments"
            type="file"
            accept="application/pdf"
            multiple
            class="mt-1 block w-full text-sm"
            data-attachments-upload
          />
          <p class="mt-1 text-sm text-muted" aria-live="polite" data-attachments-status></p>
          {errors.attachments && <p class="mt-1 text-sm text-danger">{errors.attachments}</p>}
        </div>
        <p class="text-xs text-muted">
          Click <strong>Insert</strong> to place a download button where the cursor is in the text.
          To change the button's words, edit the tag after a |, for example{' '}
          <code>{'{{download: report.pdf | Download the full report}}'}</code>.
        </p>
        <ul class="grid gap-2" data-attachments-list>
          {attachmentList.map((a) => (
            <li class="grid gap-2 rounded-lg border border-line p-3 text-sm" data-key={a.key}>
              <a href={mediaUrl(a.key)} target="_blank" class="font-semibold break-all" data-name>
                {a.name}
              </a>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <button type="button" class="font-semibold text-accent" data-insert={a.name}>
                  Insert
                </button>
                <button
                  type="button"
                  class="font-semibold text-accent"
                  data-copy={`{{download: ${a.name}}}`}
                >
                  Copy tag
                </button>
                <label class="flex items-center gap-1 text-muted">
                  <input
                    type="checkbox"
                    name="removeAttachment"
                    value={a.key}
                    class="accent-brand"
                  />
                  Remove on save
                </label>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="admin-panel grid gap-4" data-seo>
        <FormField
          name="slug"
          label="Web address"
          value={str('slug')}
          error={errors.slug}
          hint="/blog/… Leave empty to build it from the title."
        />
        <div class="grid gap-1 border-t border-line pt-4">
          <p class="text-sm font-semibold">Search and social previews</p>
          <p class="text-xs text-muted">
            Filled in automatically from the post. Change a field to override it.
          </p>
        </div>
        {(
          [
            {
              name: 'seoTitle',
              label: 'SEO title',
              auto: seoAuto.title,
              rows: 0,
              hint: 'Shown in Google and on LinkedIn, followed by "| La French Tech Bangkok".',
              max: 60,
            },
            {
              name: 'seoDescription',
              label: 'Meta description',
              auto: seoAuto.description,
              rows: 4,
              hint: 'The text under the title in Google and on social previews.',
              max: 160,
            },
            {
              name: 'seoKeywords',
              label: 'Keywords (tags)',
              auto: seoAuto.keywords,
              rows: 0,
              hint: 'Separated by commas. Automatic: the categories.',
              max: 0,
            },
          ] as const
        ).map((f) => (
          <div class="grid gap-1" data-seo-field data-auto={f.auto}>
            <div class="flex items-baseline justify-between gap-2">
              <label for={`f-${f.name}`} class="text-sm font-semibold text-ink">
                {f.label}
              </label>
              <span class="text-xs text-muted" data-seo-state>
                {seo[f.name] === f.auto ? 'Automatic' : ''}
              </span>
            </div>
            {f.rows ? (
              <textarea
                id={`f-${f.name}`}
                name={f.name}
                rows={f.rows}
                class="admin-input"
                data-max={f.max}
                aria-describedby={`f-${f.name}-hint`}
              >{seo[f.name]}</textarea>
            ) : (
              <input
                id={`f-${f.name}`}
                name={f.name}
                value={seo[f.name]}
                class="admin-input"
                data-max={f.max || undefined}
                aria-describedby={`f-${f.name}-hint`}
              />
            )}
            <p id={`f-${f.name}-hint`} class="text-xs text-muted">
              {f.hint} <span data-seo-count />
            </p>
            {errors[f.name] && <p class="text-sm text-danger">{errors[f.name]}</p>}
            <button
              type="button"
              class="justify-self-start text-xs font-semibold text-accent"
              data-seo-reset
              hidden={seo[f.name] === f.auto}
            >
              Use the automatic value
            </button>
          </div>
        ))}
        <div class="grid gap-2">
          <FormField
            name="seoImage"
            label="Social image"
            type="file"
            accept="image/png,image/jpeg,image/webp"
            error={errors.seoImage}
            hint={
              post?.seoImageKey
                ? 'Chosen by hand. Upload another to replace it. 1200×630 works best.'
                : 'Automatic: the share image above, or the cover. Upload one to override it (1200×630).'
            }
          />
          {(post?.seoImageKey || autoImage) && (
            <img
              src={post?.seoImageKey ? mediaUrl(post.seoImageKey) : autoImage!}
              alt="Image shown when the post is shared"
              class="aspect-[1200/630] w-full rounded-lg object-cover"
            />
          )}
          {post?.seoImageKey && (
            <FormField
              name="removeSeoImage"
              label="Go back to the automatic image"
              type="checkbox"
            />
          )}
        </div>
        <FormField
          name="noindex"
          label="Hide from search engines"
          type="checkbox"
          checked={Boolean(values.noindex)}
          hint="Adds noindex and leaves the post out of the sitemap. Visitors with the link still see it."
        />
      </div>

      <fieldset class="admin-panel" data-authors>
        <legend class="text-sm font-semibold">Authors</legend>
        {moved && (
          <p class="mt-1 text-xs text-accent">
            Taken from the byline typed at the top of the text, which is now removed. Save to keep
            it.
          </p>
        )}
        <div class="mt-2 grid gap-3" data-author-list>
          {(authorRows.length ? authorRows : [{ name: '' } as PostAuthor]).map((a) => (
            <div class="author-row grid gap-2 rounded-lg border border-line p-3">
              <label class="grid gap-1 text-xs font-semibold">
                Name
                <input name="authorNames" value={a.name} class="admin-input" />
              </label>
              <label class="grid gap-1 text-xs font-semibold">
                Role
                <input
                  name="authorRoles"
                  value={a.role ?? ''}
                  placeholder="e.g. Co-president"
                  class="admin-input"
                />
              </label>
              <label class="grid gap-1 text-xs font-semibold">
                Link (LinkedIn)
                <input
                  name="authorUrls"
                  value={a.url ?? ''}
                  placeholder="https://linkedin.com/in/…"
                  class="admin-input"
                />
              </label>
              <button
                type="button"
                class="justify-self-start text-xs font-semibold text-danger"
                data-remove-author
              >
                Remove this author
              </button>
            </div>
          ))}
        </div>
        {errors.authors && <p class="mt-2 text-sm text-danger">{errors.authors}</p>}
        <button type="button" class="mt-3 text-sm font-semibold text-accent" data-add-author>
          + Add an author
        </button>
      </fieldset>

      <fieldset class="admin-panel">
        <legend class="text-sm font-semibold">Categories</legend>
        <div class="mt-2 grid gap-2">
          {allCategories.map((c) => (
            <label class="flex items-center gap-2 text-sm">
              <input
                type="checkbox"
                name="categoryIds"
                value={c.id}
                checked={selected.includes(c.id)}
                class="accent-brand"
              />
              {c.name}
            </label>
          ))}
        </div>
        <div class="mt-3">
          <FormField name="newCategory" label="New category" placeholder="e.g. Startup stories" />
        </div>
      </fieldset>

      <div class="admin-panel grid gap-3">
        <FormField
          name="cover"
          label="Cover image"
          type="file"
          accept="image/png,image/jpeg,image/webp"
          error={errors.cover}
          hint="1600×900 works best. 5 MB max."
        />
        {post?.coverKey && (
          <>
            <img src={mediaUrl(post.coverKey)} alt="Current cover" class="rounded-lg" />
            <FormField name="removeCover" label="Remove the cover" type="checkbox" />
          </>
        )}
      </div>
    </div>
  </form>

  {post && (
    <form method="post" data-confirm="Delete this post for good?" class="mt-8">
      <Button type="submit" name="action" value="delete" variant="ghost" class="text-danger">
        Delete this post
      </Button>
    </form>
  )}
</AdminLayout>

<script>
  import { attachmentTag, mediaPath, type ListedFile } from '../../../lib/attachments-client';

  // ---------- SEO fields: automatic until changed, follow the title and summary ----------
  const seoFields = [...document.querySelectorAll<HTMLElement>('[data-seo-field]')];
  const refresh = (field: HTMLElement) => {
    const input = field.querySelector<HTMLInputElement | HTMLTextAreaElement>('[name]')!;
    const isAuto = input.value.trim() === (field.dataset.auto ?? '');
    field.querySelector('[data-seo-state]')!.textContent = isAuto ? 'Automatic' : 'Edited';
    field.querySelector<HTMLElement>('[data-seo-reset]')!.hidden = isAuto;
    const max = Number(input.dataset.max);
    const count = field.querySelector<HTMLElement>('[data-seo-count]')!;
    count.textContent = max ? `${input.value.length}/${max} characters.` : '';
    count.classList.toggle('text-danger', max > 0 && input.value.length > max);
  };
  // While a field still shows its automatic value, it follows the field it comes from.
  const follow = (name: string, source: string, value: (s: string) => string | null) => {
    const field = seoFields.find((f) => f.querySelector(`[name="${name}"]`));
    const from = document.querySelector<HTMLInputElement>(`[name="${source}"]`);
    if (!field || !from) return;
    from.addEventListener('input', () => {
      const next = value(from.value.trim());
      if (next === null) return;
      const input = field.querySelector<HTMLInputElement>('[name]')!;
      if (input.value.trim() === (field.dataset.auto ?? '')) input.value = next;
      field.dataset.auto = next;
      refresh(field);
    });
  };
  follow('seoTitle', 'title', (s) => s);
  follow('seoDescription', 'excerpt', (s) => {
    const text = s.replace(/\s+/g, ' ');
    return text ? (text.length > 160 ? `${text.slice(0, 159).trimEnd()}…` : text) : null;
  });
  for (const field of seoFields) {
    const input = field.querySelector<HTMLInputElement>('[name]')!;
    input.addEventListener('input', () => refresh(field));
    field.querySelector('[data-seo-reset]')!.addEventListener('click', () => {
      input.value = field.dataset.auto ?? '';
      refresh(field);
      input.focus();
    });
    refresh(field);
  }
  // A field left on its automatic value is sent empty, so it keeps following the post.
  seoFields[0]?.closest('form')?.addEventListener('submit', () => {
    for (const field of seoFields) {
      const input = field.querySelector<HTMLInputElement>('[name]')!;
      if (input.value.trim() === (field.dataset.auto ?? '')) input.value = '';
    }
  });

  // ---------- authors: add and remove rows ----------
  const authorList = document.querySelector<HTMLElement>('[data-author-list]');
  document.querySelector('[data-add-author]')?.addEventListener('click', () => {
    const first = authorList?.querySelector<HTMLElement>('.author-row');
    if (!authorList || !first) return;
    const row = first.cloneNode(true) as HTMLElement;
    row.querySelectorAll('input').forEach((i) => (i.value = ''));
    authorList.appendChild(row);
    row.querySelector('input')?.focus();
  });
  authorList?.addEventListener('click', (e) => {
    const button = (e.target as Element).closest('[data-remove-author]');
    const row = button?.closest<HTMLElement>('.author-row');
    if (!row) return;
    if (authorList.querySelectorAll('.author-row').length > 1) row.remove();
    else row.querySelectorAll('input').forEach((i) => (i.value = ''));
  });

  // ---------- attachments: upload now, insert a download tag in the text ----------
  const panel = document.querySelector<HTMLElement>('[data-attachments]');
  if (panel) {
    const json = panel.querySelector('[data-attachments-json]') as unknown as HTMLInputElement;
    const list = panel.querySelector('[data-attachments-list]') as unknown as HTMLElement;
    const upload = panel.querySelector('[data-attachments-upload]') as unknown as HTMLInputElement;
    const status = panel.querySelector('[data-attachments-status]') as unknown as HTMLElement;
    const editor = document.querySelector<HTMLElement>('[data-md-editor]');
    const files = JSON.parse(json.value || '[]') as ListedFile[];

    const insert = (text: string) =>
      editor?.dispatchEvent(new CustomEvent('md-insert', { detail: text }));

    const button = (label: string, cls: string) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = cls;
      b.textContent = label;
      return b;
    };

    const add = (file: ListedFile) => {
      // Tags find a file by name, so two files never share one.
      const taken = new Set(files.map((f) => f.name.toLowerCase()));
      const [, base, ext] = file.name.match(/^(.*?)(\.[^.]*)?$/) ?? [];
      let name = file.name;
      for (let n = 2; taken.has(name.toLowerCase()); n++) name = `${base} (${n})${ext ?? ''}`;
      const item = { ...file, name };
      files.push(item);
      json.value = JSON.stringify(files);

      const li = document.createElement('li');
      li.className = 'grid gap-2 rounded-lg border border-line p-3 text-sm';
      li.dataset.key = item.key;
      const link = document.createElement('a');
      link.href = mediaPath(item.key);
      link.target = '_blank';
      link.className = 'font-semibold break-all';
      link.textContent = name;
      const actions = document.createElement('div');
      actions.className = 'flex flex-wrap items-center gap-x-3 gap-y-1 text-xs';
      const ins = button('Insert', 'font-semibold text-accent');
      ins.dataset.insert = name;
      const copy = button('Copy tag', 'font-semibold text-accent');
      copy.dataset.copy = attachmentTag(name);
      const remove = document.createElement('label');
      remove.className = 'flex items-center gap-1 text-muted';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.name = 'removeAttachment';
      box.value = item.key;
      box.className = 'accent-brand';
      remove.appendChild(box);
      remove.appendChild(document.createTextNode(' Remove on save'));
      for (const el of [ins, copy, remove]) actions.appendChild(el);
      li.appendChild(link);
      li.appendChild(actions);
      list.appendChild(li);
      return item;
    };

    list.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-insert]');
      if (b) insert(attachmentTag(b.dataset.insert ?? ''));
    });

    // The editor's "Attach PDF" button hands its upload here and inserts the returned tag.
    panel.addEventListener('attachment-added', (e) => {
      const detail = (e as CustomEvent<{ file: ListedFile; name?: string }>).detail;
      detail.name = add(detail.file).name;
    });

    upload.addEventListener('change', async () => {
      const picked = [...(upload.files ?? [])];
      upload.value = '';
      for (const [i, file] of picked.entries()) {
        status.textContent = `Uploading ${file.name} (${i + 1} of ${picked.length})…`;
        const body = new FormData();
        body.append('file', file);
        body.append('kind', 'pdf');
        const res = await fetch('/api/admin/upload', { method: 'POST', body });
        const data = (await res.json()) as { key?: string; error?: string };
        if (!data.key) {
          status.textContent = `${file.name}: ${data.error ?? 'upload failed.'}`;
          return;
        }
        add({ name: file.name, key: data.key, size: file.size });
      }
      status.textContent = `Uploaded. Click Insert to place a file in the text, then Save.`;
    });
  }
</script>
