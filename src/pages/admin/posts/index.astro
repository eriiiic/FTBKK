---
import { desc } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import { getDb } from '../../../db';
import { posts } from '../../../db/schema';
import { formatDate } from '../../../lib/format';

const q = (Astro.url.searchParams.get('q') ?? '').toLowerCase();
const rows = (
  await getDb()
    .select({
      id: posts.id,
      slug: posts.slug,
      title: posts.title,
      status: posts.status,
      publishedAt: posts.publishedAt,
      updatedAt: posts.updatedAt,
    })
    .from(posts)
    .orderBy(desc(posts.updatedAt))
).filter((p) => !q || p.title.toLowerCase().includes(q));
const now = new Date();
---

<AdminLayout title="Posts">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <form method="get" role="search" class="flex gap-2">
      <label for="q" class="sr-only">
        Search posts
      </label>
      <input
        id="q"
        name="q"
        value={q}
        placeholder="Search titles"
        class="rounded-lg border border-line bg-paper px-3 py-1.5"
      />
      <Button type="submit" variant="secondary" size="sm">
        Search
      </Button>
    </form>
    <Button href="/admin/posts/new" size="sm">
      New post
    </Button>
  </div>
  <div class="admin-panel overflow-x-auto">
    {rows.length ? (
      <table class="admin-table" data-sortable>
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Published</th>
            <th>Last edit</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <td data-sort={p.title}>
                <a href={`/admin/posts/${p.id}`} class="font-semibold">
                  {p.title}
                </a>
              </td>
              <td
                data-sort={
                  p.status === 'published' && p.publishedAt && p.publishedAt > now
                    ? 'scheduled'
                    : p.status
                }
              >
                {p.status === 'published' && p.publishedAt && p.publishedAt > now ? (
                  <Badge tone="accent">scheduled</Badge>
                ) : (
                  <Badge tone={p.status === 'published' ? 'success' : 'neutral'}>{p.status}</Badge>
                )}
              </td>
              <td class="whitespace-nowrap" data-sort={p.publishedAt?.getTime() ?? 0}>
                {p.publishedAt ? formatDate(p.publishedAt) : '–'}
              </td>
              <td class="whitespace-nowrap text-muted" data-sort={p.updatedAt.getTime()}>
                {formatDate(p.updatedAt)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="text-muted">No posts yet. Write the first one.</p>
    )}
  </div>
</AdminLayout>
