---
import { env } from 'cloudflare:workers';
import { z } from 'zod';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Alert from '../../components/Alert.astro';
import Button from '../../components/Button.astro';
import { getDb } from '../../db';
import { events, posts } from '../../db/schema';
import { storeUpload } from '../../lib/uploads';
import { audit } from '../../lib/orgs';
import { formatDate, mediaUrl } from '../../lib/format';

// Every PDF or document uploaded to the site: post attachments and event recap slides (files/),
// and the files the Wix import brought over (posts/files/).
// Shows where each one is used; unused ones can be deleted.
const PREFIXES = ['files/', 'posts/files/'];
const actor = Astro.locals.adminEmail ?? 'admin';
const db = getDb();
let message: { tone: 'success' | 'danger'; text: string } | null = null;
const [postRows, eventRows] = await Promise.all([
  db
    .select({
      id: posts.id,
      title: posts.title,
      bodyMd: posts.bodyMd,
      attachments: posts.attachments,
    })
    .from(posts),
  db
    .select({ id: events.id, title: events.title, bodyMd: events.bodyMd, recap: events.recap })
    .from(events),
]);
/** Posts and events that attach or link to a file. */
const usage = (key: string) => {
  const url = mediaUrl(key)!;
  const inText = (md: string) => md.includes(key) || md.includes(url);
  return [
    ...postRows
      .filter((p) => p.attachments.some((a) => a.key === key) || inText(p.bodyMd))
      .map((p) => ({ label: p.title, href: `/admin/posts/${p.id}` })),
    ...eventRows
      .filter((e) => inText(e.bodyMd) || !!e.recap?.slides.some((s) => s.key === key))
      .map((e) => ({ label: e.title, href: `/admin/events/${e.id}` })),
  ];
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (action === 'delete') {
    const key = z
      .string()
      .regex(/^(posts\/)?files\/[^/]+$/)
      .safeParse(form.get('key'));
    if (key.success && usage(key.data).length) {
      message = { tone: 'danger', text: 'This file is still used. Remove it from there first.' };
    } else if (key.success) {
      await env.MEDIA.delete(key.data);
      await audit(actor, 'delete', 'media', null, { key: key.data }, null);
      message = { tone: 'success', text: 'File deleted.' };
    }
  } else if (action === 'upload') {
    let count = 0;
    for (const file of form.getAll('files')) {
      const up = await storeUpload(file, {
        prefix: 'files',
        maxBytes: 20 * 1024 * 1024,
        types: ['application/pdf'],
      });
      if (up.error) message = { tone: 'danger', text: up.error };
      else if (up.key) {
        count++;
        await audit(actor, 'upload', 'media', null, null, { key: up.key });
      }
    }
    if (count && !message) {
      message = {
        tone: 'success',
        text: `Uploaded ${count} ${count === 1 ? 'file' : 'files'}. Copy a link to use it anywhere.`,
      };
    }
  }
}

const objects: R2Object[] = [];
for (const prefix of PREFIXES) {
  let cursor: string | undefined;
  do {
    const page = await env.MEDIA.list({ prefix, cursor, include: ['customMetadata'] });
    objects.push(...page.objects);
    cursor = page.truncated ? page.cursor : undefined;
  } while (cursor);
}

const decode = (s: string) => {
  try {
    return decodeURIComponent(s);
  } catch {
    return s;
  }
};
const files = objects
  .map((o) => {
    const url = mediaUrl(o.key)!;
    const usedIn = usage(o.key);
    const attached = postRows.flatMap((p) => p.attachments).find((a) => a.key === o.key);
    // The name posts use in their download tags, else the name it was uploaded with.
    const name =
      attached?.name ??
      (o.customMetadata?.name ? decode(o.customMetadata.name) : o.key.split('/').pop()!);
    return { key: o.key, name, url, size: o.size, uploaded: o.uploaded, usedIn };
  })
  .sort((a, b) => b.uploaded.getTime() - a.uploaded.getTime());

const formatSize = (bytes: number) =>
  bytes >= 1024 * 1024
    ? `${(bytes / 1024 / 1024).toFixed(1)} MB`
    : `${Math.max(1, Math.round(bytes / 1024))} KB`;
---

<AdminLayout title="PDFs and files">
  {message && (
    <Alert tone={message.tone} class="mb-4">
      {message.text}
    </Alert>
  )}
  <form
    method="post"
    enctype="multipart/form-data"
    class="admin-panel mb-4 flex flex-wrap items-end gap-3"
  >
    <div class="min-w-0 flex-1">
      <label for="f-files" class="block text-sm font-semibold">
        Upload PDFs
      </label>
      <span class="block text-xs text-muted">
        One or several, 20 MB max each. To show one on a post, attach it from the post editor.
      </span>
      <input
        id="f-files"
        name="files"
        type="file"
        accept="application/pdf"
        multiple
        required
        class="mt-1 block w-full text-sm"
      />
    </div>
    <Button type="submit" name="action" value="upload" size="sm">
      Upload
    </Button>
  </form>

  <div class="admin-panel relative overflow-x-auto">
    {files.length ? (
      <table class="admin-table" data-sortable>
        <thead>
          <tr>
            <th>File</th>
            <th>Size</th>
            <th>Uploaded</th>
            <th>Used in</th>
            <th data-nosort>
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {files.map((f) => (
            <tr>
              <td data-sort={f.name.toLowerCase()}>
                <a href={f.url} target="_blank" class="font-semibold break-all">
                  {f.name}
                </a>
              </td>
              <td class="whitespace-nowrap" data-sort={f.size}>
                {formatSize(f.size)}
              </td>
              <td class="whitespace-nowrap text-muted" data-sort={f.uploaded.getTime()}>
                {formatDate(f.uploaded)}
              </td>
              <td data-sort={f.usedIn.length}>
                {f.usedIn.length ? (
                  <ul class="grid gap-1">
                    {f.usedIn.map((u) => (
                      <li>
                        <a href={u.href}>{u.label}</a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <span class="text-muted">Not used</span>
                )}
              </td>
              <td>
                <div class="flex items-center gap-3 whitespace-nowrap">
                  <button
                    type="button"
                    class="text-xs font-semibold text-accent"
                    data-copy={new URL(f.url, Astro.url).href}
                  >
                    Copy link
                  </button>
                  {f.usedIn.length === 0 && (
                    <form method="post" data-confirm={`Delete ${f.name} for good?`}>
                      <input type="hidden" name="key" value={f.key} />
                      <button
                        type="submit"
                        name="action"
                        value="delete"
                        class="text-xs font-semibold text-danger"
                      >
                        Delete
                      </button>
                    </form>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="text-muted">No files uploaded yet.</p>
    )}
  </div>
  <p class="mt-3 text-xs text-muted">
    A file used in a post or event cannot be deleted here: remove it from there first.
  </p>
</AdminLayout>
