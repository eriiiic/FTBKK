---
import { z } from 'zod';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { sendEmail, usingTestSender } from '../../lib/email';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import Alert from '../../components/Alert.astro';
import { getSettings, saveSettings, type Settings } from '../../lib/settings';
import { fieldErrors, formToObject } from '../../lib/forms';
import { adminNotifyEmails, audit, siteUrl } from '../../lib/orgs';
import PhotoSlot from '../../components/admin/PhotoSlot.astro';
import { readPhotoSlot } from '../../lib/photo-slots';
import { CONNECT, DEFAULT_EVENT_COVERS, TALK } from '../../lib/event-covers';

// Site-wide settings. The texts shown on public pages are in Website pages (/admin/site-texts).
const actor = Astro.locals.adminEmail ?? 'admin';
const current = await getSettings();

const lines = (s: string) =>
  s
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean);
const url = z.union([z.literal(''), z.url('Enter a full URL starting with https://')]);
const socials = [
  ['linkedin', 'LinkedIn'],
  ['instagram', 'Instagram'],
  ['facebook', 'Facebook'],
  ['whatsapp', 'WhatsApp group invite link (never shown publicly)'],
  ['youtube', 'YouTube'],
] as const;

const Schema = z.object({
  siteTitle: z.string().min(2).max(100),
  siteDescription: z.string().max(300),
  contactEmail: z.email('Enter a valid email.'),
  moderatorEmails: z
    .string()
    .transform((s) => lines(s.replace(/[,;]/g, '\n')).map((e) => e.toLowerCase()))
    .pipe(z.array(z.email('One of these emails is not valid.')).max(10)),
  instagram: url,
  whatsapp: url,
  facebook: url,
  linkedin: url,
  youtube: url,
  membershipOpen: z.boolean().optional().default(false),
  memberSignupOpen: z.boolean().optional().default(false),
  memberPriority: z.boolean().optional().default(false),
  analyticsToken: z.string().max(100),
});

let errors: Record<string, string> = {};
let values: Record<string, unknown> = {
  ...current,
  ...current.socials,
  moderatorEmails: current.moderatorEmails.join('\n'),
};

// Default covers of Connect and Talk events (R2 keys; null = the built-in image).
let covers = current.eventCovers;
const asPhoto = (key: string | null) => (key ? { key } : null);

// "Send a test" next to Admin notifications: one email to the saved addresses, and Resend's
// answer on screen, so the team can check the whole chain without waiting for a real message.
const notifyTo = await adminNotifyEmails(current);
let testResult: { ok: boolean; error?: string } | null = null;

const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
if (form?.get('intent') === 'test-notify') {
  testResult = await sendEmail({
    to: notifyTo,
    subject: '[Test] Admin notifications from the website',
    paragraphs: [
      'This is a test sent from Admin > Settings. If you can read it, contact form messages, new members, directory requests and the Monday directory summary reach this address too.',
      `Sent by ${actor}.`,
    ],
    action: { label: 'Open the admin', url: siteUrl('/admin') },
  }).catch((e: unknown) => ({ ok: false, error: String(e) }));
  await audit(actor, 'test-notify', 'settings', null, null, { to: notifyTo, ok: testResult.ok });
} else if (form) {
  values = formToObject(form);
  const parsed = Schema.safeParse(values);
  if (!parsed.success) errors = fieldErrors(parsed.error);
  const nextCovers = { ...covers };
  for (const kind of ['connect', 'talk'] as const) {
    const name = `cover-${kind}`;
    const r = await readPhotoSlot(form, name, asPhoto(covers[kind]), {
      prefix: 'events/defaults',
      upload: parsed.success,
    });
    if (r.error) errors[name] = r.error;
    nextCovers[kind] = r.photo?.key ?? null;
  }
  covers = nextCovers;
  if (parsed.success && !Object.keys(errors).length) {
    const { instagram, whatsapp, facebook, linkedin, youtube, ...rest } = parsed.data;
    const next: Partial<Settings> = {
      ...rest,
      socials: { instagram, whatsapp, facebook, linkedin, youtube },
      eventCovers: covers,
    };
    await saveSettings(next);
    await audit(actor, 'update', 'settings', null, null, Object.keys(next));
    return Astro.redirect('/admin/settings?saved=1');
  }
}
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
---

<AdminLayout title="Settings">
  {testResult?.ok && (
    <Alert tone="success" class="mb-6">
      Test sent to {notifyTo.join(', ')}. Resend accepted it; if it isn't in the inbox within a few
      minutes, look in spam, then in Resend under Emails for that address.
    </Alert>
  )}
  {testResult && !testResult.ok && (
    <Alert tone="danger" class="mb-6">
      The test could not be sent to {notifyTo.join(', ')}. Resend said: {testResult.error}
    </Alert>
  )}
  {Object.keys(errors).length > 0 && (
    <Alert tone="danger" class="mb-6">
      Please fix the highlighted fields.
    </Alert>
  )}
  <p class="mb-6 max-w-3xl text-sm text-muted">
    The texts of the home, About, Join and other public pages are under
    <a href="/admin/site-texts">Website pages</a> in the menu.
  </p>
  <form method="post" enctype="multipart/form-data" data-warn-unsaved class="grid max-w-3xl gap-6">
    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Site</h2>
      <FormField
        name="siteTitle"
        label="Site name"
        required
        maxlength={100}
        value={str('siteTitle')}
        error={errors.siteTitle}
      />
      <FormField
        name="siteDescription"
        label="Description for search engines"
        rows={2}
        maxlength={300}
        value={str('siteDescription')}
        error={errors.siteDescription}
      />
      <FormField
        name="contactEmail"
        label="Contact email"
        type="email"
        required
        value={str('contactEmail')}
        error={errors.contactEmail}
        hint="Shown in the footer. Contact form messages are sent here."
      />
      <FormField
        name="moderatorEmails"
        label="Admin notifications"
        rows={3}
        value={str('moderatorEmails')}
        error={errors.moderatorEmails}
        hint="One email per line. They get every email meant for the team: contact form messages, new members, directory requests and claims, and the Monday directory summary. Empty = the contact email."
      />
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <Button type="submit" variant="secondary" size="sm" form="test-notify">
          Send a test
        </Button>
        <span class="text-muted">
          Goes now to {notifyTo.join(', ')} (the saved addresses; save first after a change).
        </span>
      </div>
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Default images for Talks and Connects</h2>
      <p class="text-sm text-muted">
        Events of type {CONNECT} or {TALK} that have no cover of their own show this image on the
        site (events list, event page, home page and link previews). Pick the type on each event.
      </p>
      <PhotoSlot
        name="cover-connect"
        label={CONNECT}
        photo={asPhoto(covers.connect)}
        defaultSrc={DEFAULT_EVENT_COVERS.connect}
        withAlt={false}
        error={errors['cover-connect']}
      />
      <PhotoSlot
        name="cover-talk"
        label={TALK}
        photo={asPhoto(covers.talk)}
        defaultSrc={DEFAULT_EVENT_COVERS.talk}
        withAlt={false}
        error={errors['cover-talk']}
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Social links</h2>
      {socials.map(([k, label]) => (
        <FormField name={k} label={label} value={str(k)} error={errors[k]} placeholder="https://" />
      ))}
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Membership</h2>
      {usingTestSender() && (
        <Alert tone="warning">
          Emails only reach the Resend account owner: the sender is still Resend's test address
          (onboarding@resend.dev). Verify the domain in Resend and set EMAIL_FROM to it (see
          docs/deploy.md) before opening membership, or sign-up and registration emails won't
          arrive.
        </Alert>
      )}
      <FormField
        name="memberSignupOpen"
        label="Open free individual membership (events become members only)"
        type="checkbox"
        checked={!!values.memberSignupOpen}
        hint="Shows the membership form on /join. Every event then asks for membership: members register with just their email, newcomers join for free in the same step. Also turns on the yearly reminders, Invite to join in Contacts and member enrolment at check-in. Keep it off until emails reach everyone (Resend domain verified)."
      />
      <FormField
        name="membershipOpen"
        label="Accept company membership applications"
        type="checkbox"
        checked={!!values.membershipOpen}
        hint="Owners of listed organisations can apply from their update page for the Member badge in the directory. Approve each one in Ecosystem > To review."
      />
      <FormField
        name="memberPriority"
        label="Member priority on events"
        type="checkbox"
        checked={!!values.memberPriority}
        hint="Adds early registration days and reserved seats for members (active individual members and owners of member companies) to each event's settings."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Analytics</h2>
      <FormField
        name="analyticsToken"
        label="Cloudflare Web Analytics token"
        maxlength={100}
        value={str('analyticsToken')}
        error={errors.analyticsToken}
        hint="From Cloudflare dashboard > Analytics & Logs > Web Analytics. Empty = off."
      />
    </section>

    <div class="sticky bottom-0 z-10 -mx-4 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:mx-0 md:rounded-card md:border md:bg-paper/95">
      <Button type="submit">Save settings</Button>
    </div>
  </form>
  <form id="test-notify" method="post" hidden>
    <input type="hidden" name="intent" value="test-notify" />
  </form>
</AdminLayout>
