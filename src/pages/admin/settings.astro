---
import { z } from 'zod';
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import Alert from '../../components/Alert.astro';
import { getSettings, saveSettings, type Settings } from '../../lib/settings';
import { fieldErrors, formToObject } from '../../lib/forms';
import { audit } from '../../lib/orgs';

// Site-wide settings. The texts shown on public pages are in Site texts (/admin/site-texts).
const actor = Astro.locals.adminEmail ?? 'admin';
const current = await getSettings();

const lines = (s: string) =>
  s
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean);
const url = z.union([z.literal(''), z.url('Enter a full URL starting with https://')]);
const socials = [
  ['linkedin', 'LinkedIn'],
  ['instagram', 'Instagram'],
  ['facebook', 'Facebook'],
  ['whatsapp', 'WhatsApp group invite link (never shown publicly)'],
  ['youtube', 'YouTube'],
] as const;

const Schema = z.object({
  siteTitle: z.string().min(2).max(100),
  siteDescription: z.string().max(300),
  contactEmail: z.email('Enter a valid email.'),
  moderatorEmails: z
    .string()
    .transform((s) => lines(s.replace(/[,;]/g, '\n')).map((e) => e.toLowerCase()))
    .pipe(z.array(z.email('One moderator email is not valid.')).max(10)),
  instagram: url,
  whatsapp: url,
  facebook: url,
  linkedin: url,
  youtube: url,
  membershipOpen: z.boolean().optional().default(false),
  memberSignupOpen: z.boolean().optional().default(false),
  memberPriority: z.boolean().optional().default(false),
  analyticsToken: z.string().max(100),
});

let errors: Record<string, string> = {};
let values: Record<string, unknown> = {
  ...current,
  ...current.socials,
  moderatorEmails: current.moderatorEmails.join('\n'),
};

if (Astro.request.method === 'POST') {
  values = formToObject(await Astro.request.formData());
  const parsed = Schema.safeParse(values);
  if (!parsed.success) errors = fieldErrors(parsed.error);
  else {
    const { instagram, whatsapp, facebook, linkedin, youtube, ...rest } = parsed.data;
    const next: Partial<Settings> = {
      ...rest,
      socials: { instagram, whatsapp, facebook, linkedin, youtube },
    };
    await saveSettings(next);
    await audit(actor, 'update', 'settings', null, null, Object.keys(next));
    return Astro.redirect('/admin/settings?saved=1');
  }
}
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
---

<AdminLayout title="Settings">
  {Object.keys(errors).length > 0 && (
    <Alert tone="danger" class="mb-6">
      Please fix the highlighted fields.
    </Alert>
  )}
  <p class="mb-6 max-w-3xl text-sm text-muted">
    The texts of the home, About, Join, code of conduct and privacy pages are in
    <a href="/admin/site-texts">Site texts</a>.
  </p>
  <form method="post" data-warn-unsaved class="grid max-w-3xl gap-6">
    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Site</h2>
      <FormField
        name="siteTitle"
        label="Site name"
        required
        maxlength={100}
        value={str('siteTitle')}
        error={errors.siteTitle}
      />
      <FormField
        name="siteDescription"
        label="Description for search engines"
        rows={2}
        maxlength={300}
        value={str('siteDescription')}
        error={errors.siteDescription}
      />
      <FormField
        name="contactEmail"
        label="Contact email"
        type="email"
        required
        value={str('contactEmail')}
        error={errors.contactEmail}
        hint="Shown in the footer. Contact form messages are sent here."
      />
      <FormField
        name="moderatorEmails"
        label="Directory moderators"
        rows={3}
        value={str('moderatorEmails')}
        error={errors.moderatorEmails}
        hint="One email per line. They get new listing requests, claims and the Monday digest. Empty = the contact email."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Social links</h2>
      {socials.map(([k, label]) => (
        <FormField name={k} label={label} value={str(k)} error={errors[k]} placeholder="https://" />
      ))}
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Membership</h2>
      <FormField
        name="memberSignupOpen"
        label="Open free individual membership on the Join page"
        type="checkbox"
        checked={!!values.memberSignupOpen}
        hint="Shows the membership form on /join and the member page link. Keep it off until emails reach everyone (Resend domain verified)."
      />
      <FormField
        name="membershipOpen"
        label="Accept membership applications"
        type="checkbox"
        checked={!!values.membershipOpen}
        hint="Owners of listed organisations can apply from their update page. The board approves each one."
      />
      <FormField
        name="memberPriority"
        label="Member priority on events"
        type="checkbox"
        checked={!!values.memberPriority}
        hint="Adds early registration days and reserved seats for members to each event's settings."
      />
    </section>

    <section class="admin-panel grid gap-4">
      <h2 class="text-lg">Analytics</h2>
      <FormField
        name="analyticsToken"
        label="Cloudflare Web Analytics token"
        maxlength={100}
        value={str('analyticsToken')}
        error={errors.analyticsToken}
        hint="From Cloudflare dashboard > Analytics & Logs > Web Analytics. Empty = off."
      />
    </section>

    <div class="sticky bottom-0 z-10 -mx-4 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:mx-0 md:rounded-card md:border md:bg-paper/95">
      <Button type="submit">Save settings</Button>
    </div>
  </form>
</AdminLayout>
