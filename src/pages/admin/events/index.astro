---
import { desc, sql } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import { getDb } from '../../../db';
import { eventTasks, events } from '../../../db/schema';
import { registrationCount } from '../../../lib/registrations';
import { formatEventDate } from '../../../lib/format';
import { EVENT_STEPS } from '../../../lib/ownership';

const rows = await getDb()
  .select({
    id: events.id,
    slug: events.slug,
    title: events.title,
    series: events.series,
    startsAt: events.startsAt,
    endsAt: events.endsAt,
    status: events.status,
    capacity: events.capacity,
    registered: registrationCount(['registered', 'attended']),
  })
  .from(events)
  .orderBy(desc(events.startsAt));
// Checklist progress (steps done) per event; events whose checklist was never opened have none.
const progress = new Map(
  (
    await getDb()
      .select({
        eventId: eventTasks.eventId,
        done: sql<number>`sum(case when ${eventTasks.doneAt} is not null then 1 else 0 end)`,
      })
      .from(eventTasks)
      .groupBy(eventTasks.eventId)
  ).map((r) => [r.eventId, r.done]),
);
const now = new Date();
const upcoming = rows.filter((e) => (e.endsAt ?? e.startsAt) >= now).reverse();
const past = rows.filter((e) => (e.endsAt ?? e.startsAt) < now);
const groups = [
  { title: 'Upcoming', rows: upcoming, checklist: true },
  { title: 'Past', rows: past, checklist: false },
];
---

<AdminLayout title="Events">
  <div class="mb-4 flex flex-wrap justify-end gap-2">
    <Button href="/admin/events/stats" size="sm" variant="secondary">
      Event stats
    </Button>
    <Button href="/admin/events/new" size="sm">
      New event
    </Button>
  </div>
  {groups.map((g) => (
    <section class="admin-panel mb-6 overflow-x-auto">
      <h2 class="mb-3 text-lg">{g.title}</h2>
      {g.rows.length ? (
        <table class="admin-table" data-sortable>
          <thead>
            <tr>
              <th>Event</th>
              <th>Date</th>
              <th>Registered</th>
              <th>Status</th>
              {g.checklist && <th>Checklist</th>}
            </tr>
          </thead>
          <tbody>
            {g.rows.map((e) => (
              <tr>
                <td data-sort={e.title}>
                  <a href={`/admin/events/${e.id}`} class="font-semibold">
                    {e.title}
                  </a>
                  <span class="block text-xs text-muted">{e.series}</span>
                </td>
                <td class="whitespace-nowrap" data-sort={e.startsAt.getTime()}>
                  {formatEventDate(e.startsAt, e.endsAt)}
                </td>
                <td data-sort={e.registered}>
                  <a href={`/admin/registrations?event=${e.id}`}>
                    {e.registered}
                    {e.capacity ? ` / ${e.capacity}` : ''}
                  </a>
                </td>
                <td data-sort={e.status}>
                  <Badge
                    tone={
                      e.status === 'published'
                        ? 'success'
                        : e.status === 'cancelled'
                          ? 'danger'
                          : 'neutral'
                    }
                  >
                    {e.status}
                  </Badge>
                </td>
                {g.checklist && (
                  <td data-sort={progress.get(e.id) ?? -1}>
                    <a href={`/admin/events/${e.id}/tasks`}>
                      {progress.has(e.id)
                        ? `${progress.get(e.id)} / ${EVENT_STEPS.length}`
                        : 'Open'}
                    </a>
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="text-muted">None.</p>
      )}
    </section>
  ))}
</AdminLayout>
