<script define:vars={{ maxBytes: MAX_RECAP_UPLOAD_BYTES }}>
  // Recap uploads: refuse a selection too large for one save before sending it.
  const recapForm = document.querySelector('form[data-recap-form]');
  if (recapForm) {
    const inputs = [...recapForm.querySelectorAll('input[type=file]')];
    const checkTotal = () => {
      const total = inputs.flatMap((i) => [...(i.files ?? [])]).reduce((n, f) => n + f.size, 0);
      const msg =
        total > maxBytes
          ? `These files add up to ${Math.round(total / 1048576)} MB. Upload at most ${Math.round(maxBytes / 1048576)} MB of photos and slides per save.`
          : '';
      inputs.forEach((i) => i.setCustomValidity(msg));
    };
    inputs.forEach((i) => i.addEventListener('change', checkTotal));
  }
</script>

<script>
  // Recap photos: the arrows move a photo; the order of the hidden fields is the saved order.
  // Speakers and sponsors use the same arrows.
  document
    .querySelectorAll<HTMLElement>('[data-recap-photos], [data-speakers], [data-sponsors]')
    .forEach((list) => {
      list.addEventListener('click', (e) => {
        const b = (e.target as Element | null)?.closest<HTMLButtonElement>('button[data-move]');
        const item = b?.closest('li');
        if (!b || !item) return;
        const sibling =
          b.dataset.move === '-1' ? item.previousElementSibling : item.nextElementSibling;
        if (!sibling) return;
        if (b.dataset.move === '-1') list.insertBefore(item, sibling);
        else list.insertBefore(sibling, item);
        b.focus();
        list.closest('form')?.dispatchEvent(new Event('input', { bubbles: true }));
      });
    });
</script>
