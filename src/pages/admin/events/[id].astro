---
import { asc, desc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import FormField from '../../../components/FormField.astro';
import Button from '../../../components/Button.astro';
import Alert from '../../../components/Alert.astro';
import MarkdownEditor from '../../../components/admin/MarkdownEditor.astro';
import { getDb } from '../../../db';
import {
  eventSpeakers,
  eventSponsors,
  events,
  organisations,
  people,
  posts,
  type Event,
} from '../../../db/schema';
import { EventSchema, toLocalInput, uniqueContentSlug } from '../../../lib/admin';
import { fieldErrors, formToObject } from '../../../lib/forms';
import { IMAGE_TYPES, storeUpload } from '../../../lib/uploads';
import { audit } from '../../../lib/orgs';
import { mediaUrl, slugify } from '../../../lib/format';
import { getSettings } from '../../../lib/settings';
import { sendEventCancelled } from '../../../lib/registrations';
import {
  MAX_FILES_PER_UPLOAD,
  MAX_RECAP_PHOTOS,
  MAX_RECAP_UPLOAD_BYTES,
  MAX_RECAP_SLIDES,
  RECAP_ARRAYS,
  RecapFormSchema,
  buildRecap,
  labelFromFileName,
  slideRef,
} from '../../../lib/recap';
import {
  MAX_SPEAKERS,
  SPEAKER_ARRAYS,
  SpeakersFormSchema,
  personLine,
  planSpeakers,
} from '../../../lib/speakers';
import {
  MAX_SPONSORS,
  ROLE_NAMES,
  SPONSOR_ARRAYS,
  SPONSOR_ROLES,
  SponsorsFormSchema,
  planSponsors,
  showSponsor,
  type NewSponsor,
} from '../../../lib/sponsors';
import { speakersForEvent, sponsorsForEvent } from '../../../lib/queries';
import { env } from 'cloudflare:workers';

const db = getDb();
const actor = Astro.locals.adminEmail ?? 'admin';
const isNew = Astro.params.id === 'new';
let event: Event | null = null;
if (!isNew) {
  [event = null] = await db
    .select()
    .from(events)
    .where(eq(events.id, Number(Astro.params.id)))
    .limit(1);
  if (!event) return Astro.redirect('/admin/events');
}
const settings = await getSettings();

const asValues = (e: Event): Record<string, unknown> => ({
  ...e,
  startsAt: toLocalInput(e.startsAt),
  endsAt: toLocalInput(e.endsAt),
  registrationOpensAt: toLocalInput(e.registrationOpensAt),
  registrationClosesAt: toLocalInput(e.registrationClosesAt),
});

// "Duplicate" opens a new event prefilled from another one (dates left empty).
const fromId = Number(Astro.url.searchParams.get('from'));
let source: Event | null = null;
if (isNew && fromId) {
  [source = null] = await db.select().from(events).where(eq(events.id, fromId)).limit(1);
}

// Recap (photos, slides, video, blog write-up): its own form, below the event form.
const PHOTO_MAX = 5 * 1024 * 1024;
const SLIDES_MAX = 20 * 1024 * 1024;
const PDF_TYPES = ['application/pdf'];
const writeUps = event
  ? await db
      .select({ id: posts.id, title: posts.title })
      .from(posts)
      .where(eq(posts.status, 'published'))
      .orderBy(desc(posts.publishedAt))
  : [];
let recapErrors: Record<string, string> = {};
let recapValues: Record<string, unknown> = {
  videoUrl: event?.recap?.videoUrl ?? '',
  postId: event?.recap?.postId ?? '',
};

// Speakers: people (any group) linked to the event, with an optional talk title.
const speakers = event ? await speakersForEvent(event.id) : [];
const everyone = event
  ? await db
      .select({
        id: people.id,
        name: people.name,
        title: people.title,
        organisationName: people.organisationName,
        group: people.group,
      })
      .from(people)
      .orderBy(asc(people.name))
  : [];
let speakerErrors: Record<string, string> = {};
let speakerValues: Record<string, unknown> = {};

// Hosts, sponsors and partners: an organisation of the ecosystem directory, or entered by hand.
const sponsors = event ? await sponsorsForEvent(event.id) : [];
const directory = event
  ? await db
      .select({
        id: organisations.id,
        name: organisations.name,
        website: organisations.website,
        status: organisations.status,
      })
      .from(organisations)
      .orderBy(asc(organisations.name))
  : [];
let sponsorErrors: Record<string, string> = {};
let sponsorValues: Record<string, unknown> = {};

let errors: Record<string, string> = {};
let values: Record<string, unknown> = event
  ? asValues(event)
  : source
    ? {
        ...asValues(source),
        title: `${source.title} (copy)`,
        slug: '',
        startsAt: '',
        endsAt: '',
        registrationOpensAt: '',
        registrationClosesAt: '',
        status: 'draft',
      }
    : { status: 'draft', series: 'French Tech Connect', registrationOpen: true };

// Only the recap form can carry this much (other uploads are 5 MB at most). Refuse it before
// buffering the body, which could exceed the Worker's memory.
const bodyTooLarge =
  Astro.request.method === 'POST' &&
  Number(Astro.request.headers.get('content-length')) > MAX_RECAP_UPLOAD_BYTES + 1024 * 1024;
const MB = (n: number) => `${Math.round(n / 1024 / 1024)} MB`;
if (bodyTooLarge) {
  recapErrors.recapPhotos = `Upload at most ${MB(MAX_RECAP_UPLOAD_BYTES)} of photos and slides per save: save them in several goes.`;
} else if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  if (event && action === 'delete') {
    await db.delete(events).where(eq(events.id, event.id));
    await audit(actor, 'delete', 'event', event.id, { title: event.title }, null);
    return Astro.redirect('/admin/events?saved=deleted');
  }
  if (event && action === 'cancel') {
    await db
      .update(events)
      .set({ status: 'cancelled', registrationOpen: false, updatedAt: new Date() })
      .where(eq(events.id, event.id));
    const { results: toNotify } = await env.DB.prepare(
      `SELECT name, email, token FROM registrations
       WHERE event_id = ? AND status IN ('registered', 'waitlist') AND email IS NOT NULL`,
    )
      .bind(event.id)
      .all<{ name: string; email: string; token: string }>();
    await sendEventCancelled(event, toNotify);
    await audit(
      actor,
      'cancel',
      'event',
      event.id,
      { status: event.status },
      { status: 'cancelled' },
    );
    return Astro.redirect(`/admin/events/${event.id}?saved=1`);
  }
  if (event && action === 'sponsors') {
    sponsorValues = formToObject(form, SPONSOR_ARRAYS);
    const parsed = SponsorsFormSchema.safeParse(sponsorValues);
    if (!parsed.success) sponsorErrors = fieldErrors(parsed.error);
    const picked = form.get('addLogo');
    const hasLogo = picked instanceof File && picked.size > 0;
    const org = parsed.success ? directory.find((o) => o.id === parsed.data.addOrgId) : undefined;
    if (parsed.success) {
      const d = parsed.data;
      if (d.addOrgId && !org) sponsorErrors.addOrgId = 'Pick an organisation from the list.';
      if (hasLogo && d.addOrgId)
        sponsorErrors.addLogo =
          'An organisation from the directory uses its own logo: remove this file, or edit the logo in Ecosystem.';
      else if (hasLogo && !d.addName)
        sponsorErrors.addName = 'Enter the name that goes with the logo.';
      const kept = sponsors.filter((s) => !d.sponsorRemove.includes(String(s.id))).length;
      if (kept + (d.addOrgId || d.addName ? 1 : 0) > MAX_SPONSORS)
        sponsorErrors.addOrgId = `An event has at most ${MAX_SPONSORS} hosts, sponsors and partners.`;
    }
    // Upload only once the rest is valid, so a rejected form leaves no orphan file in R2.
    const logo =
      parsed.success && !Object.keys(sponsorErrors).length
        ? await storeUpload(picked, {
            prefix: 'sponsors',
            maxBytes: 2 * 1024 * 1024,
            types: IMAGE_TYPES,
          })
        : {
            key: null,
            error:
              hasLogo && !sponsorErrors.addLogo
                ? 'Choose the logo again after fixing the other fields.'
                : null,
          };
    if (logo.error) sponsorErrors.addLogo = logo.error;
    if (parsed.success && !Object.keys(sponsorErrors).length) {
      const d = parsed.data;
      // A linked organisation's name and website are kept as a fallback if it is ever deleted.
      const added: NewSponsor | null = org
        ? {
            role: d.addRole,
            organisationId: org.id,
            name: org.name,
            url: org.website,
            logoKey: null,
          }
        : d.addName
          ? {
              role: d.addRole,
              organisationId: null,
              name: d.addName,
              url: d.addUrl,
              logoKey: logo.key,
            }
          : null;
      const plan = planSponsors(sponsors, d, added);
      await db.batch([
        db.delete(eventSponsors).where(eq(eventSponsors.eventId, event.id)),
        ...plan.map(({ id, ...s }) =>
          db.insert(eventSponsors).values({ ...s, ...(id ? { id } : {}), eventId: event!.id }),
        ),
      ]);
      const names = new Map(directory.map((o) => [o.id, o.name]));
      const summary = (list: typeof plan) =>
        list.map((s) => ({
          role: s.role,
          name: (s.organisationId && names.get(s.organisationId)) || s.name,
          ...(s.organisationId ? { organisationId: s.organisationId } : { url: s.url }),
        }));
      await audit(
        actor,
        'sponsors',
        'event',
        event.id,
        summary(sponsors.map((s, sortOrder) => ({ ...s, sortOrder }))),
        summary(plan),
      );
      return Astro.redirect(`/admin/events/${event.id}?saved=1#sponsors`);
    }
  } else if (event && action === 'speakers') {
    speakerValues = formToObject(form, SPEAKER_ARRAYS);
    const parsed = SpeakersFormSchema.safeParse(speakerValues);
    if (!parsed.success) speakerErrors = fieldErrors(parsed.error);
    const picked = form.get('newPhoto');
    const hasPhoto = picked instanceof File && picked.size > 0;
    if (parsed.success) {
      const d = parsed.data;
      if (d.addPersonId && !everyone.some((p) => p.id === d.addPersonId))
        speakerErrors.addPersonId = 'Pick someone from the list.';
      if (hasPhoto && !d.newName) speakerErrors.newName = 'Enter the name of the new speaker.';
      const kept = speakers.filter((s) => !d.speakerRemove.includes(String(s.id))).length;
      if (kept + (d.addPersonId || d.newName ? 1 : 0) > MAX_SPEAKERS)
        speakerErrors.addPersonId = `An event has at most ${MAX_SPEAKERS} speakers.`;
    }
    // Upload only once the rest is valid, so a rejected form leaves no orphan file in R2.
    const photo =
      parsed.success && !Object.keys(speakerErrors).length
        ? await storeUpload(picked, {
            prefix: 'people',
            maxBytes: 2 * 1024 * 1024,
            types: IMAGE_TYPES,
          })
        : {
            key: null,
            error: hasPhoto ? 'Choose the photo again after fixing the other fields.' : null,
          };
    if (photo.error) speakerErrors.newPhoto = photo.error;
    if (parsed.success && !Object.keys(speakerErrors).length) {
      const d = parsed.data;
      let added = d.addPersonId;
      if (d.newName) {
        const person = {
          name: d.newName,
          title: d.newTitle,
          organisationName: d.newCompany,
          linkedin: d.newLinkedin,
          group: 'speaker' as const,
        };
        const [ins] = await db
          .insert(people)
          .values({ ...person, photoKey: photo.key })
          .returning({ id: people.id });
        added = ins!.id;
        everyone.push({ id: added, ...person });
        await audit(actor, 'create', 'person', added, null, person);
      }
      const ids = new Set(everyone.map((p) => p.id));
      const plan = planSpeakers(
        speakers.map((s) => ({ personId: s.id, talkTitle: s.talkTitle })),
        d,
        (id) => ids.has(id),
        added,
      );
      await db.batch([
        db.delete(eventSpeakers).where(eq(eventSpeakers.eventId, event.id)),
        ...plan.map((s) => db.insert(eventSpeakers).values({ ...s, eventId: event!.id })),
      ]);
      const summary = (list: { personId: number; talkTitle: string | null }[]) =>
        list.map((s) => ({
          person: everyone.find((p) => p.id === s.personId)?.name ?? s.personId,
          talk: s.talkTitle,
        }));
      await audit(
        actor,
        'speakers',
        'event',
        event.id,
        summary(speakers.map((s) => ({ personId: s.id, talkTitle: s.talkTitle }))),
        summary(plan),
      );
      return Astro.redirect(`/admin/events/${event.id}?saved=1#speakers`);
    }
  } else if (event && action === 'recap') {
    recapValues = formToObject(form, RECAP_ARRAYS);
    const parsed = RecapFormSchema.safeParse(recapValues);
    if (!parsed.success) recapErrors = fieldErrors(parsed.error);
    const files = (name: string) =>
      form.getAll(name).filter((f): f is File => f instanceof File && f.size > 0);
    const photoFiles = files('recapPhotos');
    const slideFiles = files('recapSlides');
    // Check every file before storing any, so a bad one leaves no orphans in R2.
    const check = (list: File[], types: string[], max: number, what: string) => {
      if (list.length > MAX_FILES_PER_UPLOAD)
        return `Upload at most ${MAX_FILES_PER_UPLOAD} ${what} at a time.`;
      const bad = list.find((f) => !types.includes(f.type));
      if (bad) return `${bad.name}: file type not allowed.`;
      const big = list.find((f) => f.size > max);
      if (big) return `${big.name}: file too large (max ${max / 1024 / 1024} MB).`;
    };
    const photoError = check(photoFiles, IMAGE_TYPES, PHOTO_MAX, 'photos');
    if (photoError) recapErrors.recapPhotos = photoError;
    const slideError = check(slideFiles, PDF_TYPES, SLIDES_MAX, 'files');
    if (slideError) recapErrors.recapSlides = slideError;
    const total = [...photoFiles, ...slideFiles].reduce((n, f) => n + f.size, 0);
    if (total > MAX_RECAP_UPLOAD_BYTES && !photoError && !slideError)
      recapErrors.recapPhotos = `These files add up to ${MB(total)}: upload at most ${MB(MAX_RECAP_UPLOAD_BYTES)} of photos and slides per save.`;
    if (parsed.success) {
      const d = parsed.data;
      if (d.postId && !writeUps.some((p) => p.id === d.postId))
        recapErrors.postId = 'Pick a published post.';
      const kept = d.photoKey.filter((k) => !d.photoRemove.includes(k)).length;
      if (kept + photoFiles.length > MAX_RECAP_PHOTOS)
        recapErrors.recapPhotos = `A recap holds at most ${MAX_RECAP_PHOTOS} photos.`;
      const keptSlides = d.slideRef.filter((r) => !d.slideRemove.includes(r)).length;
      if (keptSlides + slideFiles.length + (d.newSlideUrl ? 1 : 0) > MAX_RECAP_SLIDES)
        recapErrors.recapSlides = `A recap holds at most ${MAX_RECAP_SLIDES} slide decks.`;
    }
    // Files are stored only when everything is valid: say so, since the inputs come back empty.
    if (Object.keys(recapErrors).length) {
      if (photoFiles.length && !recapErrors.recapPhotos)
        recapErrors.recapPhotos = 'Choose the photos again after fixing the other fields.';
      if (slideFiles.length && !recapErrors.recapSlides)
        recapErrors.recapSlides = 'Choose the PDFs again after fixing the other fields.';
    }
    if (parsed.success && !Object.keys(recapErrors).length) {
      const uploaded = { photos: [] as string[], slides: [] as { key: string; label: string }[] };
      for (const f of photoFiles) {
        const up = await storeUpload(f, {
          prefix: 'events/recap',
          maxBytes: PHOTO_MAX,
          types: IMAGE_TYPES,
        });
        if (up.key) uploaded.photos.push(up.key);
      }
      // Slides go with the other PDFs, so they show in Files with this event as their use.
      for (const f of slideFiles) {
        const up = await storeUpload(f, {
          prefix: 'files',
          maxBytes: SLIDES_MAX,
          types: PDF_TYPES,
        });
        if (up.key) uploaded.slides.push({ key: up.key, label: labelFromFileName(f.name) });
      }
      const { recap, removedPhotos } = buildRecap(event.recap, parsed.data, uploaded);
      await db.update(events).set({ recap, updatedAt: new Date() }).where(eq(events.id, event.id));
      // Recap photos are only used here, so removing one deletes the file.
      if (removedPhotos.length) await env.MEDIA.delete(removedPhotos);
      const summary = (r: Event['recap']) =>
        r && {
          photos: r.photos.length,
          slides: r.slides.length,
          videoUrl: r.videoUrl ?? null,
          postId: r.postId ?? null,
        };
      await audit(actor, 'recap', 'event', event.id, summary(event.recap), summary(recap));
      return Astro.redirect(`/admin/events/${event.id}?saved=1#recap`);
    }
  } else {
    values = formToObject(form);
    const parsed = EventSchema.safeParse(values);
    if (!parsed.success) errors = fieldErrors(parsed.error);
    // Cancelling goes through "Cancel the event", which tells the people registered.
    if (parsed.success && parsed.data.status === 'cancelled' && event?.status !== 'cancelled')
      errors.status =
        'To cancel, use "Cancel the event" at the bottom: it emails everyone registered.';
    const picked = form.get('cover');
    const hasFile = picked instanceof File && picked.size > 0;
    // Upload only once the rest is valid, so a rejected form leaves no orphan file in R2.
    const cover = Object.keys(errors).length
      ? {
          key: null,
          error: hasFile ? 'Choose the image again after fixing the other fields.' : null,
        }
      : await storeUpload(picked, {
          prefix: 'events',
          maxBytes: 5 * 1024 * 1024,
          types: IMAGE_TYPES,
        });
    if (cover.error) errors.cover = cover.error;
    if (parsed.success && !Object.keys(errors).length) {
      const d = parsed.data;
      const slug = await uniqueContentSlug(events, d.slug || slugify(d.title), event?.id);
      const keepCover = values.removeCover
        ? null
        : (event?.coverKey ?? (source?.coverKey && values.copyCover ? source.coverKey : null));
      const row = { ...d, slug, coverKey: cover.key ?? keepCover, updatedAt: new Date() };
      let eventId = event?.id;
      if (event) {
        await db.update(events).set(row).where(eq(events.id, event.id));
      } else {
        const [ins] = await db.insert(events).values(row).returning({ id: events.id });
        eventId = ins!.id;
      }
      await audit(
        actor,
        event ? 'update' : 'create',
        'event',
        eventId!,
        event ? { status: event.status } : null,
        {
          title: row.title,
          status: row.status,
        },
      );
      return Astro.redirect(`/admin/events/${eventId}?saved=1`);
    }
  }
}
const spstr = (k: string) =>
  sponsorValues[k] === null || sponsorValues[k] === undefined ? '' : String(sponsorValues[k]);
const ORG_STATUS_NOTE: Record<string, string> = {
  published: '',
  unverified: ' (not published yet)',
  pending: ' (pending review)',
  rejected: ' (rejected)',
  expired: ' (expired)',
  hidden: ' (hidden)',
};
const sstr = (k: string) =>
  speakerValues[k] === null || speakerValues[k] === undefined ? '' : String(speakerValues[k]);
const linked = new Set(speakers.map((s) => s.id));
const GROUP_LABELS = {
  board: 'Board',
  institutional: 'Institutional partners',
  speaker: 'Speakers',
};
const rstr = (k: string) =>
  recapValues[k] === null || recapValues[k] === undefined ? '' : String(recapValues[k]);
const recap = event?.recap ?? null;
const eventPast = event ? (event.endsAt ?? event.startsAt) < new Date() : false;
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
const SERIES = ['French Tech Connect', 'Workshop', 'Talk', 'Partner event', 'Other'];
---

<AdminLayout title={isNew ? 'New event' : 'Edit event'}>
  {event && (
    <div class="mb-4 flex flex-wrap gap-4 text-sm">
      {event.status !== 'draft' && (
        <a href={`/events/${event.slug}`} target="_blank" rel="noopener">
          View on the site ↗
        </a>
      )}
      <a href={`/admin/events/${event.id}/tasks`}>Checklist</a>
      <a href={`/admin/registrations?event=${event.id}`}>Registrations</a>
      <a href={`/admin/events/${event.id}/email`}>Email registrants</a>
      {event.startsAt < new Date() && <a href={`/admin/events/${event.id}/feedback`}>Feedback</a>}
      <a href={`/admin/events/new?from=${event.id}`}>Duplicate</a>
    </div>
  )}
  {event?.status === 'cancelled' && (
    <Alert tone="warning" class="mb-6">
      This event is cancelled. It stays visible on the site with a "Cancelled" label.
    </Alert>
  )}
  {Object.keys(errors).length > 0 && (
    <Alert tone="danger" class="mb-6">
      Please fix the highlighted fields.
    </Alert>
  )}
  <form
    method="post"
    enctype="multipart/form-data"
    data-warn-unsaved
    class="grid gap-6 lg:grid-cols-[1fr_20rem]"
  >
    <div class="grid content-start gap-6">
      <div class="admin-panel grid content-start gap-4">
        <FormField name="title" label="Title" required value={str('title')} error={errors.title} />
        <FormField
          name="series"
          label="Type"
          required
          value={str('series')}
          options={SERIES.map((s) => ({ value: s, label: s }))}
        />
        <div class="grid gap-4 sm:grid-cols-2">
          <FormField
            name="startsAt"
            label="Starts"
            type="datetime-local"
            required
            value={str('startsAt')}
            error={errors.startsAt}
            hint="Bangkok time"
          />
          <FormField
            name="endsAt"
            label="Ends"
            type="datetime-local"
            value={str('endsAt')}
            error={errors.endsAt}
          />
        </div>
        <FormField
          name="summary"
          label="Summary"
          rows={2}
          value={str('summary')}
          error={errors.summary}
          hint="One or two sentences for cards and search results."
        />
        <MarkdownEditor name="bodyMd" label="Description" value={str('bodyMd')} rows={12} />
      </div>
      <div class="admin-panel grid gap-4">
        <h2 class="text-lg">Venue</h2>
        <FormField
          name="venue"
          label="Venue name"
          maxlength={200}
          value={str('venue')}
          error={errors.venue}
        />
        <FormField
          name="address"
          label="Address"
          maxlength={1000}
          value={str('address')}
          error={errors.address}
        />
        <FormField
          name="mapUrl"
          label="Map link"
          value={str('mapUrl')}
          error={errors.mapUrl}
          placeholder="https://maps.google.com/…"
        />
      </div>
    </div>

    <div class="grid content-start gap-4">
      <div class="admin-panel grid gap-4">
        <FormField
          name="status"
          label="Status"
          required
          value={str('status')}
          error={errors.status}
          options={[
            { value: 'draft', label: 'Draft (not visible)' },
            { value: 'published', label: 'Published' },
            ...(event?.status === 'cancelled' ? [{ value: 'cancelled', label: 'Cancelled' }] : []),
          ]}
        />
        <FormField
          name="slug"
          label="Web address"
          value={str('slug')}
          hint="/events/… Leave empty to build it from the title."
        />
        <div class="flex flex-wrap gap-3">
          <Button type="submit" name="action" value="save">
            Save
          </Button>
          <Button href="/admin/events" variant="ghost">
            Back
          </Button>
        </div>
      </div>

      <div class="admin-panel grid gap-4">
        <h2 class="text-lg">Registration</h2>
        <FormField
          name="registrationOpen"
          label="Registration open"
          type="checkbox"
          checked={!!values.registrationOpen}
        />
        <FormField
          name="capacity"
          label="Capacity"
          type="number"
          value={str('capacity')}
          error={errors.capacity}
          hint="Empty = unlimited. When full, people join the waitlist."
        />
        <FormField
          name="registrationOpensAt"
          label="Registration opens"
