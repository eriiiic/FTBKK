---
import { asc, eq, inArray, and } from 'drizzle-orm';
import '../../../../styles/global.css';
import { getDb } from '../../../../db';
import { events, registrations } from '../../../../db/schema';
import { normalizeCode, ticketCode } from '../../../../lib/ticket';

// Full-screen, phone-first check-in for the door: search by name, email, phone or ticket code, or
// scan the QR code from the confirmation email. Admin only (guarded in middleware).
const db = getDb();
const [event] = await db
  .select()
  .from(events)
  .where(eq(events.id, Number(Astro.params.id)));
if (!event) return Astro.redirect('/admin/events');
const rows = await Promise.all(
  (
    await db
      .select({
        id: registrations.id,
        name: registrations.name,
        email: registrations.email,
        phone: registrations.phone,
        company: registrations.company,
        status: registrations.status,
        walkIn: registrations.walkIn,
        token: registrations.token,
      })
      .from(registrations)
      .where(
        and(
          eq(registrations.eventId, event.id),
          inArray(registrations.status, ['registered', 'attended', 'waitlist']),
        ),
      )
      .orderBy(asc(registrations.name))
  ).map(async ({ token, ...r }) => ({ ...r, code: normalizeCode(await ticketCode(token)) })),
);
const search = (r: (typeof rows)[number]) =>
  [r.name, r.email, r.company, r.phone, r.phone?.replace(/\D/g, ''), r.code]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Check-in · {event.title}</title>
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-screen bg-surface">
    <header class="sticky top-0 z-10 bg-navy p-4 text-paper">
      <div class="flex items-center justify-between gap-3">
        <a href="/admin/checkin" class="text-sm text-accent-soft">
          {' '}
          ← Events{' '}
        </a>
        <p class="text-sm" aria-live="polite">
          <span data-count>{rows.filter((r) => r.status === 'attended').length}</span> /{' '}
          <span data-total>{rows.length}</span> checked in
        </p>
      </div>
      <h1 class="mt-1 truncate text-lg text-paper">{event.title}</h1>
      <div class="mt-3 flex gap-2">
        <label for="search" class="sr-only">
          Search by name, email, phone or ticket code
        </label>
        <input
          id="search"
          type="search"
          autocomplete="off"
          enterkeyhint="go"
          placeholder="Name, email or code"
          class="min-w-0 flex-1 rounded-xl border-0 bg-paper px-4 py-3 text-lg text-ink"
          autofocus
        />
        <button
          type="button"
          data-scan
          class="shrink-0 rounded-xl bg-brand px-4 py-3 font-semibold text-paper"
        >
          Scan QR
        </button>
      </div>
      <div class="mt-2 flex items-center justify-between gap-3">
        <p class="text-xs text-accent-soft">
          Press Enter to check in when only one person matches. A handheld scanner works too.
        </p>
        <button
          type="button"
          data-walkin-open
          class="shrink-0 rounded-xl border border-paper/40 px-3 py-2 text-sm font-semibold text-paper"
        >
          + Walk-in
        </button>
      </div>
    </header>

    <dialog
      data-walkin
      aria-labelledby="walkin-title"
      class="m-auto w-[min(32rem,calc(100%-1.5rem))] rounded-card bg-paper p-0 text-ink shadow-card backdrop:bg-ink/60"
    >
      <form data-walkin-form class="grid gap-3 p-5">
        <h2 id="walkin-title" class="text-lg">
          Add a walk-in
        </h2>
        <p class="text-sm text-muted">
          For someone who didn't register. They are checked in as soon as you add them.
        </p>
        <label class="grid gap-1 text-sm font-semibold">
          Name
          <input
            name="name"
            required
            minlength="2"
            maxlength="120"
            autocomplete="off"
            class="rounded-xl border border-line px-3 py-3 text-base font-normal"
          />
        </label>
        <label class="grid gap-1 text-sm font-semibold">
          Email <span class="font-normal text-muted">(optional, to invite them next time)</span>
          <input
            name="email"
            type="email"
            inputmode="email"
            maxlength="200"
            autocomplete="off"
            class="rounded-xl border border-line px-3 py-3 text-base font-normal"
          />
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1 text-sm font-semibold">
            Phone <span class="font-normal text-muted">(optional)</span>
            <input
              name="phone"
              type="tel"
              maxlength="40"
              autocomplete="off"
              class="rounded-xl border border-line px-3 py-3 text-base font-normal"
            />
          </label>
          <label class="grid gap-1 text-sm font-semibold">
            Company <span class="font-normal text-muted">(optional)</span>
            <input
              name="company"
              maxlength="120"
              autocomplete="off"
              class="rounded-xl border border-line px-3 py-3 text-base font-normal"
            />
          </label>
        </div>
        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="newsletter" class="mt-1 size-4 accent-brand" />
          <span>
            They want the La French Tech Bangkok newsletter
            <span class="block text-muted">Only tick if they said yes. Needs an email.</span>
          </span>
        </label>
        <p data-walkin-error hidden role="alert" class="text-sm font-semibold text-danger"></p>
        <div class="mt-2 flex justify-end gap-2">
          <button
            type="button"
            data-walkin-cancel
            class="rounded-xl border border-line px-4 py-3 font-semibold"
          >
            Cancel
          </button>
          <button type="submit" class="rounded-xl bg-brand px-4 py-3 font-semibold text-paper">
            Add and check in
          </button>
        </div>
      </form>
    </dialog>

    <div
      data-toast
      hidden
      role="status"
      aria-live="assertive"
      class="fixed inset-x-3 top-3 z-30 rounded-xl p-4 text-center text-lg font-semibold text-paper shadow-card data-[tone=bad]:bg-danger data-[tone=good]:bg-success data-[tone=warn]:bg-navy"
    ></div>

    <div data-scanner hidden class="fixed inset-0 z-20 flex flex-col bg-ink">
      <video data-video playsinline muted class="min-h-0 flex-1 object-cover"></video>
      <div class="flex items-center justify-between gap-3 bg-navy p-4 text-paper">
        <p data-scan-status class="text-sm">
          Point the camera at the ticket's QR code.
        </p>
        <button
          type="button"
          data-scan-close
          class="rounded-xl bg-paper px-4 py-2 font-semibold text-ink"
        >
          Done
        </button>
      </div>
    </div>

    <ul class="grid gap-2 p-3" data-list data-event={event.id}>
      {rows.map((r) => (
        <li>
          <button
            type="button"
            data-id={r.id}
            data-name={r.name}
            data-code={r.code}
            data-status={r.status}
            data-search={search(r)}
            class="flex w-full items-center justify-between gap-3 rounded-xl border border-line bg-paper p-4 text-left data-[status=attended]:border-success data-[status=attended]:bg-success/5"
          >
            <span class="min-w-0">
              <span class="block text-lg font-semibold">{r.name}</span>
              <span class="block truncate text-sm text-muted">
                {[r.company, r.email, r.phone].filter(Boolean).join(' · ') ||
                  (r.walkIn ? 'Walk-in' : '')}
              </span>
            </span>
            <span data-label class="shrink-0 text-sm font-semibold">
              {r.status === 'attended'
                ? '✓ In'
                : r.status === 'waitlist'
                  ? 'Waitlist'
                  : 'Tap to check in'}
            </span>
          </button>
        </li>
      ))}
    </ul>
    <template data-row>
      <li>
        <button
          type="button"
          data-status="attended"
          class="flex w-full items-center justify-between gap-3 rounded-xl border border-line bg-paper p-4 text-left data-[status=attended]:border-success data-[status=attended]:bg-success/5"
        >
          <span class="min-w-0">
            <span data-row-name class="block text-lg font-semibold"></span>
            <span data-row-details class="block truncate text-sm text-muted"></span>
          </span>
          <span data-label class="shrink-0 text-sm font-semibold">
            ✓ In
          </span>
        </button>
      </li>
    </template>
    {rows.length === 0 && (
      <p data-empty class="p-6 text-center text-muted">
        Nobody registered yet.
      </p>
    )}
    <div data-none hidden class="grid justify-items-center gap-3 p-6 text-center text-muted">
      <p>No match.</p>
      <button
        type="button"
        data-walkin-open
        class="rounded-xl bg-navy px-4 py-3 font-semibold text-paper"
      >
        Add as a walk-in
      </button>
    </div>

    <script>
      const list = document.querySelector('[data-list]') as unknown as HTMLElement;
      const eventId = Number(list.dataset.event);
      const count = document.querySelector('[data-count]') as unknown as HTMLElement;
      const search = document.getElementById('search') as unknown as HTMLInputElement;
      const none = document.querySelector('[data-none]') as unknown as HTMLElement;
      const toast = document.querySelector('[data-toast]') as unknown as HTMLElement;
      const total = document.querySelector('[data-total]') as unknown as HTMLElement;
      const buttons = [...list.querySelectorAll<HTMLButtonElement>('button[data-id]')];
      const code = (s: string) =>
        s
          .toUpperCase()
          .replace(/[^0-9A-Z]/g, '')
          .replace(/O/g, '0')
          .replace(/[IL]/g, '1');

      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      const say = (text: string, tone: 'good' | 'bad' | 'warn') => {
        toast.textContent = text;
        toast.dataset.tone = tone;
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => (toast.hidden = true), 2500);
        if (tone !== 'good') navigator.vibrate?.(200);
      };

      const visible = () =>
        buttons.filter((b) => !(b.parentElement as unknown as HTMLElement).hidden);

      const filter = () => {
        const q = search.value.trim().toLowerCase();
        const digits = q.replace(/\D/g, '');
        const c = code(q).toLowerCase();
        for (const b of buttons) {
          const s = b.dataset.search!;
          const hit =
            !q ||
            s.includes(q) ||
            (digits.length >= 4 && s.includes(digits)) ||
            (c.length >= 4 && s.includes(c));
          (b.parentElement as unknown as HTMLElement).hidden = !hit;
        }
        none.hidden = !q || visible().length > 0;
      };
      search.addEventListener('input', filter);

      /**
       * Checks one person in (or undoes it). 'done' = changed here, 'already' = another phone got
       * there first (the server answers 409), 'failed' = try again.
       */
      const toggle = async (b: HTMLButtonElement, undo: boolean) => {
        const label = b.querySelector('[data-label]') as unknown as HTMLElement;
        label.textContent = '…';
        const res = await fetch('/api/admin/checkin', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: Number(b.dataset.id), eventId, undo }),
        }).catch(() => null);
        const result = res?.ok ? 'done' : res?.status === 409 ? 'already' : 'failed';
        if (result !== 'failed') b.dataset.status = undo ? 'registered' : 'attended';
        if (result === 'done')
          count.textContent = String(Number(count.textContent) + (undo ? -1 : 1));
        label.textContent =
          b.dataset.status === 'attended'
            ? '✓ In'
            : result === 'failed'
              ? 'Try again'
              : 'Tap to check in';
        return result;
      };

      const checkIn = async (b: HTMLButtonElement) => {
        const name = b.dataset.name ?? '';
        if (b.dataset.status === 'attended') return say(`${name} is already checked in`, 'warn');
        const wasWaitlist = b.dataset.status === 'waitlist';
        const result = await toggle(b, false);
        if (result === 'failed') return say('Check-in failed. Try again.', 'bad');
        if (result === 'already') say(`${name} is already checked in`, 'warn');
        else
          say(
            `✓ ${name}${wasWaitlist ? ' (was on the waitlist)' : ''}`,
            wasWaitlist ? 'warn' : 'good',
          );
        search.value = '';
        filter();
      };

      list.addEventListener('click', async (e) => {
        const b = (e.target as Element).closest<HTMLButtonElement>('button[data-id]');
        if (!b) return;
        if (b.dataset.status === 'attended') {
          if (confirm(`Undo the check-in of ${b.dataset.name}?`)) await toggle(b, true);
          return;
        }
        await checkIn(b);
        search.focus();
      });

      // ---------- walk-ins ----------
      const dialog = document.querySelector('[data-walkin]') as unknown as HTMLDialogElement;
      const form = document.querySelector('[data-walkin-form]') as unknown as HTMLFormElement;
      const formError = document.querySelector('[data-walkin-error]') as unknown as HTMLElement;
      const rowTemplate = document.querySelector('[data-row]') as unknown as HTMLTemplateElement;
      const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

      for (const open of document.querySelectorAll('[data-walkin-open]')) {
        open.addEventListener('click', () => {
          form.reset();
          formError.hidden = true;
          // Whatever was typed in the search box is usually the name (or the email).
          const q = search.value.trim();
          if (q) field(q.includes('@') ? 'email' : 'name').value = q;
          dialog.showModal();
          field('name').focus();
        });
      }
      document
        .querySelector('[data-walkin-cancel]')
        ?.addEventListener('click', () => dialog.close());

      const addRow = (r: {
        id: number;
        name: string;
        email: string | null;
        phone: string | null;
        company: string | null;
        code: string;
      }) => {
        const li = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const b = li.querySelector('button')!;
        const details = [r.company, r.email, r.phone].filter(Boolean).join(' · ');
        b.dataset.id = String(r.id);
        b.dataset.name = r.name;
        b.dataset.code = r.code;
        b.dataset.search = [
          r.name,
          r.email,
          r.company,
          r.phone,
          r.phone?.replace(/\D/g, ''),
          r.code,
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();
        li.querySelector('[data-row-name]')!.textContent = r.name;
        li.querySelector('[data-row-details]')!.textContent = details || 'Walk-in';
        list.insertBefore(li, list.firstChild);
        buttons.unshift(b);
        document.querySelector('[data-empty]')?.remove();
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        submit.disabled = true;
        formError.hidden = true;
        const res = await fetch('/api/admin/walk-in', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            eventId,
            name: field('name').value,
            email: field('email').value,
            phone: field('phone').value,
            company: field('company').value,
            newsletter: field('newsletter').checked,
          }),
        }).catch(() => null);
        submit.disabled = false;
        const data = (await res?.json().catch(() => null)) as
          (Parameters<typeof addRow>[0] & { existing: boolean; error?: string }) | null;
        if (!res?.ok || !data) {
          // 409: that email is already checked in; show them on the list.
          if (res?.status === 409 && data?.id) {
            dialog.close();
            const b = buttons.find((x) => x.dataset.id === String(data.id));
            if (b && b.dataset.status !== 'attended') {
              b.dataset.status = 'attended';
              b.querySelector('[data-label]')!.textContent = '✓ In';
            }
            say(data.error ?? 'Already checked in', 'warn');
            return;
          }
          formError.textContent =
            data?.error ?? 'Could not add them. Check the connection and try again.';
          formError.hidden = false;
          return;
        }
        dialog.close();
        const listed = buttons.find((x) => x.dataset.id === String(data.id));
        if (listed) {
          // They had registered with that email: the server checked that registration in.
          const wasIn = listed.dataset.status === 'attended';
          listed.dataset.status = 'attended';
          listed.querySelector('[data-label]')!.textContent = '✓ In';
          if (!wasIn) count.textContent = String(Number(count.textContent) + 1);
          say(`✓ ${data.name} had registered: checked in`, 'good');
        } else {
          addRow(data);
          count.textContent = String(Number(count.textContent) + 1);
          total.textContent = String(Number(total.textContent) + 1);
          say(`✓ ${data.name} added and checked in`, 'good');
        }
        search.value = '';
        filter();
        search.focus();
      });

      // Enter (or a handheld scanner, which types the code then Enter) checks in a single match.
      search.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const exact = buttons.find((b) => b.dataset.code === code(search.value));
        const matches = exact ? [exact] : visible();
        if (matches.length === 1) void checkIn(matches[0]!);
        else if (matches.length === 0) say('No match', 'bad');
        else say(`${matches.length} people match: tap the right one`, 'warn');
      });

      // ---------- camera scan ----------
      const scanner = document.querySelector('[data-scanner]') as unknown as HTMLElement;
      const video = document.querySelector('[data-video]') as unknown as HTMLVideoElement;
      const scanStatus = document.querySelector('[data-scan-status]') as unknown as HTMLElement;
      let stream: MediaStream | null = null;
      let running = false;
      let last = { text: '', at: 0 };

      const onCode = async (text: string) => {
        const now = Date.now();
        if (text === last.text && now - last.at < 3000) return;
        last = { text, at: now };
        const b = buttons.find((x) => x.dataset.code === code(text));
        if (!b) return say('Unknown ticket for this event', 'bad');
        await checkIn(b);
      };

      const stop = () => {
        running = false;
        stream?.getTracks().forEach((t) => t.stop());
        stream = null;
        scanner.hidden = true;
        search.focus();
      };

      document.querySelector('[data-scan-close]')?.addEventListener('click', stop);
      document.querySelector('[data-scan]')?.addEventListener('click', async () => {
        try {
          stream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'environment' },
            audio: false,
          });
        } catch {
          return say('Camera not available. Allow camera access, or type the code.', 'bad');
        }
        scanner.hidden = false;
        video.srcObject = stream;
        await video.play();
        running = true;
        type Detector = { detect: (v: HTMLVideoElement) => Promise<{ rawValue: string }[]> };
        const Native = (
          window as unknown as {
            BarcodeDetector?: new (o: { formats: string[] }) => Detector;
          }
        ).BarcodeDetector;
        const native = Native ? new Native({ formats: ['qr_code'] }) : null;
        const jsQR = native ? null : (await import('jsqr')).default;
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        scanStatus.textContent = "Point the camera at the ticket's QR code.";
        const tick = async () => {
          if (!running) return;
          try {
            if (native) {
              const [hit] = await native.detect(video);
              if (hit) await onCode(hit.rawValue);
            } else if (jsQR && ctx && video.videoWidth) {
              const w = 480;
              const h = Math.round((video.videoHeight / video.videoWidth) * w);
              canvas.width = w;
              canvas.height = h;
              ctx.drawImage(video, 0, 0, w, h);
              const hit = jsQR(ctx.getImageData(0, 0, w, h).data, w, h);
              if (hit) await onCode(hit.data);
            }
          } catch {
            /* a frame that fails to decode: try the next one */
          }
          setTimeout(tick, 150);
        };
        void tick();
      });
    </script>
  </body>
</html>
