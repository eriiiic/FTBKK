---
import { desc, eq, sql } from 'drizzle-orm';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import Button from '../../../../components/Button.astro';
import { getDb } from '../../../../db';
import { eventFeedback, events, registrations } from '../../../../db/schema';
import { RATING_LABELS, feedbackSummary, formatRating } from '../../../../lib/feedback';
import { formatDate, formatEventDate } from '../../../../lib/format';

// Day-after feedback for one event: ratings and comments. Names are shown here only; ?anon=1
// hides them, to share the screen or a copy with speakers and sponsors.
// Admin only (guarded in middleware).
const db = getDb();
const [event] = await db
  .select()
  .from(events)
  .where(eq(events.id, Number(Astro.params.id)));
if (!event) return Astro.redirect('/admin/events');
const anon = Astro.url.searchParams.get('anon') === '1';

const [rows, [sent]] = await Promise.all([
  db
    .select({
      rating: eventFeedback.rating,
      comment: eventFeedback.comment,
      updatedAt: eventFeedback.updatedAt,
      name: registrations.name,
      email: registrations.email,
      company: registrations.company,
    })
    .from(eventFeedback)
    .innerJoin(registrations, eq(registrations.id, eventFeedback.registrationId))
    .where(eq(eventFeedback.eventId, event.id))
    .orderBy(desc(eventFeedback.updatedAt)),
  db
    .select({ n: sql<number>`count(*)` })
    .from(registrations)
    .where(
      sql`${registrations.eventId} = ${event.id} and ${registrations.feedbackSentAt} is not null`,
    ),
]);
const s = feedbackSummary(rows);
const emailed = sent?.n ?? 0;
const max = Math.max(1, ...s.distribution);
const withComments = rows.filter((r) => r.comment);
const base = `/admin/events/${event.id}/feedback`;
---

<AdminLayout title={`Feedback: ${event.title}`}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-muted">
      {formatEventDate(event.startsAt, event.endsAt)}
      {' · '}
      <a href={`/admin/events/${event.id}`}>Edit event</a>
      {' · '}
      <a href="/admin/events/stats">Event stats</a>
    </p>
    <div class="flex flex-wrap gap-2">
      <Button href={anon ? base : `${base}?anon=1`} size="sm" variant="ghost">
        {anon ? 'Show names' : 'Hide names (to share)'}
      </Button>
      <Button href={`${base}.csv${anon ? '?anon=1' : ''}`} size="sm" variant="secondary">
        Export feedback CSV
      </Button>
    </div>
  </div>

  <section aria-label="Summary" class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="admin-panel">
      <p class="text-xs text-muted">Average rating</p>
      <p class="mt-1 text-3xl font-bold text-navy">
        {formatRating(s.average)}
        <span class="text-base font-normal text-muted">/ 5</span>
      </p>
    </div>
    <div class="admin-panel">
      <p class="text-xs text-muted">Responses</p>
      <p class="mt-1 text-3xl font-bold text-navy">{s.responses}</p>
      <p class="mt-1 text-xs text-muted">
        {emailed
          ? `${emailed} emailed (${Math.min(100, Math.round((s.responses / emailed) * 100))}% answered)`
          : 'The email goes out at 09:00 the day after the event.'}
      </p>
    </div>
    <div class="admin-panel">
      <p class="text-xs text-muted">Comments</p>
      <p class="mt-1 text-3xl font-bold text-navy">{s.comments}</p>
    </div>
    <figure class="admin-panel">
      <figcaption class="text-xs text-muted">Ratings</figcaption>
      <ul class="mt-2 grid gap-1">
        {[5, 4, 3, 2, 1].map((n) => (
          <li class="grid grid-cols-[1rem_1fr_2rem] items-center gap-2 text-sm">
            <span aria-hidden="true">{n}</span>
            <span class="h-2.5 overflow-hidden rounded-full bg-surface">
              <span
                class="block h-full rounded-full bg-brand"
                style={`width:${((s.distribution[n - 1] ?? 0) / max) * 100}%`}
              />
            </span>
            <span class="text-right font-semibold">
              <span class="sr-only">Rated {n}:</span>
              {s.distribution[n - 1]}
            </span>
          </li>
        ))}
      </ul>
    </figure>
  </section>

  <section class="admin-panel relative overflow-x-auto" aria-labelledby="fb-title">
    <h2 id="fb-title" class="mb-3 text-lg">
      {anon ? 'Comments' : 'Responses'}
    </h2>
    {rows.length === 0 ? (
      <p class="text-sm text-muted">No feedback yet.</p>
    ) : anon ? (
      withComments.length ? (
        <ul class="grid gap-4">
          {withComments.map((r) => (
            <li class="border-l-4 border-line pl-4">
              <p class="text-sm font-semibold text-navy">
                {r.rating} / 5 · {RATING_LABELS[r.rating]}
              </p>
              <p class="mt-1 whitespace-pre-line">{r.comment}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-muted">Ratings only, no comment yet.</p>
      )
    ) : (
      <table class="admin-table" data-sortable>
        <thead>
          <tr>
            <th>Rating</th>
            <th>Comment</th>
            <th>Name</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td data-sort={r.rating} class="font-semibold whitespace-nowrap">
                {r.rating} / 5
              </td>
              <td class="min-w-64 whitespace-pre-line">
                {r.comment ?? <span class="text-muted">–</span>}
              </td>
              <td data-sort={r.name}>
                {r.name}
                {r.company && <span class="block text-xs text-muted">{r.company}</span>}
              </td>
              <td class="whitespace-nowrap" data-sort={r.updatedAt.getTime()}>
                {formatDate(r.updatedAt)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</AdminLayout>
