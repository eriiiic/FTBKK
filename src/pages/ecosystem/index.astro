---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PageHero from '../../components/PageHero.astro';
import OrgCard from '../../components/OrgCard.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { publishedOrganisations } from '../../lib/queries';
import { getPartnerGroups, publicOrg } from '../../lib/orgs';
import { CATEGORIES, CATEGORY_KEYS, SECTORS, STAGES, partnerGroups } from '../../lib/directory';
import { initials, mediaUrl } from '../../lib/format';

const orgs = await publishedOrganisations();
const counts = Object.fromEntries(
  CATEGORY_KEYS.map((k) => [k, orgs.filter((o) => o.category === k).length]),
);
const usedSectors = SECTORS.filter((s) => orgs.some((o) => o.sectors.includes(s)));
const usedStages = STAGES.filter((s) => orgs.some((o) => o.stage === s));
const data = orgs.map(publicOrg);
// Partners of La French Tech Bangkok, by group (Admin > Ecosystem > Partners).
const partners = partnerGroups(orgs, await getPartnerGroups());
const select =
  'mt-1 block w-full rounded-lg border border-line bg-paper px-3 py-2 text-sm focus:border-accent';
---

<BaseLayout
  title="Ecosystem directory"
  description="The open map of French tech in Thailand: startups, companies, service providers, investors, incubators, schools and institutions."
>
  <PageHero
    eyebrow="French tech in Thailand"
    title="Ecosystem directory"
    intro={`The open map of French tech in Thailand. ${orgs.length} organisations, each one reconfirmed every year.`}
  >
    <Button href="/ecosystem/submit" slot="actions">
      Get listed <Icon name="arrow" class="size-4" />
    </Button>
  </PageHero>
  {partners.length > 0 && (
    <Section
      id="partners"
      tone="surface"
      eyebrow="Our partners"
      title="They support La French Tech Bangkok"
      intro="Institutions, companies, investors and places that help us connect French tech in Thailand."
      class="scroll-mt-16"
    >
      <div class="grid gap-8">
        {partners.map((g) => (
          <section
            aria-labelledby={`partners-${g.key}`}
            class="grid gap-4 border-t border-line pt-6 lg:grid-cols-[16rem_1fr] lg:gap-8"
          >
            <div>
              <h3 id={`partners-${g.key}`} class="text-lg">
                {g.label}
              </h3>
              <p class="mt-1 text-sm text-muted">{g.blurb}</p>
            </div>
            <ul class="flex flex-wrap gap-3">
              {g.items.map((o) => (
                <li>
                  <a
                    href={`/ecosystem/${o.slug}`}
                    title={o.name}
                    class="flex h-20 w-36 items-center justify-center rounded-lg border border-line bg-paper p-3 text-center text-sm leading-tight font-semibold text-navy no-underline transition-colors hover:border-navy"
                  >
                    {o.logoKey ? (
                      <img
                        src={mediaUrl(o.logoKey)}
                        alt={o.name}
                        loading="lazy"
                        class="max-h-14 max-w-full object-contain"
                      />
                    ) : (
                      <span>{o.name}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <div class="mt-10 flex flex-col items-start gap-4 rounded-card bg-navy p-6 text-paper md:flex-row md:items-center md:justify-between md:p-8">
        <div>
          <h3 class="text-xl text-paper">Become a partner</h3>
          <p class="mt-1 max-w-2xl text-accent-soft">
            Meet the French tech community in Thailand, host or sponsor an event, find talent and
            clients. Tell us what you have in mind.
          </p>
        </div>
        <Button href="/about?topic=partnership#contact" variant="light">
          Talk to us <Icon name="arrow" class="size-4" />
        </Button>
      </div>
    </Section>
  )}
  <Section>
    <h2 class="mb-6 text-2xl md:text-3xl">All organisations</h2>
    <ul class="flex flex-wrap gap-2" aria-label="Organisations by category">
      {CATEGORY_KEYS.filter((k) => counts[k]).map((k) => (
        <li>
          <a href={`/ecosystem?category=${k}`} data-category-link={k} class="chip">
            <span class="text-brand">{counts[k]}</span> {CATEGORIES[k].label}
          </a>
        </li>
      ))}
    </ul>

    <form
      id="dir-filters"
      class="mt-8 grid gap-4 rounded-card bg-surface p-4 md:grid-cols-6"
      role="search"
    >
      <div class="md:col-span-2">
        <label for="q" class="text-sm font-semibold">
          Search
        </label>
        <div class="relative">
          <input
            id="q"
            name="q"
            type="search"
            placeholder="Name or keyword"
            class={`${select} pl-9`}
          />
          <Icon
            name="search"
            class="pointer-events-none absolute top-1/2 left-3 mt-0.5 size-4 -translate-y-1/2 text-muted"
          />
        </div>
      </div>
      <div>
        <label for="category" class="text-sm font-semibold">
          Category
        </label>
        <select id="category" name="category" class={select}>
          <option value="">All</option>
          {CATEGORY_KEYS.map((k) => (
            <option value={k}>{CATEGORIES[k].label}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="sector" class="text-sm font-semibold">
          Sector
        </label>
        <select id="sector" name="sector" class={select}>
          <option value="">All</option>
          {usedSectors.map((s) => (
            <option value={s}>{s}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="stage" class="text-sm font-semibold">
          Stage
        </label>
        <select id="stage" name="stage" class={select}>
          <option value="">All</option>
          {usedStages.map((s) => (
            <option value={s}>{s}</option>
          ))}
        </select>
      </div>
      <fieldset class="flex flex-wrap items-end gap-x-4 gap-y-1 text-sm">
        <legend class="sr-only">Flags</legend>
        <label class="flex items-center gap-1.5">
          <input type="checkbox" name="partner" class="accent-brand" /> Partner
        </label>
        <label class="flex items-center gap-1.5">
          <input type="checkbox" name="member" class="accent-brand" /> Member
        </label>
        <label class="flex items-center gap-1.5">
          <input type="checkbox" name="hiring" class="accent-brand" /> Hiring
        </label>
        <label class="flex items-center gap-1.5">
          <input type="checkbox" name="raising" class="accent-brand" /> Raising
        </label>
      </fieldset>
      <noscript>
        <button class="text-sm font-semibold text-accent">Apply</button>
      </noscript>
    </form>

    <div class="mt-6 flex items-center justify-between gap-4">
      <p id="dir-count" class="text-sm text-muted" aria-live="polite">
        {orgs.length} organisations
      </p>
      <div
        class="inline-flex rounded-full border border-line p-1 text-sm"
        role="group"
        aria-label="View"
      >
        <button
          type="button"
          data-view="grid"
          aria-pressed="true"
          class="rounded-full px-3 py-1 aria-pressed:bg-navy aria-pressed:text-paper"
        >
          Grid
        </button>
        <button
          type="button"
          data-view="landscape"
          aria-pressed="false"
          class="rounded-full px-3 py-1 aria-pressed:bg-navy aria-pressed:text-paper"
        >
          Landscape
        </button>
      </div>
    </div>

    <div id="dir-grid" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {orgs.map((o) => (
        <div data-slug={o.slug} class="min-w-0">
          <OrgCard org={o} />
        </div>
      ))}
    </div>
    <p id="dir-empty" class="mt-6 hidden text-muted">
      No organisation matches these filters.
    </p>

    <div id="dir-landscape" class="mt-6 hidden space-y-6">
      {CATEGORY_KEYS.filter((k) => counts[k]).map((k) => (
        <section data-landscape={k} class="rounded-card border border-line p-4">
          <h2 class="mb-3 text-base">{CATEGORIES[k].label}</h2>
          <ul class="flex flex-wrap gap-3">
            {orgs
              .filter((o) => o.category === k)
              .map((o) => (
                <li data-slug={o.slug}>
                  <a
                    href={`/ecosystem/${o.slug}`}
                    title={o.name}
                    class="flex h-16 w-28 items-center justify-center rounded-lg border border-line bg-paper p-2 text-center text-xs font-semibold text-navy no-underline hover:border-navy"
                  >
                    {o.logoKey ? (
                      <img
                        src={mediaUrl(o.logoKey)}
                        alt={o.name}
                        loading="lazy"
                        class="max-h-12 max-w-full object-contain"
                      />
                    ) : (
                      <span>{o.name.length > 24 ? initials(o.name) : o.name}</span>
                    )}
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </div>
  </Section>
  <script id="dir-data" type="application/json" set:html={JSON.stringify(data)} />
</BaseLayout>

<script>
  interface Org {
    slug: string;
    name: string;
    pitch: string | null;
    category: string;
    sectors: string[];
    stage: string | null;
    hiring: boolean;
    raising: boolean;
    member: boolean;
    partner: boolean;
  }
  const data: Org[] = JSON.parse(document.getElementById('dir-data')!.textContent || '[]');
  const form = document.getElementById('dir-filters') as HTMLFormElement;
  const grid = document.getElementById('dir-grid')!;
  const landscape = document.getElementById('dir-landscape')!;
  const count = document.getElementById('dir-count')!;
  const empty = document.getElementById('dir-empty')!;
  const keys = [
    'q',
    'category',
    'sector',
    'stage',
    'partner',
    'member',
    'hiring',
    'raising',
  ] as const;
  let view = 'grid';

  function readUrl() {
    const p = new URLSearchParams(location.search);
    for (const k of keys) {
      const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
      if (!el) continue;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = p.get(k) === '1';
      else el.value = p.get(k) ?? '';
    }
    view = p.get('view') === 'landscape' ? 'landscape' : 'grid';
  }

  function state() {
    const fd = new FormData(form);
    return {
      q: String(fd.get('q') ?? '')
        .trim()
        .toLowerCase(),
      category: String(fd.get('category') ?? ''),
      sector: String(fd.get('sector') ?? ''),
      stage: String(fd.get('stage') ?? ''),
      partner: fd.has('partner'),
      member: fd.has('member'),
      hiring: fd.has('hiring'),
      raising: fd.has('raising'),
    };
  }

  function apply(push = true) {
    const s = state();
    const visible = new Set(
      data
        .filter(
          (o) =>
            (!s.q ||
              `${o.name} ${o.pitch ?? ''} ${o.sectors.join(' ')}`.toLowerCase().includes(s.q)) &&
            (!s.category || o.category === s.category) &&
            (!s.sector || o.sectors.includes(s.sector)) &&
            (!s.stage || o.stage === s.stage) &&
            (!s.partner || o.partner) &&
            (!s.member || o.member) &&
            (!s.hiring || o.hiring) &&
            (!s.raising || o.raising),
        )
        .map((o) => o.slug),
    );
    document.querySelectorAll<HTMLElement>('[data-slug]').forEach((el) => {
      el.hidden = !visible.has(el.dataset.slug!);
    });
    document.querySelectorAll<HTMLElement>('[data-landscape]').forEach((sec) => {
      sec.hidden = !sec.querySelector('[data-slug]:not([hidden])');
    });
    count.textContent = `${visible.size} organisation${visible.size === 1 ? '' : 's'}`;
    empty.classList.toggle('hidden', visible.size > 0);
    grid.classList.toggle('hidden', view !== 'grid');
    landscape.classList.toggle('hidden', view !== 'landscape');
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.view === view));
    });
    if (push) {
      const p = new URLSearchParams();
      for (const [k, v] of Object.entries(s)) {
        if (v === true) p.set(k, '1');
        else if (v) p.set(k, String(v));
      }
      if (view === 'landscape') p.set('view', 'landscape');
      history.replaceState(null, '', `${location.pathname}${p.size ? `?${p}` : ''}`);
    }
  }

  readUrl();
  apply(false);
  form.addEventListener('input', () => apply());
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    apply();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) =>
    b.addEventListener('click', () => {
      view = b.dataset.view!;
      apply();
    }),
  );
  document.querySelectorAll<HTMLAnchorElement>('[data-category-link]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      (document.getElementById('category') as unknown as HTMLSelectElement).value =
        a.dataset.categoryLink!;
      apply();
    }),
  );
</script>
