---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PersonCard from '../components/PersonCard.astro';
import { getSettings } from '../lib/settings';
import { hostedSpeakers, peopleByGroup } from '../lib/queries';
import { HOSTED_SPEAKERS_LIMIT } from '../lib/speakers';
import JoinUs from '../components/JoinUs.astro';
import ContactForm from '../components/ContactForm.astro';
import { handleContactForm, topicFromQuery, type ContactResult } from '../lib/contact';
import { renderMarkdown } from '../lib/markdown';

const settings = await getSettings();
const [board, institutional, speakers] = await Promise.all([
  peopleByGroup('board'),
  peopleByGroup('institutional'),
  hostedSpeakers(HOSTED_SPEAKERS_LIMIT),
]);
// Sections after "Join us" alternate backgrounds, whichever of them have content.
const shown = [board.length > 0, speakers.length > 0, institutional.length > 0, true];
let n = 0;
const tones = shown.map((on) => (on && n++ % 2 === 1 ? 'surface' : 'paper') as 'paper' | 'surface');
const [boardTone, speakersTone, institutionalTone, contactTone] = tones;
const intro = renderMarkdown(settings.aboutIntro, { breaks: true });
const community = renderMarkdown(settings.communityText, { breaks: true });

let contact: ContactResult = { errors: {}, values: {}, sent: false };
const isPost = Astro.request.method === 'POST';
if (isPost)
  contact = await handleContactForm(
    Astro.request,
    await Astro.request.formData(),
    settings,
    'About',
  );
---

<BaseLayout
  title="About"
  description="La French Tech Bangkok is a volunteer-run community connecting French and Thai tech entrepreneurs since 2019."
  cache={!isPost}
>
  <section class="bg-navy text-paper">
    <div class="container-page py-16 md:py-24">
      <p class="mb-4 text-sm font-semibold tracking-widest text-accent-soft uppercase">About us</p>
      <h1 class="text-4xl text-paper uppercase md:text-5xl">Who we are</h1>
      {intro && (
        <div
          class="prose prose-lg mt-8 max-w-3xl prose-invert prose-p:text-paper/90 prose-a:text-paper"
          set:html={intro}
        />
      )}
    </div>
  </section>

  {community && (
    <Section id="french-tech">
      <div class="grid items-start gap-8 md:grid-cols-[auto_1fr] md:gap-12">
        <img
          src="/brand/logo.jpg"
          alt="La French Tech Bangkok, official French Tech Community logo"
          width="200"
          height="200"
          loading="lazy"
          class="w-36 md:w-44"
        />
        <div class="prose max-w-3xl prose-headings:font-display" set:html={community} />
      </div>
    </Section>
  )}

  <JoinUs id="join" paths={settings.joinPaths} />

  {board.length > 0 && (
    <Section tone={boardTone} title="Meet the board">
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        {board.map((p) => (
          <PersonCard person={{ ...p, organisation: p.organisationName }} />
        ))}
      </div>
    </Section>
  )}

  {speakers.length > 0 && (
    <Section
      tone={speakersTone}
      title="Speakers we've hosted"
      intro="Founders, investors and experts who shared what they know at our events."
    >
      <ul class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        {speakers.map((p) => (
          <li>
            <PersonCard person={{ ...p, organisation: p.organisationName }}>
              <a href={`/events/${p.eventSlug}`} class="mt-2 text-sm text-accent underline">
                <span class="sr-only">Spoke at </span>
                {p.eventTitle}
              </a>
            </PersonCard>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {institutional.length > 0 && (
    <Section tone={institutionalTone} title="Our institutional partners">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-3">
        {institutional.map((p) => (
          <PersonCard person={{ ...p, organisation: p.organisationName }} />
        ))}
      </div>
    </Section>
  )}

  <Section
    id="contact"
    tone={contactTone}
    title="Contact us"
    intro={`Or write to ${settings.contactEmail}.`}
  >
    <div class="max-w-2xl">
      <ContactForm
        action="/about#contact"
        {...contact}
        topic={topicFromQuery(Astro.url.searchParams.get('topic'))}
      />
    </div>
  </Section>
</BaseLayout>
