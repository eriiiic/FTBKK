---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PageHero from '../../components/PageHero.astro';
import EventRow from '../../components/EventRow.astro';
import DateBlock from '../../components/DateBlock.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { pastEvents, publishedPostIds, upcomingEvents } from '../../lib/queries';
import { TZ, formatEventDate } from '../../lib/format';
import { hasRecap } from '../../lib/recap';
import { getSettings } from '../../lib/settings';
import { eventCover } from '../../lib/event-covers';

const series = Astro.url.searchParams.get('series');
const [upcoming, past] = await Promise.all([upcomingEvents(), pastEvents()]);
// A recap whose only content is a write-up that was unpublished since gets no badge.
const livePosts = await publishedPostIds([
  ...new Set(past.flatMap((e) => (e.recap?.postId ? [e.recap.postId] : []))),
]);
const allSeries = [...new Set([...upcoming, ...past].map((e) => e.series))].sort();
const bySeries = <T extends { series: string }>(list: T[]) =>
  series ? list.filter((e) => e.series === series) : list;
const year = (d: Date) =>
  new Intl.DateTimeFormat('en', { timeZone: TZ, year: 'numeric' }).format(d);
const pastByYear = Object.entries(
  bySeries(past).reduce<Record<string, typeof past>>((acc, e) => {
    (acc[year(e.startsAt)] ??= []).push(e);
    return acc;
  }, {}),
).sort((a, b) => Number(b[0]) - Number(a[0]));
const [next, ...later] = bySeries(upcoming);
const settings = await getSettings();
const nextCover = next ? eventCover(next, settings.eventCovers) : null;
---

<BaseLayout
  title="Events"
  description="French Tech Connect, French Tech Talks and workshops in Bangkok. Free and open to all."
>
  <PageHero
    eyebrow="Meet the community"
    title="Events"
    intro="Monthly French Tech Connect networking evenings, French Tech Talks and workshops. Free and open to everyone."
  />
  <Section>
    {allSeries.length > 1 && (
      <nav aria-label="Filter by series" class="flex flex-wrap gap-2">
        <a href="/events" class="chip" aria-current={!series ? 'true' : undefined}>
          All
        </a>
        {allSeries.map((s) => (
          <a
            href={`/events?series=${encodeURIComponent(s)}`}
            class="chip"
            aria-current={series === s ? 'true' : undefined}
          >
            {s}
          </a>
        ))}
      </nav>
    )}
    {next ? (
      <>
        <p class="eyebrow mt-12">Next event</p>
        <article class="grid grid-cols-1 overflow-hidden rounded-card border border-line bg-paper shadow-card md:grid-cols-2">
          <a
            href={`/events/${next.slug}`}
            class="relative block aspect-[16/9] bg-navy md:aspect-auto"
          >
            {nextCover ? (
              <img src={nextCover} alt="" class="size-full object-cover" />
            ) : (
              <span class="flex size-full min-h-48 items-center justify-center font-display text-2xl font-bold text-paper">
                {next.series}
              </span>
            )}
          </a>
          <div class="flex flex-col gap-4 p-6 md:p-8">
            <div class="flex items-center gap-4">
              <DateBlock date={next.startsAt} />
              <div class="flex flex-wrap gap-2">
                <Badge tone="accent">{next.series}</Badge>
                {next.status === 'cancelled' && <Badge tone="danger">Cancelled</Badge>}
              </div>
            </div>
            <h3 class="text-2xl md:text-3xl">
              <a href={`/events/${next.slug}`} class="no-underline hover:text-brand">
                {next.title}
              </a>
            </h3>
            <div class="space-y-2 text-muted">
              <p class="flex items-center gap-2">
                <Icon name="calendar" class="size-5 shrink-0 text-brand" />
                <time datetime={next.startsAt.toISOString()}>
                  {formatEventDate(next.startsAt, next.endsAt)}
                </time>
              </p>
              {next.venue && (
                <p class="flex items-center gap-2">
                  <Icon name="pin" class="size-5 shrink-0 text-brand" />
                  {next.venue}
                </p>
              )}
            </div>
            {next.summary && <p class="line-clamp-3">{next.summary}</p>}
            <div class="mt-auto flex flex-wrap gap-3 pt-2">
              <Button href={`/events/${next.slug}#register`}>Register, it's free</Button>
              <Button href={`/events/${next.slug}`} variant="secondary">
                Details
              </Button>
            </div>
          </div>
        </article>
        {later.length > 0 && (
          <>
            <h2 class="mt-14 mb-6 text-3xl leading-tight md:text-4xl">Coming up</h2>
            <div class="divide-y divide-line rounded-card border border-line bg-paper p-1 sm:p-2">
              {later.map((e) => (
                <EventRow event={e} />
              ))}
            </div>
          </>
        )}
      </>
    ) : (
      <>
        <h2 class="mt-12 mb-6 text-3xl leading-tight md:text-4xl">Upcoming</h2>
        <p class="text-muted">Nothing scheduled yet. Check back soon.</p>
      </>
    )}
  </Section>
  {pastByYear.length > 0 && (
    <Section tone="surface" eyebrow="Archive" title="Past events">
      {pastByYear.map(([y, list]) => (
        <div class="mb-10">
          <h3 class="mb-4 text-xl">{y}</h3>
          <div class="grid gap-x-6 gap-y-1 rounded-card bg-paper p-1 shadow-card sm:p-2 lg:grid-cols-2">
            {list.map((e) => (
              <EventRow event={e} recap={hasRecap(e.recap, (id) => livePosts.has(id))} />
            ))}
          </div>
        </div>
      ))}
    </Section>
  )}
</BaseLayout>
