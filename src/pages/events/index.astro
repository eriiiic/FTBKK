---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import EventCard from '../../components/EventCard.astro';
import { pastEvents, upcomingEvents } from '../../lib/queries';
import { TZ } from '../../lib/format';

const series = Astro.url.searchParams.get('series');
const [upcoming, past] = await Promise.all([upcomingEvents(), pastEvents()]);
const allSeries = [...new Set([...upcoming, ...past].map((e) => e.series))].sort();
const bySeries = <T extends { series: string }>(list: T[]) =>
  series ? list.filter((e) => e.series === series) : list;
const year = (d: Date) =>
  new Intl.DateTimeFormat('en', { timeZone: TZ, year: 'numeric' }).format(d);
const pastByYear = Object.entries(
  bySeries(past).reduce<Record<string, typeof past>>((acc, e) => {
    (acc[year(e.startsAt)] ??= []).push(e);
    return acc;
  }, {}),
).sort((a, b) => Number(b[0]) - Number(a[0]));
const chip =
  'rounded-full border px-3 py-1 text-sm no-underline border-line hover:border-navy aria-[current=true]:border-navy aria-[current=true]:bg-navy aria-[current=true]:text-paper';
---

<BaseLayout
  title="Events"
  description="French Tech Connect, French Tech Talks and workshops in Bangkok. Free and open to all."
>
  <Section>
    <h1 class="text-4xl md:text-5xl">Events</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      Monthly French Tech Connect networking evenings, French Tech Talks and workshops. Free and
      open to everyone.
    </p>
    {allSeries.length > 1 && (
      <nav aria-label="Filter by series" class="mt-6 flex flex-wrap gap-2">
        <a href="/events" class={chip} aria-current={!series ? 'true' : undefined}>
          All
        </a>
        {allSeries.map((s) => (
          <a
            href={`/events?series=${encodeURIComponent(s)}`}
            class={chip}
            aria-current={series === s ? 'true' : undefined}
          >
            {s}
          </a>
        ))}
      </nav>
    )}
    <h2 class="mt-12 mb-6 text-2xl">Upcoming</h2>
    {bySeries(upcoming).length ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {bySeries(upcoming).map((e) => (
          <EventCard event={e} />
        ))}
      </div>
    ) : (
      <p class="text-muted">Nothing scheduled yet. Check back soon.</p>
    )}
  </Section>
  {pastByYear.length > 0 && (
    <Section tone="surface" title="Past events">
      {pastByYear.map(([y, list]) => (
        <div class="mb-10">
          <h3 class="mb-4 text-xl">{y}</h3>
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {list.map((e) => (
              <EventCard event={e} compact />
            ))}
          </div>
        </div>
      ))}
    </Section>
  )}
</BaseLayout>
