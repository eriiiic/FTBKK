---
import { siteUrl } from '../../../lib/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';
import Alert from '../../../components/Alert.astro';
import RegistrationForm from '../../../components/RegistrationForm.astro';
import PostCard from '../../../components/PostCard.astro';
import SpeakerCard from '../../../components/SpeakerCard.astro';
import {
  eventBySlug,
  isUpcoming,
  publishedPostById,
  speakersForEvent,
  sponsorsForEvent,
  upcomingEvents,
} from '../../../lib/queries';
import { hasRecap, videoEmbed, videoSite } from '../../../lib/recap';
import { groupSponsors, joinNames, showSponsor } from '../../../lib/sponsors';
import { formatEventDate, mediaUrl } from '../../../lib/format';
import { plainText, renderMarkdown } from '../../../lib/markdown';
import { clientIp, fieldErrors, formToObject } from '../../../lib/forms';
import { verifyTurnstile } from '../../../lib/turnstile';
import { rateLimit } from '../../../lib/ratelimit';
import { getSettings } from '../../../lib/settings';
import { eventCover } from '../../../lib/event-covers';
import { eventShareSpec, shareFingerprint, shareImageFor } from '../../../lib/share';
import {
  MemberRegisterSchema,
  RegisterSchema,
  countTaken,
  registerForEvent,
  registrationState,
} from '../../../lib/registrations';
import {
  MemberSignupSchema,
  inviteForEvent,
  knownNonMember,
  memberByEmail,
  memberRegistration,
  requestMembership,
  signupInput,
} from '../../../lib/members';

const event = await eventBySlug(Astro.params.slug!);
if (!event) return Astro.rewrite('/404');

const upcoming = isUpcoming(event);
const speakers = await speakersForEvent(event.id);
// Hosts, sponsors and partners: logos below the speakers, and the hosts named next to the venue.
const sponsorGroups = groupSponsors((await sponsorsForEvent(event.id)).map(showSponsor));
const hosts = sponsorGroups.find((g) => g.role === 'host')?.items ?? [];
const SPONSOR_NOUNS = { host: 'hosts', sponsor: 'sponsors', partner: 'partners' };
const sponsorsTitle =
  sponsorGroups.length === 1
    ? sponsorGroups[0]!.label
    : joinNames(sponsorGroups.map((g) => SPONSOR_NOUNS[g.role])).replace(/^./, (c) =>
        c.toUpperCase(),
      );
// A past event points to the next one instead of leaving its side column empty.
const [nextEvent] = upcoming
  ? []
  : (await upcomingEvents(2)).filter((e) => e.id !== event.id && e.status !== 'cancelled');
// Imported Wix descriptions can end with the label of Wix's collapse button.
const bodyMd = event.bodyMd.replace(/\s*\**\s*Show (?:More|Less)\s*\**\s*$/i, '');
const description =
  event.summary ||
  plainText(bodyMd) ||
  `${event.title}, ${formatEventDate(event.startsAt, event.endsAt)}${event.venue ? ` at ${event.venue}` : ''}. A La French Tech Bangkok event.`;
const settings = await getSettings();
const now = new Date();
let state = registrationState(event, await countTaken(event.id), now, {
  memberPriority: settings.memberPriority,
});

const isPost = Astro.request.method === 'POST';
// With membership open, every event is members only: members register with their email, and
// someone new fills the free membership form once, which also registers them when they confirm.
const membersOnly = settings.memberSignupOpen;
let step: 'email' | 'join' = 'email';
let errors: Record<string, string> = {};
let values: Record<string, unknown> = {};
let result: {
  status: 'registered' | 'waitlist' | 'duplicate' | 'joined' | 'invited';
  email: string;
  guests?: number;
} | null = null;
if (isPost) {
  const form = await Astro.request.formData();
  values = formToObject(form, ['interests']);
  const ip = clientIp(Astro.request);
  const human = () => verifyTurnstile(form.get('cf-turnstile-response') as string, ip);
  const register = async (data: Parameters<typeof registerForEvent>[1]) => {
    const outcome = await registerForEvent(event, data, {
      memberPriority: settings.memberPriority,
      now,
    });
    if (outcome.status === 'closed') state = outcome.state;
    else result = { status: outcome.status, email: data.email, guests: data.guests };
  };
  const suspended = `This membership is suspended. Write to us at ${settings.contactEmail} if you think this is a mistake.`;
  if (!membersOnly) {
    const parsed = RegisterSchema.safeParse(values);
    if (!parsed.success) errors = fieldErrors(parsed.error);
    else if (!(await human())) errors.form = 'The anti-spam check failed. Please try again.';
    else if (!(await rateLimit(`register:${ip}`, 10, 3600)))
      errors.form = 'Too many registrations from your connection. Please try again later.';
    else await register(parsed.data);
  } else if (form.get('step') === 'join') {
    // Second step for someone new: the membership form, with the note, guests and photo notice
    // carried over.
    step = 'join';
    const extra = MemberRegisterSchema.pick({
      note: true,
      guests: true,
      photoConsent: true,
    }).safeParse(values);
    const parsed = MemberSignupSchema.safeParse(signupInput(values));
    if (!parsed.success || !extra.success)
      errors = {
        ...(parsed.success ? {} : fieldErrors(parsed.error)),
        ...(extra.success ? {} : fieldErrors(extra.error)),
      };
    else if (!(await human())) errors.form = 'The anti-spam check failed. Please try again.';
    else if (
      !(await rateLimit(`member:${ip}`, 5, 3600)) ||
      !(await rateLimit(`member:${parsed.data.email}`, 3, 86400))
    )
      errors.form = 'Too many sign-ups from here. Please try again later.';
    else {
      const existing = await memberByEmail(parsed.data.email);
      if (existing?.status === 'active')
        await register(memberRegistration(existing, extra.data.note, extra.data.guests));
      else if (existing?.status === 'suspended') errors.form = suspended;
      else if (state.open) {
        await requestMembership(parsed.data, now, {
          event,
          note: extra.data.note,
          guests: extra.data.guests,
        });
        result = { status: 'joined', email: parsed.data.email };
      }
    }
  } else {
    // First step: just the email (and the note and photo notice).
    const parsed = MemberRegisterSchema.safeParse(values);
    if (!parsed.success) errors = fieldErrors(parsed.error);
    else if (!(await human())) errors.form = 'The anti-spam check failed. Please try again.';
    else if (!(await rateLimit(`register:${ip}`, 10, 3600)))
      errors.form = 'Too many registrations from your connection. Please try again later.';
    else {
      const m = await memberByEmail(parsed.data.email);
      const known =
        m?.status === 'active' || m?.status === 'suspended'
          ? null
          : await knownNonMember(parsed.data.email);
      if (m?.status === 'active')
        await register(memberRegistration(m, parsed.data.note, parsed.data.guests));
      else if (m?.status === 'suspended') errors.form = suspended;
      else if (known && state.open) {
        // Someone we know from past events: a prefilled form by email instead of an empty one.
        if (!(await rateLimit(`member:${parsed.data.email}`, 3, 86400)))
          errors.form = 'Too many requests for this email. Please try again tomorrow.';
        else {
          await inviteForEvent(known, parsed.data.email, event, now, parsed.data.guests);
          result = { status: 'invited', email: parsed.data.email };
        }
      } else {
        step = 'join';
        values = { ...parsed.data, photoConsent: true };
      }
    }
  }
}
// Recap of a past event: photos, slides, video and the blog write-up.
const writeUp =
  !upcoming && event.recap?.postId ? await publishedPostById(event.recap.postId) : null;
// A write-up unpublished since doesn't count, so the section never shows empty.
const recap = !upcoming && hasRecap(event.recap, (id) => writeUp?.id === id) ? event.recap : null;
const embed = videoEmbed(recap?.videoUrl);
const photoAlt = (alt: string | undefined, i: number) =>
  alt || `Photo ${i + 1} of ${recap?.photos.length} from ${event.title}`;
const cover = eventCover(event, settings.eventCovers);
// Social previews use the share image while it matches the event (lib/share.ts), else the cover.
const shareImage = shareImageFor(
  event.shareImageKey,
  await shareFingerprint(eventShareSpec(event, settings.eventCovers)),
);
const mapUrl =
  event.mapUrl ??
  (event.address
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${event.venue ?? ''} ${event.address}`)}`
    : null);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.startsAt.toISOString(),
  endDate: event.endsAt?.toISOString(),
  eventStatus:
    event.status === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: true,
  location: {
    '@type': 'Place',
    name: event.venue ?? 'Bangkok',
    address: event.address ?? 'Bangkok, Thailand',
  },
  image: cover ? siteUrl(cover) : undefined,
  description,
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'THB',
    availability: 'https://schema.org/InStock',
    url: siteUrl(`/events/${event.slug}`),
  },
  organizer: { '@type': 'Organization', name: 'La French Tech Bangkok', url: siteUrl('/') },
  performer: speakers.length
    ? speakers.map((p) => ({ '@type': 'Person', name: p.name, sameAs: p.linkedin ?? undefined }))
    : undefined,
};
---

<BaseLayout
  cache={!isPost}
  title={event.title}
  description={description}
  image={shareImage ?? cover}
  shareImage={Boolean(shareImage)}
  jsonLd={jsonLd}
>
  <article>
    <header class="bg-surface">
      <div class="container-page grid gap-8 py-10 md:grid-cols-5 md:py-14">
        <div class="md:col-span-3">
          <div class="flex flex-wrap gap-2">
            <Badge tone="accent">{event.series}</Badge>
            {event.status === 'cancelled' && <Badge tone="danger">Cancelled</Badge>}
            {!upcoming && <Badge>Past event</Badge>}
          </div>
          <h1 class="mt-3 text-3xl md:text-4xl">{event.title}</h1>
          <dl class="mt-6 space-y-3">
            <div class="flex gap-3">
              <dt>
                <Icon name="calendar" class="size-5 text-brand" />
                <span class="sr-only">Date</span>
              </dt>
              <dd>
                <time datetime={event.startsAt.toISOString()}>
                  {formatEventDate(event.startsAt, event.endsAt)}
                </time>
                <span class="text-sm text-muted"> (Bangkok time)</span>
              </dd>
            </div>
            {(event.venue || event.address) && (
              <div class="flex gap-3">
                <dt>
                  <Icon name="pin" class="size-5 text-brand" />
                  <span class="sr-only">Venue</span>
                </dt>
                <dd>
                  {event.venue && <span class="font-semibold">{event.venue}</span>}
                  {event.address && <span class="block text-muted">{event.address}</span>}
                  {mapUrl && (
                    <a href={mapUrl} rel="noopener" class="text-sm text-accent">
                      Open in Google Maps
                    </a>
                  )}
                </dd>
              </div>
            )}
            {hosts.length > 0 && (
              <div class="flex gap-3">
                <dt>
                  <Icon name="building" class="size-5 text-brand" />
                  <span class="sr-only">Host</span>
                </dt>
                <dd>
                  Hosted by{' '}
                  {hosts.map((h, i) => (
                    <>
                      {i > 0 && (i === hosts.length - 1 ? ' and ' : ', ')}
                      {h.href ? (
                        <a
                          href={h.href}
                          rel={h.external ? 'noopener' : undefined}
                          class="font-semibold text-accent"
                        >
                          {h.name}
                        </a>
                      ) : (
                        <span class="font-semibold">{h.name}</span>
                      )}
                    </>
                  ))}
                </dd>
              </div>
            )}
          </dl>
          {upcoming && event.status !== 'cancelled' && (
            <div class="mt-6 flex flex-wrap gap-3">
              {state.open && (
                <Button href="#register">{state.full ? 'Join the waitlist' : 'Register'}</Button>
              )}
              <Button href={`/events/${event.slug}/calendar.ics`} variant="secondary">
                <Icon name="calendar" /> Add to calendar
              </Button>
            </div>
          )}
        </div>
        {cover && (
          <div class="md:col-span-2">
            <img src={cover} alt="" class="w-full rounded-card object-cover shadow-card" />
          </div>
        )}
      </div>
    </header>
    <div class="container-page grid gap-10 py-12 md:grid-cols-5">
      <div class="prose max-w-none break-words md:col-span-3" set:html={renderMarkdown(bodyMd)} />
      <aside class="self-start md:sticky md:top-24 md:col-span-2">
        {event.status === 'cancelled' ? (
          <Alert tone="danger">This event has been cancelled.</Alert>
        ) : upcoming ? (
          <RegistrationForm
            event={event}
            state={state}
            membersOnly={membersOnly}
            step={step}
            errors={errors}
            values={values}
            result={result}
          />
        ) : (
          <div class="rounded-card bg-surface p-6">
            <p class="font-semibold text-navy">This event has passed.</p>
            {nextEvent ? (
              <>
                <p class="mt-2 text-sm text-muted">Next up: {nextEvent.title}</p>
                <Button href={`/events/${nextEvent.slug}`} class="mt-4">
                  See the next event
                </Button>
              </>
            ) : (
              <Button href="/events" class="mt-4">
                See all events
              </Button>
            )}
          </div>
        )}
        <p class="mt-4 text-sm text-muted">
          Everyone at La French Tech Bangkok events follows our{' '}
          <a href="/code-of-conduct" class="text-accent underline">
            code of conduct
          </a>
          .
        </p>
      </aside>
    </div>
    {speakers.length > 0 && (
      <section aria-labelledby="speakers" class="border-t border-line bg-surface">
        <div class="container-page py-12 md:py-16">
          <p class="eyebrow">{speakers.length === 1 ? 'Speaker' : 'Speakers'}</p>
          <h2 id="speakers" class="mb-8 text-2xl md:mb-10 md:text-3xl">
            {upcoming ? 'Who’s taking the stage' : 'Who took the stage'}
          </h2>
          <ul class="grid gap-6 lg:grid-cols-2">
            {speakers.map((p) => (
              <li>
                <SpeakerCard speaker={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
    {sponsorGroups.length > 0 && (
      <section aria-labelledby="sponsors" class="border-t border-line">
        <div class="container-page grid gap-8 py-12">
          <h2 id="sponsors" class="text-2xl md:text-3xl">
            {sponsorsTitle}
          </h2>
          {sponsorGroups.map((g) => (
            <div>
              {sponsorGroups.length > 1 && (
                <h3 class="mb-4 text-sm font-semibold tracking-wide text-muted uppercase">
                  {g.label}
                </h3>
              )}
              <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
                {g.items.map((s) => {
                  const inner = s.logoKey ? (
                    <img
                      src={mediaUrl(s.logoKey)}
                      alt={s.name}
                      loading="lazy"
                      decoding="async"
                      class="max-h-14 w-auto max-w-full object-contain"
                    />
                  ) : (
                    <span class="text-center font-semibold text-navy">{s.name}</span>
                  );
                  const tile =
                    'flex h-24 items-center justify-center rounded-card border border-line bg-paper p-4';
                  return (
                    <li>
                      {s.href ? (
                        <a
                          href={s.href}
                          rel={s.external ? 'noopener' : undefined}
                          class={`${tile} transition-shadow hover:shadow-card`}
                        >
                          {inner}
                        </a>
                      ) : (
                        <div class={tile}>{inner}</div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
    {recap && (
      <section aria-labelledby="recap" class="border-t border-line bg-surface">
        <div class="container-page grid gap-10 py-12">
          <h2 id="recap" class="text-2xl md:text-3xl">
            Recap
          </h2>
          {recap.photos.length > 0 && (
            <div>
              <h3 class="sr-only">Photos</h3>
              <ul
                class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4"
                data-gallery
              >
                {recap.photos.map((p, i) => (
                  <li>
                    <a
                      href={mediaUrl(p.key)}
                      class="block overflow-hidden rounded-lg bg-paper"
                      data-index={i}
                      data-caption={p.alt || undefined}
                    >
                      <img
                        src={mediaUrl(p.key)}
                        alt={photoAlt(p.alt, i)}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full object-cover transition-transform hover:scale-105"
                      />
                    </a>
                  </li>
                ))}
              </ul>
              <dialog
                aria-label="Photos"
                class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-ink/90"
                data-lightbox
              >
                <figure class="grid max-h-[90vh] w-[min(64rem,92vw)] gap-2">
                  <img alt="" class="max-h-[80vh] w-full rounded-lg object-contain" />
                  <figcaption class="text-center text-sm text-paper" />
                </figure>
                <div class="mt-3 flex justify-center gap-2">
                  {recap.photos.length > 1 && (
                    <>
                      <button
                        type="button"
                        class="rounded-full bg-paper px-4 py-2 text-sm font-semibold text-ink"
                        data-step="-1"
                      >
                        Previous
                      </button>
                      <button
                        type="button"
                        class="rounded-full bg-paper px-4 py-2 text-sm font-semibold text-ink"
                        data-step="1"
                      >
                        Next
                      </button>
                    </>
                  )}
                  <button
                    type="button"
                    class="rounded-full bg-paper px-4 py-2 text-sm font-semibold text-ink"
                    data-close
                  >
                    Close
                  </button>
                </div>
              </dialog>
            </div>
          )}
          {(recap.slides.length > 0 || recap.videoUrl || writeUp) && (
            <div class="grid gap-8 md:grid-cols-2">
              {recap.videoUrl && (
                <div class={writeUp || recap.slides.length ? '' : 'md:col-span-2'}>
                  <h3 class="mb-3 text-xl">Video</h3>
                  {embed && (
                    <iframe
                      src={embed}
                      title={`Video of ${event.title}`}
                      loading="lazy"
                      allow="encrypted-media; fullscreen; picture-in-picture"
                      allowfullscreen
                      referrerpolicy="strict-origin-when-cross-origin"
                      class="mb-3 aspect-video w-full rounded-card bg-ink"
                    />
                  )}
                  <a href={recap.videoUrl} rel="noopener" class="text-accent">
                    Watch on {videoSite(recap.videoUrl)}
                  </a>
                </div>
              )}
              <div class="grid content-start gap-8">
                {recap.slides.length > 0 && (
                  <div>
                    <h3 class="mb-3 text-xl">Slides</h3>
                    <ul class="grid gap-2">
                      {recap.slides.map((s) => (
                        <li>
                          <a
                            href={s.key ? mediaUrl(s.key)! : s.url}
                            rel="noopener"
                            class="inline-flex items-center gap-2 text-accent"
                          >
                            <Icon name={s.key ? 'download' : 'external'} class="size-5 shrink-0" />
                            {s.label}
                            {s.key && <span class="text-sm text-muted">(PDF)</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {writeUp && (
                  <div>
                    <h3 class="mb-3 text-xl">Read the write-up</h3>
                    <div class="max-w-sm">
                      <PostCard post={writeUp} />
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // Lightbox for the recap photos. Without JavaScript, each photo links to the full-size image.
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const box = document.querySelector<HTMLDialogElement>('dialog[data-lightbox]');
  if (gallery && box) {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const img = box.querySelector('img')!;
    const caption = box.querySelector('figcaption')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const thumb = links[current]!.querySelector('img')!;
      img.src = links[current]!.href;
      img.alt = thumb.alt;
      // The admin's own text doubles as a caption; the generic fallback alt isn't shown.
      const own = links[current]!.dataset.caption;
      caption.textContent = `${own ? `${own} · ` : ''}${current + 1} / ${links.length}`;
    };
    gallery.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-index]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      show(Number(a.dataset.index));
      box.showModal();
    });
    box.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === box) box.close();
      else if (t.closest('[data-close]')) box.close();
      else if (t.closest<HTMLElement>('[data-step]'))
        show(current + Number(t.closest<HTMLElement>('[data-step]')!.dataset.step));
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    box.addEventListener('close', () => links[current]?.focus());
  }
</script>
