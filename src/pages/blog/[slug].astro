---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PostCard from '../../components/PostCard.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import { categoriesForPost, postBySlug, relatedPosts } from '../../lib/queries';
import { formatDate, mediaUrl, readingMinutes } from '../../lib/format';
import { plainText, renderMarkdown } from '../../lib/markdown';

const post = await postBySlug(Astro.params.slug!);
if (!post) return Astro.rewrite('/404');
const cats = await categoriesForPost(post.id);
const related = await relatedPosts(
  post.id,
  cats.map((c) => c.id),
);
const cover = mediaUrl(post.coverKey);
// Files already linked inside the text (imported Wix download boxes) are not listed twice.
const downloads = post.attachments.filter((a) => !post.bodyMd.includes(a.key));
const description = post.excerpt ?? plainText(post.bodyMd);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  image: cover ? new URL(cover, Astro.site).href : undefined,
  datePublished: post.publishedAt?.toISOString(),
  dateModified: post.updatedAt.toISOString(),
  author: post.authorName ? { '@type': 'Person', name: post.authorName } : undefined,
  publisher: { '@type': 'Organization', name: 'La French Tech Bangkok' },
  mainEntityOfPage: new URL(`/blog/${post.slug}`, Astro.site).href,
};
---

<BaseLayout title={post.title} description={description} image={cover} jsonLd={jsonLd}>
  <article class="container-page max-w-3xl py-12">
    <div class="flex flex-wrap gap-2">
      {cats.map((c) => (
        <a href={`/blog/category/${c.slug}`} class="no-underline">
          <Badge tone="accent">{c.name}</Badge>
        </a>
      ))}
    </div>
    <h1 class="mt-3 text-3xl md:text-5xl">{post.title}</h1>
    <p class="mt-4 text-sm text-muted">
      {post.authorName && (
        <span>
          {post.authorName}
          {post.authorRole && `, ${post.authorRole}`} ·{' '}
        </span>
      )}
      {post.publishedAt && (
        <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time>
      )}
      <span> · {readingMinutes(post.bodyMd)} min read</span>
    </p>
    {cover && <img src={cover} alt="" class="mt-8 w-full rounded-card object-cover" />}
    <div class="prose prose-lg mt-8 max-w-none" set:html={renderMarkdown(post.bodyMd)} />
    {downloads.length > 0 && (
      <div class="mt-10 rounded-card border border-line p-6">
        <h2 class="text-lg">Downloads</h2>
        <ul class="mt-3 space-y-2">
          {downloads.map((a) => (
            <li>
              <a href={mediaUrl(a.key)} class="inline-flex items-center gap-2 text-accent" download>
                <Icon name="download" class="size-4" />
                {a.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
  {related.length > 0 && (
    <Section tone="surface" title="Read next">
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((p) => (
          <PostCard post={p} />
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
