---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PostCard from '../../components/PostCard.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import {
  categoriesForPost,
  peopleFor,
  postBySlug,
  postCategoryNames,
  relatedPosts,
} from '../../lib/queries';
import { formatDate, initials, mediaUrl, readingMinutes } from '../../lib/format';
import { expandDownloads, plainText, renderMarkdown } from '../../lib/markdown';
import { resolveAuthors } from '../../lib/byline';

const post = await postBySlug(Astro.params.slug!);
if (!post) return Astro.rewrite('/404');
// The header shows the authors; a byline still typed at the top of the text is not repeated.
const resolved = resolveAuthors(post);
const body = expandDownloads(resolved.body, post.attachments, mediaUrl);
const [cats, authors, postCats] = await Promise.all([
  categoriesForPost(post.id),
  peopleFor(resolved.authors),
  postCategoryNames(),
]);
// One role line when every author shares it, else each name carries its own role.
const roles = [...new Set(authors.map((a) => a.role ?? ''))];
const sharedRole = roles.length === 1 ? roles[0] : null;
const related = await relatedPosts(
  post.id,
  cats.map((c) => c.id),
);
const cover = mediaUrl(post.coverKey);
const description = post.excerpt ?? plainText(body);
const url = new URL(`/blog/${post.slug}`, Astro.site).href;
const share = [
  {
    label: 'Share on LinkedIn',
    icon: 'linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  },
  {
    label: 'Share on WhatsApp',
    icon: 'whatsapp',
    href: `https://wa.me/?text=${encodeURIComponent(`${post.title} ${url}`)}`,
  },
  {
    label: 'Share by email',
    icon: 'mail',
    href: `mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(url)}`,
  },
] as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description,
  image: cover ? new URL(cover, Astro.site).href : undefined,
  datePublished: post.publishedAt?.toISOString(),
  dateModified: post.updatedAt.toISOString(),
  author: authors.length
    ? authors.map((a) => ({
        '@type': 'Person',
        name: a.name,
        url: a.url ?? undefined,
      }))
    : undefined,
  publisher: { '@type': 'Organization', name: 'La French Tech Bangkok' },
  mainEntityOfPage: url,
};
---

<BaseLayout title={post.title} description={description} image={cover} jsonLd={jsonLd}>
  <article>
    <header class="container-page max-w-3xl pt-10 md:pt-16">
      <a
        href="/blog"
        class="inline-flex items-center gap-1 text-sm font-medium text-muted no-underline hover:text-navy"
      >
        <Icon name="arrow" class="size-4 rotate-180" />
        All articles
      </a>
      {cats.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {cats.map((c) => (
            <a href={`/blog/category/${c.slug}`} class="no-underline">
              <Badge tone="accent">{c.name}</Badge>
            </a>
          ))}
        </div>
      )}
      <h1 class="mt-4 text-3xl leading-tight text-balance md:text-5xl md:leading-[1.1]">
        {post.title}
      </h1>
      {post.excerpt && (
        <p class="mt-5 text-lg leading-relaxed text-muted md:text-xl">{post.excerpt}</p>
      )}
      <div class="mt-8 flex items-center gap-4 border-y border-line py-5">
        {authors.length > 0 && (
          <div class="flex shrink-0 -space-x-3">
            {authors.map((a) =>
              a.photoKey ? (
                <img
                  src={mediaUrl(a.photoKey)}
                  alt=""
                  width="48"
                  height="48"
                  class="size-12 rounded-full object-cover ring-2 ring-paper"
                />
              ) : (
                <span
                  class="grid size-12 place-items-center rounded-full bg-navy text-sm font-bold text-paper ring-2 ring-paper"
                  aria-hidden="true"
                >
                  {initials(a.name)}
                </span>
              ),
            )}
          </div>
        )}
        <div class="min-w-0 text-sm">
          {authors.length > 0 && (
            <p class="font-semibold text-navy">
              {authors.map((a, i) => (
                <>
                  {i > 0 && (i === authors.length - 1 ? ' and ' : ', ')}
                  {a.url ? (
                    <a href={a.url} rel="noopener" class="text-navy hover:text-brand">
                      {a.name}
                    </a>
                  ) : (
                    <span>{a.name}</span>
                  )}
                  {sharedRole === null && a.role && (
                    <span class="font-normal text-muted"> ({a.role})</span>
                  )}
                </>
              ))}
            </p>
          )}
          <p class="text-muted">
            {sharedRole && <span>{sharedRole}, La French Tech Bangkok · </span>}
            {post.publishedAt && (
              <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time>
            )}
            <span> · {readingMinutes(body)} min read</span>
          </p>
        </div>
      </div>
    </header>

    {cover && (
      <div class="container-page mt-10 max-w-5xl">
        <img
          src={cover}
          alt=""
          class="aspect-[16/9] w-full rounded-card object-cover shadow-card"
          fetchpriority="high"
        />
      </div>
    )}

    <div class="container-page max-w-3xl py-10 md:py-14">
      <div
        class="prose prose-lg max-w-none break-words prose-headings:font-display prose-headings:text-navy prose-a:text-accent prose-img:rounded-card"
        set:html={renderMarkdown(body)}
      />
      <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-line pt-6">
        <span class="text-sm font-semibold text-navy">Share this article</span>
        {share.map((s) => (
          <a
            href={s.href}
            rel="noopener"
            target="_blank"
            aria-label={s.label}
            class="grid size-10 place-items-center rounded-full border border-line text-navy no-underline hover:border-navy"
          >
            <Icon name={s.icon} class="size-4" />
          </a>
        ))}
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <Section tone="surface" title="Read next">
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((p) => (
          <PostCard post={p} categories={postCats.get(p.id)} />
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
