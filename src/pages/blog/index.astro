---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { allPosts, categoriesWithCounts } from '../../lib/queries';

const [posts, categories] = await Promise.all([allPosts(), categoriesWithCounts()]);
---

<BaseLayout
  title="Blog"
  description="Ecosystem news, founder guides and tech insights from La French Tech Bangkok."
>
  <BlogIndex
    posts={posts}
    categories={categories}
    heading="Blog"
    intro="Ecosystem news, founder guides, tech insights and studies from the community."
  />
</BaseLayout>
