---
import FormField from '../FormField.astro';
import Button from '../Button.astro';
import { CONTACT_TAGS } from '../../lib/contacts';

interface Props {
  values: Record<string, unknown>;
  errors: Record<string, string>;
  submit: string;
  /** A walk-in without an email: notes and LinkedIn need an email to be saved. */
  walkIn?: boolean;
  /** The newsletter answer that counts today, shown under the menu when editing. */
  newsletterNow?: string;
}
const { values, errors, submit, walkIn = false, newsletterNow } = Astro.props;
const v = (k: string) => (values[k] as string | null | undefined) ?? '';
const newsletterOptions = [
  ['', 'As they chose when registering'],
  ['yes', 'Subscribed (they told us)'],
  ['no', 'Not subscribed (they told us)'],
];
const tags = Array.isArray(values.tags) ? (values.tags as string[]) : [];
---

<form method="post" class="grid gap-4" data-warn-unsaved>
  <input type="hidden" name="action" value="save" />
  <div class="grid gap-4 sm:grid-cols-2">
    <FormField
      name="name"
      label="Name"
      required
      maxlength={120}
      value={v('name')}
      error={errors.name}
    />
    <FormField
      name="email"
      label="Email"
      type="email"
      maxlength={200}
      value={v('email')}
      error={errors.email}
      hint={walkIn ? 'Add one to save notes and to group their future registrations.' : undefined}
    />
    <FormField
      name="phone"
      label="Phone"
      type="tel"
      maxlength={40}
      value={v('phone')}
      error={errors.phone}
    />
    <FormField
      name="company"
      label="Company"
      maxlength={120}
      value={v('company')}
      error={errors.company}
    />
    <FormField name="role" label="Role" maxlength={120} value={v('role')} error={errors.role} />
    <FormField
      name="linkedin"
      label="LinkedIn"
      type="url"
      value={v('linkedin')}
      error={errors.linkedin}
      placeholder="https://www.linkedin.com/in/…"
    />
  </div>
  <fieldset>
    <legend class="text-sm font-semibold">Tags</legend>
    <div class="mt-2 flex flex-wrap gap-2">
      {Object.entries(CONTACT_TAGS).map(([k, label]) => (
        <label class="cursor-pointer">
          <input
            type="checkbox"
            name="tags"
            value={k}
            checked={tags.includes(k)}
            class="peer sr-only"
          />
          <span class="inline-block rounded-full border border-line px-3 py-1 text-sm peer-checked:border-navy peer-checked:bg-navy peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-accent">
            {label}
          </span>
        </label>
      ))}
    </div>
    <p class="mt-1 text-sm text-muted">
      {walkIn ? 'Needs an email for a walk-in.' : 'Only the admin team sees these.'}
    </p>
    {errors.tags && <p class="mt-1 text-sm text-danger">{errors.tags}</p>}
  </fieldset>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="f-newsletter" class="block text-sm font-semibold text-ink">
        Newsletter
      </label>
      <select
        id="f-newsletter"
        name="newsletter"
        aria-describedby="f-newsletter-hint"
        class="mt-1 block w-full rounded-lg border border-line bg-paper px-3 py-2 text-ink focus:border-accent"
      >
        {newsletterOptions.map(([value, label]) => (
          <option value={value} selected={v('newsletter') === value}>
            {label}
          </option>
        ))}
      </select>
      <p id="f-newsletter-hint" class="mt-1 text-sm text-muted">
        Only when someone tells you in person or by message. Their latest choice counts.
        {newsletterNow && <span class="block">Now: {newsletterNow}.</span>}
      </p>
      {errors.newsletter && <p class="mt-1 text-sm text-danger">{errors.newsletter}</p>}
    </div>
    <FormField
      name="newsletterAt"
      label="Date they told us"
      type="date"
      value={v('newsletterAt')}
      error={errors.newsletterAt}
      hint="Leave empty for today."
    />
  </div>
  <FormField
    name="notes"
    label="Notes"
    rows={4}
    maxlength={4000}
    value={v('notes')}
    error={errors.notes}
    hint={
      walkIn
        ? 'Only the admin team sees these. Needs an email for a walk-in.'
        : 'Only the admin team sees these.'
    }
  />
  <div>
    <Button type="submit">{submit}</Button>
  </div>
</form>
