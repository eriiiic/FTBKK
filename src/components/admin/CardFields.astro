---
// Repeated "card" rows (title, text, optional link) for the settings page. Rows left empty are
// dropped on save; one empty row is offered for adding a card.
import FormField from '../FormField.astro';
import type { Card } from '../../lib/settings';

interface Props {
  prefix: string;
  legend: string;
  items: Card[];
  hint?: string;
  error?: string;
  withLink?: boolean;
  max?: number;
  /** Field names shown to the editor, for rows that aren't cards (for example the home numbers). */
  item?: string;
  titleLabel?: string;
  textLabel?: string;
  textRows?: number;
  titleMax?: number;
  textMax?: number;
}
const {
  prefix,
  legend,
  items,
  hint,
  error,
  withLink = false,
  max = 6,
  item = 'card',
  titleLabel = 'title',
  textLabel = 'Text',
  textRows = 2,
  titleMax = 80,
  textMax = 400,
} = Astro.props;
const rows: Card[] = items.length < max ? [...items, { title: '', text: '' }] : items;
---

<fieldset class="grid gap-3">
  <legend class="text-sm font-semibold text-ink">{legend}</legend>
  {hint && <p class="-mt-1 text-sm text-muted">{hint}</p>}
  {error && <p class="text-sm text-danger">{error}</p>}
  {rows.map((c, i) => (
    <div class="grid gap-3 rounded-lg border border-line bg-surface/60 p-3 sm:grid-cols-[12rem_1fr]">
      <FormField
        id={`${prefix}-title-${i}`}
        name={`${prefix}Title`}
        label={
          i < items.length
            ? `${item[0]!.toUpperCase()}${item.slice(1)} ${i + 1}: ${titleLabel}`
            : `New ${item}: ${titleLabel}`
        }
        value={c.title}
        maxlength={titleMax}
      />
      <FormField
        id={`${prefix}-text-${i}`}
        name={`${prefix}Text`}
        label={textLabel}
        rows={textRows}
        value={c.text}
        maxlength={textMax}
      />
      {withLink && (
        <div class="sm:col-start-2">
          <FormField
            id={`${prefix}-link-${i}`}
            name={`${prefix}Link`}
            label="Link (optional)"
            value={c.link ?? ''}
            placeholder="/events or https://…"
            maxlength={300}
          />
        </div>
      )}
    </div>
  ))}
</fieldset>
