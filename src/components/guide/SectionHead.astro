---
interface Props {
  /** "01 · Visas" */
  eyebrow: string;
  title: string;
  intro?: string;
  light?: boolean;
}
const { eyebrow, title, intro, light = false } = Astro.props;
---

<header class="mb-8 max-w-3xl">
  <p class={`eyebrow ${light ? 'eyebrow-light' : ''}`}>{eyebrow}</p>
  <h2 class={`text-3xl leading-tight md:text-4xl ${light ? 'text-paper' : ''}`}>{title}</h2>
  {intro && <p class={`mt-3 text-lg ${light ? 'text-accent-soft' : 'text-muted'}`}>{intro}</p>}
  <slot />
</header>
