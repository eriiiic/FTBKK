---
import Section from './Section.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../db/schema';

interface Props {
  posts: Post[];
  categories: { slug: string; name: string; count: number }[];
  active?: string;
  heading: string;
  intro?: string;
}
const { posts, categories, active, heading, intro } = Astro.props;
const chip =
  'rounded-full border px-3 py-1 text-sm no-underline border-line hover:border-navy aria-[current=page]:border-navy aria-[current=page]:bg-navy aria-[current=page]:text-paper';
---

<Section>
  <h1 class="text-4xl md:text-5xl">{heading}</h1>
  {intro && <p class="mt-3 max-w-2xl text-lg text-muted">{intro}</p>}
  <nav aria-label="Categories" class="mt-6 flex flex-wrap gap-2">
    <a href="/blog" class={chip} aria-current={!active ? 'page' : undefined}>
      All
    </a>
    {categories
      .filter((c) => c.count > 0 || c.slug === active)
      .map((c) => (
        <a
          href={`/blog/category/${c.slug}`}
          class={chip}
          aria-current={active === c.slug ? 'page' : undefined}
        >
          {c.name} <span class="opacity-70">({c.count})</span>
        </a>
      ))}
  </nav>
  {posts.length ? (
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <PostCard post={p} />
      ))}
    </div>
  ) : (
    <p class="mt-10 text-muted">No articles yet.</p>
  )}
</Section>
