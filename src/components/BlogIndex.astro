---
import Section from './Section.astro';
import PageHero from './PageHero.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../db/schema';
import { formatDate, mediaUrl, readingMinutes } from '../lib/format';
import { postCategoryNames } from '../lib/queries';

interface Props {
  posts: Post[];
  categories: { slug: string; name: string; count: number }[];
  active?: string;
  heading: string;
  intro?: string;
}
const { posts, categories, active, heading, intro } = Astro.props;
// The newest article leads the unfiltered list, the rest follow in the grid.
const featured = !active && posts.length > 3 ? posts[0] : null;
const rest = featured ? posts.slice(1) : posts;
const cats = await postCategoryNames();
const featuredCover = featured ? mediaUrl(featured.coverKey) : null;
---

<PageHero eyebrow={active ? 'Blog' : 'News and insights'} title={heading} intro={intro} />
<Section>
  <nav aria-label="Categories" class="flex flex-wrap gap-2">
    <a href="/blog" class="chip" aria-current={!active ? 'page' : undefined}>
      All
    </a>
    {categories
      .filter((c) => c.count > 0 || c.slug === active)
      .map((c) => (
        <a
          href={`/blog/category/${c.slug}`}
          class="chip"
          aria-current={active === c.slug ? 'page' : undefined}
        >
          {c.name} <span class="opacity-70">({c.count})</span>
        </a>
      ))}
  </nav>
  {featured && (
    <a
      href={`/blog/${featured.slug}`}
      class="group mt-10 grid overflow-hidden rounded-card border border-line bg-paper no-underline shadow-card transition hover:-translate-y-0.5 md:grid-cols-2"
    >
      <div class="aspect-[16/9] bg-surface md:aspect-auto">
        {featuredCover && (
          <img src={featuredCover} alt="" class="size-full object-cover" fetchpriority="high" />
        )}
      </div>
      <div class="flex flex-col justify-center gap-3 p-6 md:p-10">
        <p class="text-xs font-semibold tracking-[0.15em] text-brand uppercase">
          Latest article{cats.get(featured.id)?.[0] && ` · ${cats.get(featured.id)![0]}`}
        </p>
        <h2 class="text-2xl leading-tight group-hover:text-brand md:text-3xl">{featured.title}</h2>
        {featured.excerpt && <p class="line-clamp-3 text-muted">{featured.excerpt}</p>}
        <p class="mt-2 text-sm text-muted">
          {featured.authorName && <span>{featured.authorName} · </span>}
          {featured.publishedAt && (
            <time datetime={featured.publishedAt.toISOString()}>
              {formatDate(featured.publishedAt)}
            </time>
          )}
          <span> · {readingMinutes(featured.bodyMd)} min read</span>
        </p>
      </div>
    </a>
  )}
  {rest.length ? (
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {rest.map((p) => (
        <PostCard post={p} categories={cats.get(p.id)} />
      ))}
    </div>
  ) : (
    !featured && <p class="mt-10 text-muted">No articles yet.</p>
  )}
</Section>
