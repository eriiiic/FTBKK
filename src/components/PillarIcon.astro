---
// The three geometric marks of the original site's "Join a vibrant ecosystem" section.
interface Props {
  index: number;
  class?: string;
}
const { index, class: cls = 'size-14' } = Astro.props;
const shapes = [
  // Two half-discs facing each other.
  'M0 0a24 24 0 0 1 0 48ZM48 0a24 24 0 0 0 0 48Z',
  // A disc with its top-right quarter cut away.
  'M24 0v24h24A24 24 0 1 1 24 0Z',
  // Two offset half-discs.
  'M25 0a20 20 0 0 1 0 40ZM23 8a20 20 0 0 0 0 40Z',
];
---

<svg class={cls} viewBox="0 0 48 48" fill="currentColor" aria-hidden="true">
  <path d={shapes[index % shapes.length]}></path>
</svg>
