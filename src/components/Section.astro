---
interface Props {
  title?: string;
  eyebrow?: string;
  intro?: string;
  tone?: 'paper' | 'surface' | 'navy';
  id?: string;
  class?: string;
}
const { title, eyebrow, intro, tone = 'paper', id, class: cls = '' } = Astro.props;
const tones = { paper: 'bg-paper', surface: 'bg-surface', navy: 'bg-navy text-paper' };
---

<section id={id} class={`py-14 md:py-20 ${tones[tone]} ${cls}`}>
  <div class="container-page">
    {(title || eyebrow) && (
      <header class="mb-8 max-w-3xl md:mb-10">
        {eyebrow && <p class={`eyebrow ${tone === 'navy' ? 'eyebrow-light' : ''}`}>{eyebrow}</p>}
        {title && (
          <h2 class={`text-3xl leading-tight md:text-4xl ${tone === 'navy' ? 'text-paper' : ''}`}>
            {title}
          </h2>
        )}
        {intro && (
          <p class={`mt-3 text-lg ${tone === 'navy' ? 'text-accent-soft' : 'text-muted'}`}>
            {intro}
          </p>
        )}
      </header>
    )}
    <slot />
  </div>
</section>
