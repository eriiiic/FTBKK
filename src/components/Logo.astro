---
// The rooster pin from the Wix logo (public/brand/pin.png, transparent) next to a text wordmark,
// which stays readable at header size, unlike the text baked into the original 200px logo.
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class="inline-flex items-center gap-2 font-display leading-none font-extrabold">
  <img src="/brand/pin.png" alt="" width="36" height="44" class="h-10 w-auto" />
  <span class={tone === 'light' ? 'text-paper' : 'text-navy'}>
    <span class="block text-[0.65rem] tracking-[0.2em] uppercase">La French Tech</span>
    <span class="block text-lg">Bangkok</span>
  </span>
</span>
