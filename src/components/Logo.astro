---
// The official La French Tech Bangkok Community logo (public/brand/logo-lockup.png, cropped from
// the supplied artwork). The usage charter forbids redrawing it, changing its layout or lettering,
// or showing the rooster alone. Only the colour version (black text) exists in the repo, so on
// dark backgrounds it sits on a white tile until the official white-text version is added.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: cls = 'h-14' } = Astro.props;
---

{tone === 'light' ? (
  <span class="inline-block rounded-xl bg-paper p-2">
    <img src="/brand/logo-lockup.png" alt="" width="146" height="183" class={`w-auto ${cls}`} />
  </span>
) : (
  <img src="/brand/logo-lockup.png" alt="" width="146" height="183" class={`w-auto ${cls}`} />
)}
