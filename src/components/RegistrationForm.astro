---
import Alert from './Alert.astro';
import Button from './Button.astro';
import FormField from './FormField.astro';
import Turnstile from './Turnstile.astro';
import MemberSignupFields from './MemberSignupFields.astro';
import {
  GUEST_OPTIONS,
  GUESTS_MAX,
  guestsLabel,
  HOW_HEARD,
  NOTE_MAX,
  type RegistrationState,
} from '../lib/registrations';
import { formatDate, formatTime } from '../lib/format';

interface Props {
  event: { slug: string; title: string };
  state: RegistrationState;
  errors?: Record<string, string>;
  values?: Record<string, unknown>;
  result?: {
    status: 'registered' | 'waitlist' | 'duplicate' | 'joined' | 'invited';
    email: string;
    guests?: number;
  } | null;
  /** Membership is open: members register with their email, newcomers join first (free). */
  membersOnly?: boolean;
  /** Members only: 'join' shows the membership form for an email that isn't a member yet. */
  step?: 'email' | 'join';
  /** Private event: the invitation token, kept in the form's address. */
  invite?: string;
}
const {
  event,
  state,
  errors = {},
  values = {},
  result,
  membersOnly = false,
  step = 'email',
  invite,
} = Astro.props;
const action = `/events/${event.slug}${invite ? `?invite=${encodeURIComponent(invite)}` : ''}#register`;
const str = (k: string) => (values[k] === null || values[k] === undefined ? '' : String(values[k]));
---

<div id="register" class="scroll-mt-24 rounded-card border border-line p-6">
  <h2 class="text-xl">Registration</h2>
  {result ? (
    result.status === 'invited' ? (
      <Alert tone="success" class="mt-4">
        Welcome back! You've been to our events before, so we've emailed {result.email} a link with
        your details filled in. Check them and you become a member (it's free) and are registered
        for this event. Nothing in your inbox? Check the spam folder.
      </Alert>
    ) : result.status === 'joined' ? (
      <Alert tone="success" class="mt-4">
        Almost there: we've sent an email to {result.email}. Click the link in it to confirm your
        email: you become a member and you're registered for this event.
      </Alert>
    ) : result.status === 'duplicate' ? (
      <Alert class="mt-4">
        {result.email} is already registered for this event. Check your inbox for the confirmation
        email, which has a link to cancel if needed.
      </Alert>
    ) : result.status === 'waitlist' ? (
      <Alert tone="warning" class="mt-4">
        {result.guests
          ? `There aren't enough seats left for you and your ${result.guests === 1 ? 'guest' : `${result.guests} guests`}, so you are on the waitlist. We will email ${result.email} when seats free up.`
          : `The event is full, so you are on the waitlist. We will email ${result.email} if a seat frees up.`}
      </Alert>
    ) : (
      <Alert tone="success" class="mt-4">
        You're registered{result.guests ? ` with ${guestsLabel(result.guests).slice(1)}` : ''}! A
        confirmation with a calendar invite is on its way to {result.email}.
      </Alert>
    )
  ) : !state.open ? (
    <Alert class="mt-4">
      {state.reason === 'not_yet' && state.opensAt
        ? `Registration opens on ${formatDate(state.opensAt)} at ${formatTime(state.opensAt)}.`
        : 'Registration is closed for this event.'}
    </Alert>
  ) : membersOnly && step === 'join' ? (
    <form method="post" action={action} class="mt-4 grid gap-4">
      <input type="hidden" name="step" value="join" />
      <input type="hidden" name="note" value={str('note')} />
      <input type="hidden" name="guests" value={str('guests')} />
      <input type="hidden" name="photoConsent" value="on" />
      <Alert>
        {str('email')} isn't a member yet. Our events are for members, and membership is free: fill
        this in once and you're registered too. Wrong email?{' '}
        <a href={`/events/${event.slug}#register`}>Use another one</a>.
      </Alert>
      {errors.form && <Alert tone="danger">{errors.form}</Alert>}
      <MemberSignupFields values={values} errors={errors} fixedEmail={str('email')} />
      <Turnstile />
      <div>
        <Button type="submit">Become a member and register</Button>
      </div>
    </form>
  ) : membersOnly ? (
    <form method="post" action={action} class="mt-4 grid gap-4">
      <input type="hidden" name="step" value="email" />
      {state.spotsLeft !== null && (
        <p class={`text-sm font-semibold ${state.full ? 'text-warning' : 'text-success'}`}>
          {state.full
            ? 'The event is full. You can join the waitlist.'
            : `${state.spotsLeft} spot${state.spotsLeft === 1 ? '' : 's'} left`}
        </p>
      )}
      <p class="text-sm text-muted">
        Members register with their email. Not a member yet? Enter your email too: membership is
        free and takes a minute.
      </p>
      {errors.form && <Alert tone="danger">{errors.form}</Alert>}
      <FormField
        name="email"
        label="Email"
        type="email"
        required
        autocomplete="email"
        value={str('email')}
        error={errors.email}
      />
      <FormField
        name="guests"
        label="Bringing guests?"
        value={str('guests')}
        options={GUEST_OPTIONS}
        placeholder="No guests, just me"
        error={errors.guests}
        hint={`Up to ${GUESTS_MAX}. No need for their names: each guest takes a seat.`}
      />
      <FormField
        name="note"
        label="Anything we should know, or something you're looking for?"
        rows={2}
        maxlength={NOTE_MAX}
        value={str('note')}
        error={errors.note}
        hint="Optional. Only the organisers see it."
      />
      <FormField
        name="photoConsent"
        type="checkbox"
        required
        checked={!!values.photoConsent}
        error={errors.photoConsent}
        label="I understand photos and videos may be taken and shared by La French Tech Bangkok."
      />
      <Turnstile />
      <div>
        <Button type="submit">{state.full ? 'Join the waitlist' : 'Register'}</Button>
      </div>
      <p class="text-xs text-muted">
        See our{' '}
        <a href="/privacy" class="underline">
          privacy notice
        </a>{' '}
        and our{' '}
        <a href="/code-of-conduct" class="underline">
          code of conduct
        </a>
        .
      </p>
    </form>
  ) : (
    <form method="post" action={action} class="mt-4 grid gap-4">
      {state.spotsLeft !== null && (
        <p class={`text-sm font-semibold ${state.full ? 'text-warning' : 'text-success'}`}>
          {state.full
            ? 'The event is full. You can join the waitlist.'
            : `${state.spotsLeft} spot${state.spotsLeft === 1 ? '' : 's'} left`}
        </p>
      )}
      {errors.form && <Alert tone="danger">{errors.form}</Alert>}
      <FormField
        name="name"
        label="Full name"
        required
        autocomplete="name"
        value={str('name')}
        error={errors.name}
      />
      <FormField
        name="email"
        label="Email"
        type="email"
        required
        autocomplete="email"
        value={str('email')}
        error={errors.email}
      />
      <FormField
        name="phone"
        label="Phone"
        type="tel"
        autocomplete="tel"
        value={str('phone')}
        error={errors.phone}
        hint="Optional. Helps us find you quickly at the entrance."
      />
      <FormField
        name="company"
        label="Company"
        autocomplete="organization"
        value={str('company')}
      />
      <FormField name="role" label="Role" autocomplete="organization-title" value={str('role')} />
      <FormField
        name="howHeard"
        label="How did you hear about us?"
        value={str('howHeard')}
        options={HOW_HEARD.map((h) => ({ value: h, label: h }))}
      />
      <FormField
        name="guests"
        label="Bringing guests?"
        value={str('guests')}
        options={GUEST_OPTIONS}
        placeholder="No guests, just me"
        error={errors.guests}
        hint={`Up to ${GUESTS_MAX}. No need for their names: each guest takes a seat.`}
      />
      <FormField
        name="note"
        label="Anything we should know, or something you're looking for?"
        rows={3}
        maxlength={NOTE_MAX}
        value={str('note')}
        error={errors.note}
        hint="Optional. For example dietary needs, accessibility, or who you'd like to meet. Only the organisers see it."
      />
      <FormField
        name="photoConsent"
        type="checkbox"
        required
        checked={!!values.photoConsent}
        error={errors.photoConsent}
        label="I understand photos and videos may be taken and shared by La French Tech Bangkok."
      />
      <FormField
        name="newsletter"
        type="checkbox"
        checked={values.newsletter === true}
        label="Send me the La French Tech Bangkok newsletter (about once a month). You can unsubscribe at any time."
      />
      <Turnstile />
      <div>
        <Button type="submit">{state.full ? 'Join the waitlist' : 'Register'}</Button>
      </div>
      <p class="text-xs text-muted">
        Free. We use your details to run this event (and send the newsletter only if you tick the
        box). See our{' '}
        <a href="/privacy" class="underline">
          privacy notice
        </a>
        . By registering you agree to our{' '}
        <a href="/code-of-conduct" class="underline">
          code of conduct
        </a>
        .
      </p>
    </form>
  )}
</div>
