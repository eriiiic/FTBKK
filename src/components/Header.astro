---
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';

type Link = { href: string; label: string; lang?: string };
// Resources is a drop-down: our reports and guides.
const resources: Link[] = [
  { href: '/tech-pulse', label: 'Tech Pulse' },
  { href: '/founders-guide', label: "Founder's Guide" },
  { href: '/expand-to-thailand', label: 'Expanding to Thailand' },
];
const nav: (Link | { label: string; children: Link[] })[] = [
  { href: '/', label: 'Home' },
  { href: '/ecosystem', label: 'Ecosystem' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
  { label: 'Resources', children: resources },
  { href: '/about', label: 'About' },
  // The Thai page, labelled in Thai.
  { href: '/th', label: 'ภาษาไทย', lang: 'th' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const join = '/join';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-paper focus:px-3 focus:py-2"
  >
    Skip to content
  </a>
  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="no-underline" aria-label="La French Tech Bangkok, home">
      <Logo class="h-14 md:h-[4.25rem]" />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((n) =>
          'children' in n ? (
            <li class="relative" data-dropdown>
              <button
                type="button"
                aria-expanded="false"
                aria-controls="resources-menu"
                data-current={n.children.some((c) => isActive(c.href)) ? '' : undefined}
                class="group flex cursor-pointer items-center gap-1 rounded-full px-3 py-2 text-sm font-semibold text-ink hover:text-brand data-current:text-brand"
              >
                {n.label}
                <Icon
                  name="chevron-right"
                  class="size-3.5 rotate-90 transition-transform group-aria-expanded:-rotate-90"
                />
              </button>
              <ul
                id="resources-menu"
                hidden
                class="absolute top-full left-0 mt-2 w-56 rounded-card border border-line bg-paper p-2 shadow-card"
              >
                {n.children.map((c) => (
                  <li>
                    <a
                      href={c.href}
                      aria-current={isActive(c.href) ? 'page' : undefined}
                      class="block rounded-lg px-3 py-2 text-sm font-semibold text-ink no-underline hover:bg-surface hover:text-brand aria-[current=page]:text-brand"
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={n.href}
                lang={n.lang}
                hreflang={n.lang}
                aria-current={isActive(n.href) ? 'page' : undefined}
                class="rounded-full px-3 py-2 text-sm font-semibold text-ink no-underline hover:text-brand aria-[current=page]:text-brand"
              >
                {n.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
    <div class="hidden lg:block">
      <Button href={join} size="sm">
        Join the community
      </Button>
    </div>
    <button
      type="button"
      class="group rounded-lg p-2 text-navy lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <Icon name="menu" class="size-6 group-aria-expanded:hidden" />
      <Icon name="close" class="hidden size-6 group-aria-expanded:block" />
    </button>
  </div>
  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-line bg-paper lg:hidden">
    <ul class="container-page flex flex-col py-2">
      {nav
        .flatMap((n) => ('children' in n ? n.children : [n]))
        .map((n) => (
          <li>
            <a
              href={n.href}
              lang={n.lang}
              hreflang={n.lang}
              aria-current={isActive(n.href) ? 'page' : undefined}
              class="block py-3 font-semibold text-ink no-underline aria-[current=page]:text-brand"
            >
              {n.label}
            </a>
          </li>
        ))}
      <li class="py-3">
        <Button href={join} class="w-full">
          Join the community
        </Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));

  // Desktop drop-downs (Resources): open on click, close on Escape or a click elsewhere.
  for (const root of document.querySelectorAll<HTMLElement>('[data-dropdown]')) {
    const toggle = root.querySelector<HTMLButtonElement>('button')!;
    const list = root.querySelector<HTMLElement>('ul')!;
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const show = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.hidden = !open;
    };
    toggle.addEventListener('click', () => show(!isOpen()));
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) show(false);
    });
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen()) return;
      show(false);
      toggle.focus();
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) show(false);
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || btn?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    btn.focus();
  });
</script>
