---
import Card from './Card.astro';
import { formatDate, mediaUrl, readingMinutes } from '../lib/format';

interface Props {
  post: {
    slug: string;
    title: string;
    excerpt: string | null;
    coverKey: string | null;
    authorName: string | null;
    publishedAt: Date | null;
    bodyMd: string;
  };
}
const { post } = Astro.props;
const cover = mediaUrl(post.coverKey);
---

<Card href={`/blog/${post.slug}`}>
  <div class="aspect-[16/9] bg-surface">
    {cover && <img src={cover} alt="" loading="lazy" class="size-full object-cover" />}
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="text-lg group-hover:text-brand">{post.title}</h3>
    {post.excerpt && <p class="line-clamp-3 text-sm text-muted">{post.excerpt}</p>}
    <p class="mt-auto pt-2 text-xs text-muted">
      {post.authorName && <span>{post.authorName} · </span>}
      {post.publishedAt && (
        <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time>
      )}
      <span> · {readingMinutes(post.bodyMd)} min read</span>
    </p>
  </div>
</Card>
