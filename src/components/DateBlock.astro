---
import { TZ } from '../lib/format';

interface Props {
  date: Date;
  size?: 'sm' | 'md';
  class?: string;
}
const { date, size = 'md', class: cls = '' } = Astro.props;
const part = (opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-US', { timeZone: TZ, ...opts }).format(date);
const sizes = { sm: 'w-12 py-1', md: 'w-16 py-2' };
---

<div
  class={`flex shrink-0 flex-col items-center rounded-xl border border-line bg-paper leading-none text-navy ${sizes[size]} ${cls}`}
  aria-hidden="true"
>
  <span class="text-[0.65rem] font-bold tracking-widest text-brand uppercase">
    {part({ month: 'short' })}
  </span>
  <span class={`font-display font-bold ${size === 'md' ? 'mt-1 text-2xl' : 'mt-0.5 text-xl'}`}>
    {part({ day: 'numeric' })}
  </span>
</div>
