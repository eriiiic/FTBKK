---
interface Option {
  value: string;
  label: string;
}
interface Props {
  name: string;
  label: string;
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  value?: string | number | null;
  required?: boolean;
  hint?: string;
  error?: string;
  options?: Option[];
  rows?: number;
  placeholder?: string;
  maxlength?: number;
  accept?: string;
  autocomplete?: string;
  multiple?: boolean;
  checked?: boolean;
}
const {
  name,
  label,
  type = 'text',
  value,
  required,
  hint,
  error,
  options,
  rows,
  placeholder,
  maxlength,
  accept,
  autocomplete,
  multiple,
  checked,
} = Astro.props;
const id = `f-${name}`;
const describedBy =
  [hint && `${id}-hint`, error && `${id}-err`].filter(Boolean).join(' ') || undefined;
const input =
  'mt-1 block w-full rounded-lg border border-line bg-paper px-3 py-2 text-ink placeholder:text-muted focus:border-accent';
---

{type === 'checkbox' ? (
  <div class="flex items-start gap-3">
    <input
      id={id}
      name={name}
      type="checkbox"
      value="on"
      required={required}
      checked={checked}
      aria-describedby={describedBy}
      class="mt-1 size-4 rounded border-line accent-brand"
    />
    <label for={id} class="text-sm">
      {label}
      {hint && (
        <span id={`${id}-hint`} class="block text-muted">
          {hint}
        </span>
      )}
      {error && (
        <span id={`${id}-err`} class="block text-danger">
          {error}
        </span>
      )}
    </label>
  </div>
) : (
  <div>
    <label for={id} class="block text-sm font-semibold text-ink">
      {label}
      {required && <span class="text-brand"> *</span>}
    </label>
    {options ? (
      <select
        id={id}
        name={name}
        required={required}
        multiple={multiple}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        class={input}
      >
        {!multiple && <option value="">Choose…</option>}
        {options.map((o) => (
          <option value={o.value} selected={String(value ?? '') === o.value}>
            {o.label}
          </option>
        ))}
      </select>
    ) : rows ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        maxlength={maxlength}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        class={input}
      >
          {value ?? ''}
        </textarea>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        value={value ?? undefined}
        required={required}
        placeholder={placeholder}
        maxlength={maxlength}
        accept={accept}
        autocomplete={autocomplete}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        class={input}
      />
    )}
    {hint && (
      <p id={`${id}-hint`} class="mt-1 text-sm text-muted">
        {hint}
      </p>
    )}
    {error && (
      <p id={`${id}-err`} class="mt-1 text-sm text-danger">
        {error}
      </p>
    )}
  </div>
)}
